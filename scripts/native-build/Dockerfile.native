ARG BASE_IMAGE=ubuntu:26.04
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    binutils \
    build-essential \
    ca-certificates \
    curl \
    cython3 \
    dpkg-dev \
    gcc \
    gnupg \
    nodejs \
    npm \
    python3-dev \
    python3-setuptools \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
