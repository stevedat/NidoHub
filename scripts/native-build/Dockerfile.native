ARG BASE_IMAGE=ubuntu:26.04
FROM ${BASE_IMAGE}

ARG NODE_SEA_VERSION=22.23.5
ARG NODE_SHA256_AMD64=cdeb8670a0c81f51b4dc4ac61919f9b1ad917b304bf8221eb939570663d240f8
ARG NODE_SHA256_ARM64=2babb9eb5264860d540849f4b064a6fbdebcdc323657d9d382ce23d313fd5e09

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    binutils \
    build-essential \
    ca-certificates \
    curl \
    cython3 \
    dpkg-dev \
    file \
    gcc \
    gnupg \
    python3-dev \
    python3-setuptools \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/opt/node-sea/bin:${PATH}"

# Ubuntu distro /usr/bin/node is dynamically linked against libnode.so (missing NODE_SEA_FUSE).
# Install the official static Node.js LTS binary into /opt/node-sea with SHA-256 verification.
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      amd64) node_arch="x64"; expected_sha="${NODE_SHA256_AMD64}" ;; \
      arm64) node_arch="arm64"; expected_sha="${NODE_SHA256_ARM64}" ;; \
      *) echo "Unsupported arch: $arch" >&2; exit 1 ;; \
    esac; \
    tarball="node-v${NODE_SEA_VERSION}-linux-${node_arch}.tar.xz"; \
    curl -fsSL "https://nodejs.org/dist/v${NODE_SEA_VERSION}/${tarball}" -o "/tmp/${tarball}"; \
    echo "${expected_sha}  /tmp/${tarball}" | sha256sum -c -; \
    mkdir -p /opt/node-sea; \
    tar -xJf "/tmp/${tarball}" --strip-components=1 -C /opt/node-sea; \
    rm -f "/tmp/${tarball}"; \
    grep -a -q "NODE_SEA_FUSE_fce680ab2cc467b6e072b8b5df1996b2" /opt/node-sea/bin/node; \
    /opt/node-sea/bin/npm install -g --no-audit --no-fund esbuild postject; \
    /opt/node-sea/bin/npm cache clean --force

WORKDIR /workspace
