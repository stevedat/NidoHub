#!/usr/bin/env bash
# Hook 0120: Ubuntu-Nido Native-First policy
# - Installs official Mozilla Firefox DEB with verified GPG key + package-specific APT pinning
# - Preserves upstream Ubuntu security updates (unattended-upgrades) and firmware updates (fwupd)
# - Registers Flathub remote WITHOUT preloading Flatpak applications or runtimes
# - Preserves snapd and Live Installer (ubuntu-desktop-bootstrap); schedules installed-system
#   cleanup of Ubuntu App Center (snap-store) and Firefox Snap via nido-native-first-cleanup.service
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive

APT_LOCK_TIMEOUT="${APT_LOCK_TIMEOUT:-600}"
APT_GET=(apt-get -o "DPkg::Lock::Timeout=${APT_LOCK_TIMEOUT}")

echo "[Ubuntu-Nido] Configuring official Mozilla APT repository (verified GPG + package-specific pin)..."
if [ -x /usr/libexec/nido-hub/nido-pkg-helper ]; then
  /usr/libexec/nido-hub/nido-pkg-helper setup-vendor mozilla
else
  echo "ERROR: Missing /usr/libexec/nido-hub/nido-pkg-helper (install nido-hub package first)" >&2
  exit 1
fi

echo "[Ubuntu-Nido] Installing official Mozilla Firefox DEB (replacing Ubuntu Snap wrapper)..."
"${APT_GET[@]}" update
"${APT_GET[@]}" install -y --allow-downgrades --no-install-recommends firefox

# Verify firefox is a real native DEB from Mozilla, not the Ubuntu transitional snap wrapper
if [ -f /usr/bin/firefox ] && grep -qs "snap install firefox" /usr/bin/firefox 2>/dev/null; then
  echo "ERROR: /usr/bin/firefox is still the Ubuntu transitional Snap wrapper!" >&2
  exit 1
fi

echo "[Ubuntu-Nido] Verifying upstream security updates (unattended-upgrades) and firmware (fwupd)..."
dpkg -s unattended-upgrades >/dev/null
dpkg -s fwupd >/dev/null
if [ ! -f /etc/apt/apt.conf.d/20auto-upgrades ]; then
  cat > /etc/apt/apt.conf.d/20auto-upgrades <<'AUTOUP'
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
AUTOUP
fi

# Preserve upstream Ubuntu security updates when os-release/lsb-release reports ID=nidoos
cat > /etc/apt/apt.conf.d/51nidoos-unattended-upgrades <<'UNATT'
Unattended-Upgrade::Allowed-Origins {
  "Ubuntu:${distro_codename}";
  "Ubuntu:${distro_codename}-security";
  "Ubuntu:${distro_codename}-updates";
  "UbuntuESMApps:${distro_codename}-apps-security";
  "UbuntuESM:${distro_codename}-infra-security";
};
UNATT

echo "[Ubuntu-Nido] Registering optional Flathub remote (zero preloaded Flatpak apps or runtimes)..."
if command -v flatpak >/dev/null 2>&1; then
  flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo || true
fi

# Ensure Ubuntu 'universe' component stays enabled in ubuntu.sources so on-demand
# printer drivers (printer-driver-escpr, printer-driver-gutenprint, etc.) are APT-ready.
if [ -f /etc/apt/sources.list.d/ubuntu.sources ] && command -v python3 >/dev/null 2>&1; then
  python3 - <<'PY'
from pathlib import Path
p = Path("/etc/apt/sources.list.d/ubuntu.sources")
raw = p.read_text(encoding="utf-8", errors="replace")
out = []
for line in raw.splitlines():
    if line.startswith("Components:"):
        comps = line.split(":", 1)[1].split()
        if "universe" not in comps:
            comps.append("universe")
        out.append("Components: " + " ".join(comps))
    else:
        out.append(line)
p.write_text("\n".join(out) + ("\n" if raw.endswith("\n") else ""), encoding="utf-8")
PY
fi

# Keep CUPS & Avahi services ready for zero-driver IPP/AirPrint/ipp-usb printers
if command -v systemctl >/dev/null 2>&1; then
  systemctl enable cups.service avahi-daemon.service >/dev/null 2>&1 || true
fi

# Preserve snapd & ubuntu-desktop-bootstrap; schedule post-install removal of snap-store
if [ -f /usr/lib/systemd/system/nido-native-first-cleanup.service ]; then
  mkdir -p /etc/systemd/system/multi-user.target.wants
  ln -sf /usr/lib/systemd/system/nido-native-first-cleanup.service \
    /etc/systemd/system/multi-user.target.wants/nido-native-first-cleanup.service
fi

echo "[Ubuntu-Nido] Native-First hook 0120 completed."
