#!/usr/bin/env bash
# Hook 0900: Install NidoOS Plymouth boot splash theme, replace Ubuntu boot logos, and update initramfs
set -euo pipefail

THEME_DIR="/usr/share/plymouth/themes/nidoos"
ASSETS_DIR="/usr/share/backgrounds/ubuntu-nido"
LOGO_SRC=""
if [ -f "${ASSETS_DIR}/nidoos-logo.png" ]; then
  LOGO_SRC="${ASSETS_DIR}/nidoos-logo.png"
elif [ -f "/usr/share/pixmaps/nidoos-logo.png" ]; then
  LOGO_SRC="/usr/share/pixmaps/nidoos-logo.png"
fi

mkdir -p "$THEME_DIR" /usr/share/pixmaps /etc/plymouth
rm -f "$THEME_DIR"/*.png

if [ -d "$ASSETS_DIR" ]; then
  cp -a "$ASSETS_DIR"/*.png "$THEME_DIR/" 2>/dev/null || true
fi

if [ -n "$LOGO_SRC" ] && [ -f "$LOGO_SRC" ]; then
  cp -f "$LOGO_SRC" /usr/share/pixmaps/nidoos-logo.png
  cp -f "$LOGO_SRC" "$THEME_DIR/watermark.png"
  chmod 0644 /usr/share/pixmaps/nidoos-logo.png "$THEME_DIR/watermark.png"
fi

# Permanently divert & replace upstream Ubuntu Plymouth logos so neither Live boot
# nor future apt upgrades of plymouth-theme-spinner show Ubuntu's trademarked logo.
divert_and_replace_file() {
  local src="$1"
  local target="$2"
  if [ -z "$src" ] || [ ! -f "$src" ]; then
    return 0
  fi
  mkdir -p "$(dirname "$target")"
  if [ -e "$target" ] || [ -L "$target" ]; then
    if ! dpkg-divert --list "$target" 2>/dev/null | grep -q "$target"; then
      dpkg-divert --local --rename --add "$target" >/dev/null 2>&1 || true
    fi
  fi
  rm -f "$target"
  cp -f "$src" "$target"
  chmod 0644 "$target"
}

TRANSPARENT_PNG="${THEME_DIR}/transparent-1x1.png"
python3 - "$TRANSPARENT_PNG" <<'PY'
import struct, sys, zlib
from pathlib import Path
def chunk(tag, data):
    return struct.pack(">I", len(data)) + tag + data + struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF)
ihdr = struct.pack(">IIBBBBB", 1, 1, 8, 6, 0, 0, 0)
idat = zlib.compress(b"\x00\x00\x00\x00\x00", level=6)
Path(sys.argv[1]).write_bytes(b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", ihdr) + chunk(b"IDAT", idat) + chunk(b"IEND", b""))
PY
chmod 0644 "$TRANSPARENT_PNG"

divert_and_replace_file "$LOGO_SRC" "/usr/share/plymouth/ubuntu-logo.png"
divert_and_replace_file "$LOGO_SRC" "/usr/share/plymouth/themes/spinner/bgrt-fallback.png"
divert_and_replace_file "$LOGO_SRC" "/usr/share/pixmaps/ubuntu-logo-text-dark.png"
divert_and_replace_file "$LOGO_SRC" "/usr/share/pixmaps/ubuntu-logo-text.png"
divert_and_replace_file "$TRANSPARENT_PNG" "/usr/share/plymouth/themes/spinner/watermark.png"
divert_and_replace_file "$TRANSPARENT_PNG" "/usr/share/plymouth/themes/bgrt/watermark.png"
if [ -d /usr/share/plymouth/themes/ubuntu-logo ]; then
  divert_and_replace_file "$LOGO_SRC" "/usr/share/plymouth/themes/ubuntu-logo/ubuntu-logo.png"
  divert_and_replace_file "$LOGO_SRC" "/usr/share/plymouth/themes/ubuntu-logo/ubuntu-logo16.png"
fi
if [ -d /usr/share/plymouth/themes/ubuntu-text ]; then
  cat > "${THEME_DIR}/nidoos-text.plymouth" <<'TPLY'
[Plymouth Theme]
Name=NidoOS Text
Description=NidoOS text-mode boot splash
ModuleName=ubuntu-text

[ubuntu-text]
title=NidoOS
black=0x000000
white=0xf8fafc
brown=0x10b981
blue=0x0d9488
TPLY
  divert_and_replace_file "${THEME_DIR}/nidoos-text.plymouth" "/usr/share/plymouth/themes/ubuntu-text/ubuntu-text.plymouth"
fi

# Reuse smooth spinner animation frames if installed; fall back to static emblem
if [ -d /usr/share/plymouth/themes/spinner ] && ls /usr/share/plymouth/themes/spinner/animation-*.png >/dev/null 2>&1; then
  cp -f /usr/share/plymouth/themes/spinner/animation-*.png "$THEME_DIR/" 2>/dev/null || true
  cp -f /usr/share/plymouth/themes/spinner/throbber-*.png "$THEME_DIR/" 2>/dev/null || true
elif [ -f "$THEME_DIR/watermark.png" ]; then
  for i in $(seq 1 36); do
    frame=$(printf 'animation-%04d.png' "$i")
    [ -f "$THEME_DIR/$frame" ] || cp "$THEME_DIR/watermark.png" "$THEME_DIR/$frame"
  done
  for i in $(seq 1 30); do
    frame=$(printf 'throbber-%04d.png' "$i")
    [ -f "$THEME_DIR/$frame" ] || cp "$THEME_DIR/watermark.png" "$THEME_DIR/$frame"
  done
fi

cat > "$THEME_DIR/nidoos.plymouth" <<'PLY'
[Plymouth Theme]
Name=NidoOS
Description=NidoOS AI-Native Desktop boot splash
ModuleName=two-step

[two-step]
Font=Be Vietnam Pro 12
TitleFont=Be Vietnam Pro Light 30
ImageDir=/usr/share/plymouth/themes/nidoos
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.382
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.382
HorizontalAlignment=.5
VerticalAlignment=.5
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.82
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0x000000
BackgroundEndColor=0x000000
ProgressBarBackgroundColor=0x374151
ProgressBarForegroundColor=0x10b981
MessageBelowAnimation=true

[boot-up]
UseEndAnimation=false

[shutdown]
UseEndAnimation=false

[reboot]
UseEndAnimation=false

[updates]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Đang cập nhật NidoOS...
SubTitle=Vui lòng không tắt máy tính
PLY

cat > /etc/plymouth/plymouthd.conf <<'PCONF'
[Daemon]
Theme=nidoos
ShowDelay=0
DeviceTimeout=8
PCONF

rm -f /usr/share/plymouth/themes/default.plymouth
ln -s "$THEME_DIR/nidoos.plymouth" /usr/share/plymouth/themes/default.plymouth

update-alternatives --install \
  /usr/share/plymouth/themes/default.plymouth \
  default.plymouth \
  "$THEME_DIR/nidoos.plymouth" \
  300 >/dev/null 2>&1 || true
update-alternatives --set default.plymouth "$THEME_DIR/nidoos.plymouth" >/dev/null 2>&1 || true

# Replace distributor-logo, dock Show Apps icon, and Ubuntu panel icons in Yaru themes
# so GNOME Settings -> About, Dock, and Places display NidoOS branding (never Ubuntu).
NIDO_SVG="/usr/share/icons/hicolor/scalable/apps/nidoos-logo.svg"
NIDO_SYM="/usr/share/icons/hicolor/scalable/apps/nidoos-symbolic.svg"
NIDO_GRID="/usr/share/icons/hicolor/scalable/actions/nidoos-app-grid-symbolic.svg"
NIDO_PNG_256="/usr/share/icons/hicolor/256x256/apps/nidoos-logo.png"
if [ ! -f "$NIDO_PNG_256" ] && [ -n "$LOGO_SRC" ]; then
  NIDO_PNG_256="$LOGO_SRC"
fi

if [ -f "$NIDO_SVG" ]; then
  for yaru_dir in \
    /usr/share/icons/Yaru/scalable/apps \
    /usr/share/icons/Yaru-dark/scalable/apps \
    /usr/share/icons/Yaru-prussiangreen/scalable/apps \
    /usr/share/icons/Yaru-prussiangreen-dark/scalable/apps; do
    if [ -d "$yaru_dir" ]; then
      cp -f "$NIDO_SVG" "${yaru_dir}/distributor-logo.svg" 2>/dev/null || true
      divert_and_replace_file "$NIDO_SVG" "${yaru_dir}/ubiquity.svg"
    fi
  done
fi

if [ -f "$NIDO_GRID" ] && [ -e /usr/share/icons/Yaru/scalable/actions/view-app-grid-ubuntu-symbolic.svg ]; then
  divert_and_replace_file "$NIDO_GRID" "/usr/share/icons/Yaru/scalable/actions/view-app-grid-ubuntu-symbolic.svg"
fi
if [ -f "$NIDO_SYM" ]; then
  if [ -e /usr/share/icons/Yaru/scalable/places/distributor-logo-symbolic.svg ]; then
    divert_and_replace_file "$NIDO_SYM" "/usr/share/icons/Yaru/scalable/places/distributor-logo-symbolic.svg"
  fi
  if [ -e /usr/share/icons/Yaru/scalable/categories/preferences-ubuntu-panel-symbolic.svg ]; then
    divert_and_replace_file "$NIDO_SYM" "/usr/share/icons/Yaru/scalable/categories/preferences-ubuntu-panel-symbolic.svg"
  fi
fi

if [ -f "$NIDO_PNG_256" ] && [ -d /usr/share/icons/Yaru ]; then
  for sz in 16x16 16x16@2x 22x22 24x24 24x24@2x 32x32 32x32@2x 48x48 48x48@2x 256x256 256x256@2x; do
    for rel_icon in places/distributor-logo.png apps/ubiquity.png apps/ubiquity-kde.png; do
      dst="/usr/share/icons/Yaru/${sz}/${rel_icon}"
      if [ -e "$dst" ] || [ -L "$dst" ]; then
        px="${sz%%x*}"
        case "$sz" in
          *@2x) px=$((px * 2)) ;;
        esac
        scaled_tmp="${THEME_DIR}/dist-${px}.png"
        if [ ! -f "$scaled_tmp" ]; then
          python3 - "$NIDO_PNG_256" "$scaled_tmp" "$px" <<'PY' || cp -f "$NIDO_PNG_256" "$scaled_tmp"
import sys
from PIL import Image
src, dst, px = sys.argv[1], sys.argv[2], int(sys.argv[3])
im = Image.open(src).convert("RGBA")
im = im.resize((px, px), Image.Resampling.LANCZOS)
im.save(dst, format="PNG")
PY
        fi
        divert_and_replace_file "$scaled_tmp" "$dst"
      fi
    done
  done
fi

if command -v gtk-update-icon-cache >/dev/null 2>&1; then
  for icdir in /usr/share/icons/hicolor /usr/share/icons/Yaru /usr/share/icons/Yaru-dark /usr/share/icons/Yaru-prussiangreen /usr/share/icons/Yaru-prussiangreen-dark; do
    [ -d "$icdir" ] && gtk-update-icon-cache -q -t -f "$icdir" || true
  done
fi

if command -v update-initramfs >/dev/null 2>&1; then
  update-initramfs -u -k all || true
fi

echo "[NidoOS] Plymouth hook completed."
