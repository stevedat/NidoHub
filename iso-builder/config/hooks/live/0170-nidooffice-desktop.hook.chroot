#!/usr/bin/env bash
# Hook 0170: Purge LibreOffice during ISO build and install latest SHA256-verified NidoOffice Desktop as default
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive

APT_LOCK_TIMEOUT="${APT_LOCK_TIMEOUT:-600}"
APT_GET=(apt-get -o "DPkg::Lock::Timeout=${APT_LOCK_TIMEOUT}")

echo "[Ubuntu-Nido] Purging LibreOffice packages in favor of NidoOffice..."
mapfile -t LO_PKGS < <(
  dpkg-query -W -f='${db:Status-Abbrev}\t${Package}\n' \
    'libreoffice*' 'python3-uno' 'uno-libs-private' 'ure' 'ure-java' 'liblibreoffice*' 'mythes-*' 'hyphen-*' 2>/dev/null \
    | awk '$1 ~ /^i/ { print $2 }' \
    | sort -u || true
)
if [ "${#LO_PKGS[@]}" -gt 0 ]; then
  "${APT_GET[@]}" purge -y "${LO_PKGS[@]}" || true
  "${APT_GET[@]}" autoremove -y --purge || true
fi
rm -rf /usr/lib/libreoffice /etc/libreoffice /usr/share/libreoffice /usr/share/applications/libreoffice*.desktop

if [ ! -x /usr/lib/nidooffice-desktop/install-runtime.sh ]; then
  echo "ERROR: Missing /usr/lib/nidooffice-desktop/install-runtime.sh (install nidooffice-desktop package first)" >&2
  exit 1
fi

/usr/lib/nidooffice-desktop/install-runtime.sh
echo "[Ubuntu-Nido] Hook 0170 completed."
