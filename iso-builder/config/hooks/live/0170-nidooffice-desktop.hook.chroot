#!/usr/bin/env bash
# Hook 0170: Purge LibreOffice, install NidoOffice v0.13.0 Desktop & set as default Office/PDF/Markdown suite
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive

APT_LOCK_TIMEOUT="${APT_LOCK_TIMEOUT:-600}"
APT_GET=(apt-get -o "DPkg::Lock::Timeout=${APT_LOCK_TIMEOUT}")
NIDOOFFICE_VERSION="0.13.0"
ARCH="$(dpkg --print-architecture)"

echo "[Ubuntu-Nido] Purging LibreOffice packages in favor of NidoOffice..."
mapfile -t LO_PKGS < <(
  dpkg-query -W -f='${db:Status-Abbrev}\t${Package}\n' \
    'libreoffice*' 'python3-uno' 'uno-libs-private' 'ure' 'ure-java' 'liblibreoffice*' 'mythes-*' 'hyphen-*' 2>/dev/null \
    | awk '$1 ~ /^i/ { print $2 }' \
    | sort -u || true
)
if [ "${#LO_PKGS[@]}" -gt 0 ]; then
  "${APT_GET[@]}" purge -y "${LO_PKGS[@]}" || true
  "${APT_GET[@]}" autoremove -y --purge || true
fi
rm -rf /usr/lib/libreoffice /etc/libreoffice /usr/share/libreoffice /usr/share/applications/libreoffice*.desktop

echo "[Ubuntu-Nido] Ensuring Electron/GTK/NSS shared libraries for NidoOffice..."
RUNTIME_PKGS=(
  libnss3
  libgbm1
  libdrm2
  libxkbcommon0
  libxcomposite1
  libxdamage1
  libxfixes3
  libxrandr2
  libpango-1.0-0
  libcairo2
)
for alt in \
  "libatk1.0-0t64 libatk1.0-0" \
  "libatk-bridge2.0-0t64 libatk-bridge2.0-0" \
  "libcups2t64 libcups2" \
  "libasound2t64 libasound2" \
  "libgtk-3-0t64 libgtk-3-0"; do
  for cand in $alt; do
    if apt-cache show "$cand" >/dev/null 2>&1; then
      RUNTIME_PKGS+=("$cand")
      break
    fi
  done
done
"${APT_GET[@]}" install -y --no-install-recommends "${RUNTIME_PKGS[@]}"

case "$ARCH" in
  amd64)
    APPIMAGE_NAME="NidoOffice-linux-x64.AppImage"
    ;;
  arm64)
    APPIMAGE_NAME="NidoOffice-linux-arm64.AppImage"
    ;;
  *)
    echo "ERROR: Unsupported architecture for NidoOffice Desktop: ${ARCH}" >&2
    exit 1
    ;;
esac

BASE_URL="https://github.com/stevedat/nidooffice-releases/releases/download/v${NIDOOFFICE_VERSION}"
DL_DIR="/tmp/nidooffice-dl"
EXTRACT_DIR="/tmp/nidooffice-extract"
rm -rf "$DL_DIR" "$EXTRACT_DIR" /opt/NidoOffice /opt/GenOffice
mkdir -p "$DL_DIR" "$EXTRACT_DIR"

echo "[Ubuntu-Nido] Downloading NidoOffice v${NIDOOFFICE_VERSION} (${APPIMAGE_NAME})..."
curl -fL --retry 3 --retry-delay 2 "${BASE_URL}/SHA256SUMS.txt" -o "${DL_DIR}/SHA256SUMS.txt"
curl -fL --retry 3 --retry-delay 2 "${BASE_URL}/${APPIMAGE_NAME}" -o "${DL_DIR}/${APPIMAGE_NAME}"
(
  cd "$DL_DIR"
  grep "  ${APPIMAGE_NAME}\$" SHA256SUMS.txt | sha256sum -c -
)

chmod +x "${DL_DIR}/${APPIMAGE_NAME}"
echo "[Ubuntu-Nido] Extracting ${APPIMAGE_NAME} into /opt/NidoOffice..."
if ! (cd "$EXTRACT_DIR" && "${DL_DIR}/${APPIMAGE_NAME}" --appimage-extract >/dev/null 2>&1); then
  SQFS_OFFSET="$(python3 - "${DL_DIR}/${APPIMAGE_NAME}" <<'PY'
import sys
data = open(sys.argv[1], "rb").read(4 * 1024 * 1024)
off = data.rfind(b"hsqs")
if off < 0:
    raise SystemExit("Could not locate SquashFS hsqs magic in AppImage")
print(off)
PY
)"
  unsquashfs -o "$SQFS_OFFSET" -d "${EXTRACT_DIR}/squashfs-root" "${DL_DIR}/${APPIMAGE_NAME}" >/dev/null
fi

mv "${EXTRACT_DIR}/squashfs-root" /opt/NidoOffice
ln -sfn /opt/NidoOffice /opt/GenOffice
rm -rf "$DL_DIR" "$EXTRACT_DIR"

chmod -R a+rX /opt/NidoOffice
if [ ! -x /opt/NidoOffice/genoffice ] && [ -x /opt/NidoOffice/nidooffice ]; then
  ln -sf nidooffice /opt/NidoOffice/genoffice
fi
if [ -x /opt/NidoOffice/nidooffice ]; then
  NIDOOFFICE_BIN="/opt/NidoOffice/nidooffice"
else
  NIDOOFFICE_BIN="/opt/NidoOffice/genoffice"
fi
test -x "$NIDOOFFICE_BIN"

if [ -f /opt/NidoOffice/chrome-sandbox ]; then
  chown root:root /opt/NidoOffice/chrome-sandbox
  chmod 4755 /opt/NidoOffice/chrome-sandbox
fi

mkdir -p /etc/apparmor.d
cat > /etc/apparmor.d/nidooffice <<'APPARMOR'
abi <abi/4.0>,
include <tunables/global>

profile nidooffice /opt/{NidoOffice,GenOffice}/{nidooffice,genoffice} flags=(unconfined) {
  userns,
  include if exists <local/nidooffice>
}
APPARMOR

cat > /usr/bin/nidooffice-desktop <<'LAUNCHER'
#!/usr/bin/env bash
set -euo pipefail

BIN="/opt/NidoOffice/nidooffice"
if [ ! -x "$BIN" ]; then
  BIN="/opt/NidoOffice/genoffice"
fi

export ELECTRON_OZONE_PLATFORM_HINT="${ELECTRON_OZONE_PLATFORM_HINT:-auto}"
EXTRA_ARGS=()

if [ -n "${WAYLAND_DISPLAY:-}" ]; then
  HAS_IME=0
  HAS_TI_VER=0
  for arg in "$@"; do
    case "$arg" in
      --enable-wayland-ime) HAS_IME=1 ;;
      --wayland-text-input-version=*) HAS_TI_VER=1 ;;
    esac
  done
  [ "$HAS_IME" -eq 0 ] && EXTRA_ARGS+=(--enable-wayland-ime)
  [ "$HAS_TI_VER" -eq 0 ] && EXTRA_ARGS+=(--wayland-text-input-version=3)
fi

if [ "$(id -u)" -eq 0 ]; then
  HAS_NO_SANDBOX=0
  for arg in "$@"; do
    if [ "$arg" = "--no-sandbox" ]; then
      HAS_NO_SANDBOX=1
      break
    fi
  done
  [ "$HAS_NO_SANDBOX" -eq 0 ] && EXTRA_ARGS+=(--no-sandbox)
fi

exec "$BIN" "${EXTRA_ARGS[@]}" "$@"
LAUNCHER
chmod 755 /usr/bin/nidooffice-desktop

if [ -x /opt/NidoOffice/resources/cli/nidooffice ] && [ ! -e /opt/NidoOffice/resources/cli/genoffice ]; then
  ln -sf nidooffice /opt/NidoOffice/resources/cli/genoffice
fi
if [ -x /opt/NidoOffice/resources/cli/genoffice ]; then
  mkdir -p /usr/local/bin
  ln -sfn /opt/NidoOffice/resources/cli/genoffice /usr/local/bin/genoffice
fi

if [ -d /opt/NidoOffice/usr/share/icons/hicolor ]; then
  mkdir -p /usr/share/icons/hicolor
  cp -a /opt/NidoOffice/usr/share/icons/hicolor/* /usr/share/icons/hicolor/
  while IFS= read -r -d '' app_icon_dir; do
    if [ -f "${app_icon_dir}/genoffice.png" ] && [ ! -e "${app_icon_dir}/nidooffice.png" ]; then
      cp -f "${app_icon_dir}/genoffice.png" "${app_icon_dir}/nidooffice.png"
    elif [ -f "${app_icon_dir}/nidooffice.png" ] && [ ! -e "${app_icon_dir}/genoffice.png" ]; then
      cp -f "${app_icon_dir}/nidooffice.png" "${app_icon_dir}/genoffice.png"
    fi
  done < <(find /usr/share/icons/hicolor -type d -name apps -print0 2>/dev/null)
fi
if [ ! -f /usr/share/icons/hicolor/256x256/apps/nidooffice.png ] && [ -f /opt/NidoOffice/.DirIcon ]; then
  mkdir -p /usr/share/icons/hicolor/256x256/apps
  cp -Lf /opt/NidoOffice/.DirIcon /usr/share/icons/hicolor/256x256/apps/nidooffice.png
  cp -Lf /opt/NidoOffice/.DirIcon /usr/share/icons/hicolor/256x256/apps/genoffice.png
fi

cat > /usr/share/applications/nidooffice.desktop <<'DESKTOP'
[Desktop Entry]
Type=Application
Name=NidoOffice
Name[vi]=NidoOffice
GenericName=AI Office Suite
GenericName[vi]=Bộ Ứng dụng Văn phòng AI
Comment=Local-First AI Office Suite for Word, Excel, PowerPoint, PDF & Markdown
Comment[vi]=Bộ ứng dụng văn phòng AI mặc định cho Word (.docx), Excel (.xlsx), PowerPoint (.pptx), PDF & Markdown
Exec=/usr/bin/nidooffice-desktop %U
Icon=nidooffice
StartupWMClass=nidooffice
StartupNotify=true
Terminal=false
Categories=Office;WordProcessor;Spreadsheet;Presentation;Viewer;
MimeType=application/vnd.openxmlformats-officedocument.wordprocessingml.document;application/vnd.openxmlformats-officedocument.wordprocessingml.template;application/vnd.ms-word.document.macroEnabled.12;application/msword;application/vnd.oasis.opendocument.text;application/vnd.oasis.opendocument.text-template;application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;application/vnd.openxmlformats-officedocument.spreadsheetml.template;application/vnd.ms-excel.sheet.macroEnabled.12;application/vnd.ms-excel;application/vnd.oasis.opendocument.spreadsheet;application/vnd.oasis.opendocument.spreadsheet-template;text/csv;text/tab-separated-values;application/vnd.openxmlformats-officedocument.presentationml.presentation;application/vnd.openxmlformats-officedocument.presentationml.template;application/vnd.openxmlformats-officedocument.presentationml.slideshow;application/vnd.ms-powerpoint.presentation.macroEnabled.12;application/vnd.ms-powerpoint;application/vnd.oasis.opendocument.presentation;application/vnd.oasis.opendocument.presentation-template;application/pdf;text/markdown;text/x-markdown;application/hwp+zip;application/x-hwp;
Keywords=Office;Word;Excel;PowerPoint;DOCX;XLSX;PPTX;PDF;Markdown;NidoOffice;GenOffice;
DESKTOP

if [ -d /opt/NidoOffice/resources/shell-new ]; then
  mkdir -p /usr/share/templates /etc/skel/Templates
  for pair in \
    "docx:Tài liệu Word.docx" \
    "xlsx:Bảng tính Excel.xlsx" \
    "pptx:Trình chiếu PowerPoint.pptx"; do
    ext="${pair%%:*}"
    tname="${pair#*:}"
    if [ -f "/opt/NidoOffice/resources/shell-new/blank.${ext}" ]; then
      install -m 0644 "/opt/NidoOffice/resources/shell-new/blank.${ext}" "/usr/share/templates/${tname}"
      install -m 0644 "/opt/NidoOffice/resources/shell-new/blank.${ext}" "/etc/skel/Templates/${tname}"
    fi
  done
fi

mkdir -p /etc/xdg /etc/skel/.config
python3 - <<'PY'
from pathlib import Path

OFFICE_MIMES = [
    "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
    "application/vnd.openxmlformats-officedocument.wordprocessingml.template",
    "application/vnd.ms-word.document.macroEnabled.12",
    "application/msword",
    "application/vnd.oasis.opendocument.text",
    "application/vnd.oasis.opendocument.text-template",
    "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
    "application/vnd.openxmlformats-officedocument.spreadsheetml.template",
    "application/vnd.ms-excel.sheet.macroEnabled.12",
    "application/vnd.ms-excel",
    "application/vnd.oasis.opendocument.spreadsheet",
    "application/vnd.oasis.opendocument.spreadsheet-template",
    "text/csv",
    "text/tab-separated-values",
    "application/vnd.openxmlformats-officedocument.presentationml.presentation",
    "application/vnd.openxmlformats-officedocument.presentationml.template",
    "application/vnd.openxmlformats-officedocument.presentationml.slideshow",
    "application/vnd.ms-powerpoint.presentation.macroEnabled.12",
    "application/vnd.ms-powerpoint",
    "application/vnd.oasis.opendocument.presentation",
    "application/vnd.oasis.opendocument.presentation-template",
    "application/pdf",
    "text/markdown",
    "text/x-markdown",
    "application/hwp+zip",
    "application/x-hwp",
]

def update_mimeapps(path: Path, scrub_only: bool = False) -> None:
    sections: dict[str, dict[str, str]] = {}
    order: list[str] = []
    cur = None
    if path.is_file():
        for raw in path.read_text(encoding="utf-8", errors="replace").splitlines():
            s = raw.strip()
            if not s or s.startswith("#"):
                continue
            if s.startswith("[") and s.endswith("]"):
                cur = s
                if cur not in sections:
                    sections[cur] = {}
                    order.append(cur)
                continue
            if cur and "=" in s:
                k, v = s.split("=", 1)
                orig_vals = [x.strip() for x in v.split(";") if x.strip()]
                vals = [x for x in orig_vals if not x.startswith("libreoffice-")]
                if not vals and any(
                    x.startswith(("libreoffice-writer", "libreoffice-calc", "libreoffice-impress"))
                    for x in orig_vals
                ):
                    vals = ["nidooffice.desktop"]
                if vals:
                    sections[cur][k.strip()] = ";".join(vals) + (";" if v.rstrip().endswith(";") else "")
    if not scrub_only:
        sec = "[Default Applications]"
        if sec not in sections:
            sections[sec] = {}
            order.insert(0, sec)
        for m in OFFICE_MIMES:
            sections[sec][m] = "nidooffice.desktop"
    out = []
    for sec in order:
        if not sections[sec]:
            continue
        out.append(sec)
        for k, v in sections[sec].items():
            out.append(f"{k}={v}")
        out.append("")
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("\n".join(out), encoding="utf-8")

for mf in (
    Path("/etc/xdg/mimeapps.list"),
    Path("/etc/xdg/gnome-mimeapps.list"),
    Path("/etc/xdg/ubuntu-mimeapps.list"),
    Path("/etc/skel/.config/mimeapps.list"),
):
    update_mimeapps(mf, scrub_only=False)

for sys_mf in (
    Path("/usr/share/applications/ubuntu-mimeapps.list"),
    Path("/usr/share/applications/gnome-mimeapps.list"),
):
    if sys_mf.is_file():
        update_mimeapps(sys_mf, scrub_only=True)
PY

if command -v gtk-update-icon-cache >/dev/null 2>&1; then
  gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || true
fi
if command -v update-desktop-database >/dev/null 2>&1; then
  update-desktop-database -q /usr/share/applications || true
fi

echo "[Ubuntu-Nido] NidoOffice v${NIDOOFFICE_VERSION} Desktop installed and set as default Office suite."
