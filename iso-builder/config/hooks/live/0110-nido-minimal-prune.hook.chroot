#!/usr/bin/env bash
# Hook 0110: Enforce Nido Minimal Desktop profile on Ubuntu LTS
# Keeps Ubuntu core, GDM, GNOME Shell, Mutter, Nautilus, Settings, PipeWire,
# NetworkManager, Polkit, Portals, BlueZ, CUPS, firmware, and snapd intact while
# pruning preinstalled games and non-essential consumer apps.
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive

APT_LOCK_TIMEOUT="${APT_LOCK_TIMEOUT:-600}"
APT_GET=(apt-get -o "DPkg::Lock::Timeout=${APT_LOCK_TIMEOUT}")

for core_meta in \
  ubuntu-desktop-minimal \
  ubuntu-minimal \
  ubuntu-standard \
  nido-desktop \
  nido-desktop-settings \
  nido-hub \
  nidoagent-cli \
  nidoai-gateway \
  nidooffice-cli \
  nidooffice-desktop \
  nidobox \
  vielotus; do
  if dpkg -s "$core_meta" >/dev/null 2>&1; then
    apt-mark manual "$core_meta" >/dev/null 2>&1 || true
  fi
done

PRUNE_PATTERNS=(
  'aisleriot'
  'gnome-mahjongg'
  'gnome-mines'
  'gnome-sudoku'
  'quadrapassel'
  'five-or-more'
  'four-in-a-row'
  'gnome-chess'
  'gnome-klotski'
  'gnome-nibbles'
  'gnome-robots'
  'gnome-tetravex'
  'hitori'
  'iagno'
  'lightsoff'
  'swell-foop'
  'tali'
  'transmission-gtk'
  'transmission-common'
  'rhythmbox'
  'rhythmbox-data'
  'rhythmbox-plugins'
  'shotwell'
  'shotwell-common'
  'remmina'
  'remmina-common'
  'remmina-plugin-*'
  'deja-dup'
  'thunderbird'
)

mapfile -t PRUNE_PKGS < <(
  dpkg-query -W -f='${db:Status-Abbrev}\t${Package}\n' "${PRUNE_PATTERNS[@]}" 2>/dev/null \
    | awk '$1 ~ /^i/ { print $2 }' \
    | sort -u || true
)

if [ "${#PRUNE_PKGS[@]}" -gt 0 ]; then
  echo "[Ubuntu-Nido] Pruning non-minimal desktop apps (${#PRUNE_PKGS[@]}): ${PRUNE_PKGS[*]}"
  "${APT_GET[@]}" purge -y "${PRUNE_PKGS[@]}" || true
  "${APT_GET[@]}" autoremove -y --purge || true
fi

rm -f \
  /usr/share/applications/thunderbird*.desktop \
  /var/lib/snapd/desktop/applications/thunderbird_*.desktop \
  /var/lib/snapd/desktop/applications/snap-store_*.desktop \
  /var/lib/snapd/desktop/applications/desktop-security-center_*.desktop \
  /var/lib/snapd/desktop/applications/firefox_*.desktop \
  /usr/share/applications/transmission*.desktop \
  /usr/share/applications/org.gnome.Rhythmbox3*.desktop \
  /usr/share/applications/org.gnome.Shotwell*.desktop \
  /usr/share/applications/org.remmina.Remmina*.desktop \
  /usr/share/applications/org.gnome.DejaDup*.desktop \
  /etc/xdg/autostart/org.gnome.DejaDup*.desktop \
  /etc/xdg/autostart/ubuntu-report-on-upgrade.desktop

# Hide "Ubuntu Desktop" panel in GNOME Settings (permanently via dpkg-divert so
# future gnome-control-center upgrades never re-expose it).
if [ -e /usr/share/applications/gnome-ubuntu-panel.desktop ]; then
  if ! dpkg-divert --list /usr/share/applications/gnome-ubuntu-panel.desktop 2>/dev/null | grep -q gnome-ubuntu-panel.desktop; then
    dpkg-divert --local --rename \
      --divert /usr/share/applications/gnome-ubuntu-panel.desktop.nido-disabled \
      --add /usr/share/applications/gnome-ubuntu-panel.desktop >/dev/null 2>&1 || true
  fi
  rm -f /usr/share/applications/gnome-ubuntu-panel.desktop
fi

# Disable Ubuntu Pro, Ubuntu Insights, Ubuntu Report, Whoopsie, Apport,
# gnome-initial-setup (clashes with NidoHub onboarding), and update-notifier popups
# (preserves ubuntu-desktop-minimal, unattended-upgrades security updates, and fwupd).
for divert_path in \
  /usr/share/dbus-1/system-services/com.canonical.UbuntuAdvantage.service \
  /usr/share/dbus-1/system-services/org.freedesktop.PackageKit.service \
  /etc/apt/apt.conf.d/20packagekit \
  /etc/xdg/autostart/gnome-initial-setup-first-login.desktop \
  /etc/xdg/autostart/gnome-initial-setup-copy-worker.desktop \
  /etc/xdg/autostart/update-notifier.desktop \
  /etc/xdg/autostart/ubuntu-advantage-notification.desktop \
  /etc/xdg/autostart/localsearch-3.desktop \
  /etc/xdg/autostart/org.gnome.Evolution-alarm-notify.desktop \
  /etc/xdg/autostart/snap-userd-autostart.desktop; do
  if [ -e "$divert_path" ]; then
    if ! dpkg-divert --list "$divert_path" 2>/dev/null | grep -q "$(basename "$divert_path")"; then
      dpkg-divert --local --rename \
        --divert "${divert_path}.nido-disabled" \
        --add "$divert_path" >/dev/null 2>&1 || true
    fi
    rm -f "$divert_path"
  fi
done

mkdir -p /etc/systemd/system /etc/systemd/user
for sys_unit in \
  ubuntu-advantage-desktop-daemon.service \
  whoopsie.service \
  whoopsie.path \
  apport.service \
  apport-autoreport.service \
  apport-autoreport.path \
  apt-news.service \
  esm-cache.service \
  packagekit.service \
  packagekit-offline-update.service; do
  ln -snf /dev/null "/etc/systemd/system/${sys_unit}"
done

for usr_unit in \
  localsearch-3.service \
  localsearch-control-3.service \
  gnome-initial-setup-first-login.service \
  gnome-initial-setup-upgrade-login.service \
  gnome-initial-setup-copy-worker.service \
  update-notifier-crash.path \
  update-notifier-crash.service \
  update-notifier-livepatch.path \
  update-notifier-livepatch.service \
  update-notifier-release.path \
  update-notifier-release.service \
  ubuntu-insights-collect.timer \
  ubuntu-insights-upload.timer \
  ubuntu-insights-collect.service \
  ubuntu-insights-upload.service \
  ubuntu-report.path \
  ubuntu-report.service; do
  ln -snf /dev/null "/etc/systemd/user/${usr_unit}"
  rm -f \
    "/etc/systemd/user/default.target.wants/${usr_unit}" \
    "/etc/systemd/user/gnome-session.target.wants/${usr_unit}" \
    "/etc/systemd/user/graphical-session.target.wants/${usr_unit}" \
    "/etc/systemd/user/graphical-session-pre.target.wants/${usr_unit}" 2>/dev/null || true
done

if [ -f /etc/default/apport ]; then
  sed -i 's/^enabled=.*/enabled=0/' /etc/default/apport || true
fi

# Configure compressed zram swap (zstd) + earlyoom for responsive desktop RAM headroom
mkdir -p /etc/systemd
cat > /etc/systemd/zram-generator.conf <<'ZRAM'
[zram0]
zram-size = min(ram / 2, 4096)
compression-algorithm = zstd
swap-priority = 100
ZRAM
if command -v systemctl >/dev/null 2>&1; then
  systemctl enable earlyoom.service >/dev/null 2>&1 || true
fi

# Prevent Ubuntu non-LTS release upgrade prompts (updates flow via NidoHub + unattended-upgrades)
if [ -f /etc/update-manager/release-upgrades ]; then
  if grep -q '^Prompt=' /etc/update-manager/release-upgrades; then
    sed -i 's/^Prompt=.*/Prompt=never/' /etc/update-manager/release-upgrades || true
  else
    printf '\nPrompt=never\n' >> /etc/update-manager/release-upgrades
  fi
else
  mkdir -p /etc/update-manager
  printf '[DEFAULT]\nPrompt=never\n' > /etc/update-manager/release-upgrades
fi

# Ensure Geary is the default email handler instead of Thunderbird
for sys_mf in /usr/share/applications/ubuntu-mimeapps.list /usr/share/applications/gnome-mimeapps.list; do
  if [ -f "$sys_mf" ]; then
    sed -i -E \
      -e 's/thunderbird_thunderbird\.desktop/org.gnome.Geary.desktop/g' \
      -e 's/thunderbird\.desktop/org.gnome.Geary.desktop/g' \
      "$sys_mf" || true
  fi
done

if command -v update-desktop-database >/dev/null 2>&1; then
  update-desktop-database -q /usr/share/applications || true
fi

# Verify Nido Minimal Desktop core pillars remain intact
dpkg -s ubuntu-desktop-minimal >/dev/null
dpkg -s network-manager >/dev/null
dpkg -s pipewire >/dev/null 2>&1 || dpkg -s pipewire-bin >/dev/null
dpkg -s bluez >/dev/null
dpkg -s cups >/dev/null 2>&1 || dpkg -s cups-daemon >/dev/null 2>&1 || dpkg -s legacy-printer-app >/dev/null
test -x /usr/bin/gnome-shell
test -x /usr/bin/nautilus

echo "[Ubuntu-Nido] Nido Minimal Desktop profile hook completed."
