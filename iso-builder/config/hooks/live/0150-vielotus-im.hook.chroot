#!/usr/bin/env bash
# Hook 0150: Install and configure first-party Sen Viet (VieLotusIM v2.0.4) over native GNOME IBus (no Fcitx5)
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive

APT_LOCK_TIMEOUT="${APT_LOCK_TIMEOUT:-600}"
APT_GET=(apt-get -o "DPkg::Lock::Timeout=${APT_LOCK_TIMEOUT}")
VIELOTUS_VERSION="2.0.4"
ARCH="$(dpkg --print-architecture)"

# Remove Fcitx5 daemon/frontends/config packages if any exist (keep libfcitx5* C++ shared libs required by vielotus)
mapfile -t FCITX_PKGS < <(
  dpkg-query -W -f='${db:Status-Abbrev}\t${Package}\n' 'fcitx5' 'fcitx5-*' 2>/dev/null \
    | awk '$1 ~ /^i/ && $2 != "vielotus" { print $2 }' \
    | sort -u || true
)
if [ "${#FCITX_PKGS[@]}" -gt 0 ]; then
  echo "[Ubuntu-Nido] Removing Fcitx5 packages in favor of native IBus: ${FCITX_PKGS[*]}"
  "${APT_GET[@]}" purge -y "${FCITX_PKGS[@]}" || true
  "${APT_GET[@]}" autoremove -y --purge || true
fi

if dpkg -s vielotus >/dev/null 2>&1; then
  echo "[Ubuntu-Nido] Package 'vielotus' already installed."
else
  echo "[Ubuntu-Nido] Installing Sen Viet (vielotus ${VIELOTUS_VERSION} / ${ARCH}) from signed APT repository..."
  "${APT_GET[@]}" update -qq || true
  if ! "${APT_GET[@]}" install -y --no-install-recommends vielotus; then
    echo "[Ubuntu-Nido] APT install fell back to verified release asset..."
    DL_DIR="/tmp/vielotus-dl"
    DEB_NAME="vielotus_${VIELOTUS_VERSION}_${ARCH}.deb"
    BASE_URL="https://github.com/stevedat/VieLotus-IM/releases/download/v${VIELOTUS_VERSION}"
    rm -rf "$DL_DIR"
    mkdir -p "$DL_DIR"
    curl -fsSL "${BASE_URL}/${DEB_NAME}" -o "${DL_DIR}/${DEB_NAME}"
    curl -fsSL "${BASE_URL}/checksums.sha256" -o "${DL_DIR}/checksums.sha256"
    (
      cd "$DL_DIR"
      grep "  ${DEB_NAME}\$" checksums.sha256 | sha256sum -c -
    )
    "${APT_GET[@]}" install -y --no-install-recommends "${DL_DIR}/${DEB_NAME}"
    rm -rf "$DL_DIR"
  fi
fi

mkdir -p /etc/skel/.config/vielotus
cat > /etc/skel/.config/vielotus/config.env <<'VLCONF'
INPUT_METHOD=telex
GRAMMAR_PROFILE=classic
SMART_BILINGUAL=true
MODERN_ORTHOGRAPHY=true
VLCONF

# Keep base console/GDM/installer XKB layout on clean US so Sen Viet Telex
# handles Vietnamese diacritics instead of the legacy XKB 'vn' number-row layout.
if [ -f /etc/default/keyboard ]; then
  if grep -Eq '^XKBLAYOUT="?vn"?$' /etc/default/keyboard; then
    sed -i 's/^XKBLAYOUT=.*/XKBLAYOUT="us"/' /etc/default/keyboard || true
  fi
else
  mkdir -p /etc/default
  cat > /etc/default/keyboard <<'KBDCONF'
XKBMODEL="pc105"
XKBLAYOUT="us"
XKBVARIANT=""
XKBOPTIONS=""
BACKSPACE="guess"
KBDCONF
fi

# Let GNOME Shell Wayland manage org.freedesktop.IBus.session.GNOME.service natively;
# remove im-config/xinputrc overrides that spawn duplicate conflicting ibus-daemon instances.
rm -rf /etc/skel/.config/fcitx5 \
  /etc/skel/.xinputrc \
  /etc/profile.d/ubuntu-nido-fcitx5.sh \
  /etc/xdg/autostart/ubuntu-nido-im-enable.desktop \
  /etc/xdg/autostart/*fcitx*.desktop \
  /usr/share/applications/*fcitx*.desktop

if command -v im-config >/dev/null 2>&1; then
  im-config -n default >/dev/null 2>&1 || true
fi

# Prevent upstream vielotus-onboard autostart from racing ensure-vietnamese-ime at login
if [ -e /etc/xdg/autostart/vielotus-onboard.desktop ]; then
  if ! dpkg-divert --list /etc/xdg/autostart/vielotus-onboard.desktop 2>/dev/null | grep -q vielotus-onboard.desktop; then
    dpkg-divert --local --rename \
      --divert /etc/xdg/autostart/vielotus-onboard.desktop.nido-disabled \
      --add /etc/xdg/autostart/vielotus-onboard.desktop >/dev/null 2>&1 || true
  fi
  rm -f /etc/xdg/autostart/vielotus-onboard.desktop
fi

if command -v ibus >/dev/null 2>&1; then
  ibus write-cache --system >/dev/null 2>&1 || true
fi

if [ -d /etc/dconf/db/local.d ] && command -v dconf >/dev/null 2>&1; then
  dconf compile /etc/dconf/db/local /etc/dconf/db/local.d >/dev/null 2>&1 || dconf update >/dev/null 2>&1 || true
fi

if [ -d /usr/share/glib-2.0/schemas ] && command -v glib-compile-schemas >/dev/null 2>&1; then
  glib-compile-schemas /usr/share/glib-2.0/schemas >/dev/null 2>&1 || true
fi

dpkg -s vielotus >/dev/null
grep -q "<name>vielotus</name>" /usr/share/ibus/component/vielotus.xml
grep -q "<name>vielotus-vni</name>" /usr/share/ibus/component/vielotus.xml
echo "[Ubuntu-Nido] Sen Viet (VieLotusIM Telex + VNI over native IBus) hook completed."
