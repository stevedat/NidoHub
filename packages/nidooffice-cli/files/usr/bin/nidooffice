#!/bin/sh
set -eu

# nidooffice — headless GenOffice document CLI for Ubuntu-Nido
# Locates genoffice.cjs from install dir or NIDOOFFICE_CLI_ENTRY env.

CLI_ENTRY="${NIDOOFFICE_CLI_ENTRY:-/usr/lib/nidooffice-cli/genoffice.cjs}"

if [ ! -f "$CLI_ENTRY" ]; then
  echo "Error: genoffice CLI engine not found at $CLI_ENTRY" >&2
  echo "Install the nidooffice-cli-engine package or set NIDOOFFICE_CLI_ENTRY." >&2
  exit 1
fi

exec node "$CLI_ENTRY" "$@"
