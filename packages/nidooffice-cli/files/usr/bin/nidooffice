#!/bin/sh
set -eu

# nidooffice — headless document CLI for Ubuntu-Nido
# Uses GenOffice engine when present, otherwise built-in standalone OOXML engine.

CLI_ENTRY="${NIDOOFFICE_CLI_ENTRY:-/usr/lib/nidooffice-cli/genoffice.cjs}"
PY_ENTRY="${NIDOOFFICE_PY_ENTRY:-/usr/lib/nidooffice-cli/engine.py}"

if [ -f "$CLI_ENTRY" ] && command -v node >/dev/null 2>&1; then
  exec node "$CLI_ENTRY" "$@"
fi

exec python3 "$PY_ENTRY" "$@"
