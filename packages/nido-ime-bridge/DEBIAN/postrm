#!/bin/sh
set -e

case "${1:-}" in
  remove|abort-install|disappear)
    if [ -L /usr/bin/vielotus-settings ] && [ "$(readlink /usr/bin/vielotus-settings 2>/dev/null || true)" = "/usr/bin/nido-vielotus-settings" ]; then
      rm -f /usr/bin/vielotus-settings
    fi
    if dpkg-divert --list /usr/bin/vielotus-settings 2>/dev/null | grep -q 'by nido-ime-bridge'; then
      dpkg-divert --package nido-ime-bridge --remove --rename \
        --divert /usr/bin/vielotus-settings.upstream /usr/bin/vielotus-settings >/dev/null 2>&1 || true
    fi
    ;;
esac

if command -v ibus >/dev/null 2>&1; then
  ibus write-cache --system >/dev/null 2>&1 || true
fi

exit 0
