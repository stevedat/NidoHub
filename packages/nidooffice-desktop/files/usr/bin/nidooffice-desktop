#!/usr/bin/env bash
set -euo pipefail

RUNTIME_INSTALLER="${NIDOOFFICE_RUNTIME_INSTALLER:-/usr/lib/nidooffice-desktop/install-runtime.sh}"

case "${1:-}" in
  --version|-V)
    if [ -f /opt/NidoOffice/.nidooffice-version ]; then
      printf 'NidoOffice Desktop %s\n' "$(cat /opt/NidoOffice/.nidooffice-version)"
      exit 0
    fi
    if [ -x "$RUNTIME_INSTALLER" ]; then
      exec "$RUNTIME_INSTALLER" --check
    fi
    echo "NidoOffice Desktop (runtime not installed)" >&2
    exit 1
    ;;
  --check-update)
    shift
    exec "$RUNTIME_INSTALLER" --check "$@"
    ;;
  --update)
    shift
    if [ "$(id -u)" -eq 0 ]; then
      exec "$RUNTIME_INSTALLER" "$@"
    elif [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && command -v pkexec >/dev/null 2>&1; then
      exec pkexec "$RUNTIME_INSTALLER" "$@"
    elif command -v sudo >/dev/null 2>&1; then
      exec sudo "$RUNTIME_INSTALLER" "$@"
    else
      echo "nidooffice-desktop --update requires root privileges (pkexec or sudo)." >&2
      exit 1
    fi
    ;;
esac

BIN="/opt/NidoOffice/nidooffice"
if [ ! -x "$BIN" ]; then
  BIN="/opt/NidoOffice/genoffice"
fi

export ELECTRON_OZONE_PLATFORM_HINT="${ELECTRON_OZONE_PLATFORM_HINT:-auto}"
EXTRA_ARGS=()

if [ -n "${WAYLAND_DISPLAY:-}" ]; then
  HAS_IME=0
  HAS_TI_VER=0
  for arg in "$@"; do
    case "$arg" in
      --enable-wayland-ime) HAS_IME=1 ;;
      --wayland-text-input-version=*) HAS_TI_VER=1 ;;
    esac
  done
  [ "$HAS_IME" -eq 0 ] && EXTRA_ARGS+=(--enable-wayland-ime)
  [ "$HAS_TI_VER" -eq 0 ] && EXTRA_ARGS+=(--wayland-text-input-version=3)
fi

if [ "$(id -u)" -eq 0 ]; then
  HAS_NO_SANDBOX=0
  for arg in "$@"; do
    if [ "$arg" = "--no-sandbox" ]; then
      HAS_NO_SANDBOX=1
      break
    fi
  done
  [ "$HAS_NO_SANDBOX" -eq 0 ] && EXTRA_ARGS+=(--no-sandbox)
else
  # Wake NidoAI Gateway on-demand for NidoOS Loopback SSO when AI policy is enabled
  if command -v systemctl >/dev/null 2>&1; then
    NIDO_CFG_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/ubuntu-nido"
    NIDO_AI_DIR="${NIDOAI_HOME:-${HOME}/.nidoai}"
    if [ -f "${NIDO_CFG_DIR}/ai-policy.json" ] \
      && ! grep -Eq '"aiEnabled"[[:space:]]*:[[:space:]]*false' "${NIDO_CFG_DIR}/ai-policy.json" 2>/dev/null \
      && ! grep -Eq '^NIDOAI_ENABLED=(0|false|off|no)$' "${NIDO_AI_DIR}/.env.local" 2>/dev/null; then
      if ! systemctl --user is-active --quiet nidoai-gateway.service 2>/dev/null; then
        systemctl --user start --no-block nidoai-gateway.service >/dev/null 2>&1 || true
      fi
    fi
  fi
fi

exec "$BIN" "${EXTRA_ARGS[@]}" "$@"
