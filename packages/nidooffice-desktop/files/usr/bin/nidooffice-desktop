#!/usr/bin/env bash
set -euo pipefail

SELF_REAL="$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")"
case "$SELF_REAL" in
  /usr/bin/*) SYSTEM_INSTALLED=1 ;;
  *) SYSTEM_INSTALLED=0 ;;
esac

SYSTEM_RUNTIME_INSTALLER="/usr/lib/nidooffice-desktop/install-runtime.sh"
if [ "$SYSTEM_INSTALLED" -eq 1 ]; then
  RUNTIME_INSTALLER="$SYSTEM_RUNTIME_INSTALLER"
else
  RUNTIME_INSTALLER="${NIDOOFFICE_RUNTIME_INSTALLER:-$SYSTEM_RUNTIME_INSTALLER}"
fi

case "${1:-}" in
  --version|-V)
    if [ -f /opt/NidoOffice/.installed-version ]; then
      printf 'NidoOffice Desktop %s\n' "$(cat /opt/NidoOffice/.installed-version)"
      exit 0
    fi
    if [ -f /opt/NidoOffice/.nidooffice-version ]; then
      printf 'NidoOffice Desktop %s\n' "$(cat /opt/NidoOffice/.nidooffice-version)"
      exit 0
    fi
    if [ -x "$RUNTIME_INSTALLER" ]; then
      exec "$RUNTIME_INSTALLER" --check
    fi
    echo "NidoOffice Desktop (runtime not installed)" >&2
    exit 1
    ;;
  --check-update)
    shift
    exec "$RUNTIME_INSTALLER" --check "$@"
    ;;
  --update)
    shift
    if [ "$(id -u)" -eq 0 ]; then
      exec "$RUNTIME_INSTALLER" "$@"
    elif [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && command -v pkexec >/dev/null 2>&1; then
      exec pkexec "$SYSTEM_RUNTIME_INSTALLER" "$@"
    elif command -v sudo >/dev/null 2>&1; then
      exec sudo "$SYSTEM_RUNTIME_INSTALLER" "$@"
    else
      echo "nidooffice-desktop --update requires root privileges (pkexec or sudo)." >&2
      exit 1
    fi
    ;;
esac

if [ "$SYSTEM_INSTALLED" -eq 1 ]; then
  BIN="/opt/NidoOffice/nidooffice"
  if [ ! -x "$BIN" ]; then
    BIN="/opt/NidoOffice/genoffice"
  fi
else
  BIN="${NIDOOFFICE_BIN:-/opt/NidoOffice/nidooffice}"
  if [ ! -x "$BIN" ]; then
    BIN="/opt/NidoOffice/genoffice"
  fi
fi

# Detect virtual/software-GPU VMs (same allowlist as 60-nido-vm-gsk & native-first-cleanup)
# so Electron/Chromium skips slow software EGL/Vulkan probe (~300ms) and llvmpipe RAM overhead.
# Bare-metal hosts and GPU-passthrough VMs keep hardware GPU acceleration untouched.
_nido_is_software_gpu_vm() {
  if [ "${NIDOOFFICE_ENABLE_GPU:-0}" = "1" ]; then
    return 1
  fi
  local vm_type=""
  if [ "${NIDO_VM_VIRT_TYPE+set}" = "set" ]; then
    vm_type="$NIDO_VM_VIRT_TYPE"
  elif command -v systemd-detect-virt >/dev/null 2>&1; then
    vm_type="$(systemd-detect-virt --vm 2>/dev/null || true)"
  fi
  if [ -z "$vm_type" ] || [ "$vm_type" = "none" ]; then
    return 1
  fi
  local drm_dir="${NIDO_DRM_SYSFS:-/sys/class/drm}"
  local uev drv
  for uev in "${drm_dir}"/card*/device/uevent; do
    [ -f "$uev" ] || continue
    drv="$(awk -F= '$1 == "DRIVER" { print $2; exit }' "$uev" 2>/dev/null || true)"
    case "$drv" in
      i915|xe|amdgpu|radeon|nvidia|nouveau|apple|asahi|msm|panfrost|panthor|etnaviv|vc4|v3d)
        return 1
        ;;
    esac
  done
  return 0
}

export ELECTRON_OZONE_PLATFORM_HINT="${ELECTRON_OZONE_PLATFORM_HINT:-auto}"
EXTRA_ARGS=()

HAS_GPU_FLAG=0
for arg in "$@"; do
  case "$arg" in
    --disable-gpu|--enable-gpu|--use-gl=*) HAS_GPU_FLAG=1; break ;;
  esac
done
if [ "$HAS_GPU_FLAG" -eq 0 ] && _nido_is_software_gpu_vm; then
  EXTRA_ARGS+=(--disable-gpu)
fi

if [ -n "${WAYLAND_DISPLAY:-}" ]; then
  HAS_IME=0
  HAS_TI_VER=0
  for arg in "$@"; do
    case "$arg" in
      --enable-wayland-ime) HAS_IME=1 ;;
      --wayland-text-input-version=*) HAS_TI_VER=1 ;;
    esac
  done
  [ "$HAS_IME" -eq 0 ] && EXTRA_ARGS+=(--enable-wayland-ime)
  [ "$HAS_TI_VER" -eq 0 ] && EXTRA_ARGS+=(--wayland-text-input-version=3)
fi

if [ "$(id -u)" -eq 0 ]; then
  HAS_NO_SANDBOX=0
  for arg in "$@"; do
    if [ "$arg" = "--no-sandbox" ]; then
      HAS_NO_SANDBOX=1
      break
    fi
  done
  [ "$HAS_NO_SANDBOX" -eq 0 ] && EXTRA_ARGS+=(--no-sandbox)
else
  # Wake NidoAI Gateway on-demand for NidoOS Loopback SSO when AI policy is enabled
  if command -v systemctl >/dev/null 2>&1; then
    NIDO_CFG_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/ubuntu-nido"
    NIDO_AI_DIR="${NIDOAI_HOME:-${HOME}/.nidoai}"
    if [ -f "${NIDO_CFG_DIR}/ai-policy.json" ] \
      && ! grep -Eq '"aiEnabled"[[:space:]]*:[[:space:]]*false' "${NIDO_CFG_DIR}/ai-policy.json" 2>/dev/null \
      && ! grep -Eq '^NIDOAI_ENABLED=(0|false|off|no)$' "${NIDO_AI_DIR}/.env.local" 2>/dev/null; then
      if ! systemctl --user is-active --quiet nidoai-gateway.service 2>/dev/null; then
        systemctl --user start --no-block nidoai-gateway.service >/dev/null 2>&1 || true
      fi
    fi
  fi
fi

exec "$BIN" ${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"} "$@"
