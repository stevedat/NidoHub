#!/usr/bin/env bash
# Runs once on an installed Ubuntu-Nido system (NEVER inside a Live ISO installer session).
# - Removes Ubuntu App Center (snap-store) so NidoHub is the single default software manager.
# - Removes Firefox Snap ONLY if the official Mozilla DEB /usr/bin/firefox is installed.
# - Preserves snapd, Live Installer dependencies, and fwupd firmware updates.
set -euo pipefail

# Never run in Live ISO / Casper environments
if [ -f /run/casper-md5check.json ] || [ -f /cdrom/.disk/info ] || [ -d /snap/ubuntu-desktop-bootstrap ] || grep -qw "boot=casper" /proc/cmdline 2>/dev/null; then
  exit 0
fi

# Defense-in-depth: ensure ISO cdrom.sources never lingers on an installed system
rm -f /etc/apt/sources.list.d/cdrom.sources 2>/dev/null || true

STAMP_DIR="/var/lib/ubuntu-nido"
STAMP_FILE="${STAMP_DIR}/native-first-cleaned"
if [ -f "$STAMP_FILE" ] && [ "${1:-}" != "--force" ]; then
  exit 0
fi

# Apply fast installed-system desktop perf tweaks immediately (<100ms) before slow snap removal
# Disable Desktop Icons NG (ding@rastersoft.com, ~100 MB gjs RAM) on installed systems
# (Live ISO keeps ding enabled for the "Cài đặt NidoOS" desktop icon; users can still re-enable it.)
# Also disable GNOME animations on VMs with software GPU (Cairo renderer = CPU-only
# 60fps transitions). On bare metal this key is absent so animations stay enabled.
mkdir -p /etc/dconf/db/local.d
VM_TYPE="$(systemd-detect-virt --vm 2>/dev/null || true)"
VM_ANIM_LINE=""
if [ -n "$VM_TYPE" ] && [ "$VM_TYPE" != "none" ]; then
  # Only disable animations when no hardware GPU is detected (same logic as 60-nido-vm-gsk)
  HAS_HW_GPU=0
  for _uev in /sys/class/drm/card*/device/uevent; do
    [ -f "$_uev" ] || continue
    _drv="$(awk -F= '$1 == "DRIVER" { print $2; exit }' "$_uev" 2>/dev/null || true)"
    case "$_drv" in
      i915|xe|amdgpu|radeon|nvidia|nouveau|apple|asahi|msm|panfrost|panthor|etnaviv|vc4|v3d) HAS_HW_GPU=1 ;;
    esac
  done
  if [ "$HAS_HW_GPU" -eq 0 ]; then
    VM_ANIM_LINE=$'\n[org/gnome/desktop/interface]\nenable-animations=false'
  fi
fi
cat > /etc/dconf/db/local.d/10-nido-installed-perf <<DCONF_PERF
[org/gnome/shell]
disabled-extensions=['ding@rastersoft.com']${VM_ANIM_LINE}
DCONF_PERF
if command -v dconf >/dev/null 2>&1; then
  dconf compile /etc/dconf/db/local /etc/dconf/db/local.d >/dev/null 2>&1 || dconf update >/dev/null 2>&1 || true
fi

# Pre-compile Python bytecache for NidoHub & desktop helper modules (saves ~100-200ms on first launch)
if command -v python3 >/dev/null 2>&1; then
  python3 -m compileall -q /usr/lib/nido-hub/ /usr/libexec/ubuntu-nido/ >/dev/null 2>&1 || true
fi

# Ensure NTP clock sync is enabled on first boot (resilient to VMware/UTM RTC clock drift)
if command -v timedatectl >/dev/null 2>&1; then
  timedatectl set-ntp true >/dev/null 2>&1 || true
fi
if command -v systemctl >/dev/null 2>&1 && systemctl list-unit-files systemd-timesyncd.service >/dev/null 2>&1; then
  systemctl restart systemd-timesyncd.service >/dev/null 2>&1 || true
fi

if [ -x /usr/libexec/ubuntu-nido/configure-firewall ]; then
  /usr/libexec/ubuntu-nido/configure-firewall >/dev/null 2>&1 || true
fi

if ! command -v snap >/dev/null 2>&1; then
  mkdir -p "$STAMP_DIR"
  date -u +"%Y-%m-%dT%H:%M:%SZ" > "$STAMP_FILE"
  exit 0
fi

# Wait briefly for snapd socket if booting for the first time
if command -v snap >/dev/null 2>&1; then
  snap wait system seed.loaded >/dev/null 2>&1 || true
fi

# 1. Remove Ubuntu App Center (snap-store), Thunderbird Snap (replaced by Geary),
# Ubuntu Security Center (desktop-security-center), and snapd-desktop-integration
for unwanted_snap in snap-store thunderbird desktop-security-center snapd-desktop-integration; do
  if snap list "$unwanted_snap" >/dev/null 2>&1; then
    echo "[NidoOS] Removing ${unwanted_snap} snap..."
    snap remove --purge "$unwanted_snap" || true
  fi
  rm -f "/var/lib/snapd/desktop/applications/${unwanted_snap}_"*.desktop 2>/dev/null || true
done

# 2. Remove Firefox Snap ONLY if official Mozilla DEB Firefox is verified installed
if [ -x /usr/bin/firefox ] && ! grep -qs "snap install firefox" /usr/bin/firefox 2>/dev/null; then
  if snap list firefox >/dev/null 2>&1; then
    echo "[NidoOS] Removing Firefox Snap (official Mozilla Firefox DEB is active)..."
    snap remove --purge firefox || true
  fi
  rm -f /var/lib/snapd/desktop/applications/firefox_*.desktop 2>/dev/null || true
fi

# 3. Switch snapd to on-demand socket activation when zero user snaps remain (~150 MB RAM saved)
USER_SNAPS="$(snap list 2>/dev/null | awk 'NR>1 && $1 !~ /^(bare|core[0-9]*|snapd|gnome-|gtk-common-themes|mesa-|firmware-updater|prompting-client)$/ {print $1}')"
if [ -z "$USER_SNAPS" ] && command -v systemctl >/dev/null 2>&1; then
  systemctl disable --now snapd.service snapd.seeded.service >/dev/null 2>&1 || true
fi

if command -v update-desktop-database >/dev/null 2>&1; then
  update-desktop-database -q /usr/share/applications || true
fi

mkdir -p "$STAMP_DIR"
date -u +"%Y-%m-%dT%H:%M:%SZ" > "$STAMP_FILE"
echo "[Ubuntu-Nido] Native-First installed-system cleanup complete (snapd & fwupd preserved)."
