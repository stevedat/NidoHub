[Unit]
Description=Ubuntu-Nido Native-First Installed System Cleanup
After=snapd.seeded.service
Wants=snapd.seeded.service
ConditionPathExists=!/run/casper-md5check.json
ConditionPathExists=!/cdrom/.disk/info
ConditionPathExists=!/var/lib/ubuntu-nido/native-first-cleaned

[Service]
Type=simple
ExecStart=/usr/libexec/ubuntu-nido/native-first-cleanup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
