#!/bin/sh
set -e

rm -f /etc/apt/sources.list.d/ubuntu-nido.sources.disabled

SRC_FILE="/etc/apt/sources.list.d/ubuntu-nido.sources"
if [ -f "$SRC_FILE" ] && [ -f /etc/os-release ]; then
  CODENAME="$(
    # shellcheck disable=SC1091
    . /etc/os-release
    printf '%s' "${UBUNTU_CODENAME:-${VERSION_CODENAME:-noble}}"
  )"
  case "$CODENAME" in
    resolute|noble)
      SUITE="$CODENAME"
      ;;
    *)
      SUITE="noble"
      ;;
  esac
  sed -i "s|^Suites: .*|Suites: ${SUITE}|" "$SRC_FILE"
fi

if [ -d /etc/dconf/db/local.d ] && command -v dconf >/dev/null 2>&1; then
  dconf compile /etc/dconf/db/local /etc/dconf/db/local.d >/dev/null 2>&1 || dconf update >/dev/null 2>&1 || true
fi

if [ -d /etc/dconf/db/gdm.d ] && command -v dconf >/dev/null 2>&1; then
  dconf compile /etc/dconf/db/gdm /etc/dconf/db/gdm.d >/dev/null 2>&1 || dconf update >/dev/null 2>&1 || true
fi

if [ -d /usr/share/glib-2.0/schemas ] && command -v glib-compile-schemas >/dev/null 2>&1; then
  glib-compile-schemas /usr/share/glib-2.0/schemas >/dev/null 2>&1 || true
fi

if command -v ibus >/dev/null 2>&1; then
  ibus write-cache --system >/dev/null 2>&1 || true
fi

# Disable vendor vielotus-onboard autostart so only NidoOS ensure-vietnamese-ime binds GNOME sources cleanly
if [ -e /etc/xdg/autostart/vielotus-onboard.desktop ]; then
  if ! dpkg-divert --list /etc/xdg/autostart/vielotus-onboard.desktop 2>/dev/null | grep -q vielotus-onboard.desktop; then
    dpkg-divert --local --rename \
      --divert /etc/xdg/autostart/vielotus-onboard.desktop.nido-disabled \
      --add /etc/xdg/autostart/vielotus-onboard.desktop >/dev/null 2>&1 || true
  fi
  rm -f /etc/xdg/autostart/vielotus-onboard.desktop
fi

if [ -f /usr/lib/systemd/system/nido-installer-fonts.service ]; then
  mkdir -p /etc/systemd/system/graphical.target.wants
  ln -snf /usr/lib/systemd/system/nido-installer-fonts.service \
    /etc/systemd/system/graphical.target.wants/nido-installer-fonts.service
fi

# Mask gnome-initial-setup, update-notifier & idle RAM-heavy services on upgraded installs too
mkdir -p /etc/systemd/user /etc/systemd/system
ln -snf /dev/null /etc/systemd/system/packagekit.service
ln -snf /dev/null /etc/systemd/system/packagekit-offline-update.service
# Divert PackageKit D-Bus activation & APT post-invoke hook so apt-get update never emits
# "GDBus.Error:org.freedesktop.systemd1.UnitMasked: Unit packagekit.service is masked."
if [ -e /usr/share/dbus-1/system-services/org.freedesktop.PackageKit.service ]; then
  if ! dpkg-divert --list /usr/share/dbus-1/system-services/org.freedesktop.PackageKit.service 2>/dev/null | grep -q org.freedesktop.PackageKit.service; then
    dpkg-divert --local --rename \
      --divert /usr/share/dbus-1/system-services/org.freedesktop.PackageKit.service.nido-disabled \
      --add /usr/share/dbus-1/system-services/org.freedesktop.PackageKit.service >/dev/null 2>&1 || true
  fi
  rm -f /usr/share/dbus-1/system-services/org.freedesktop.PackageKit.service
fi
# Divert 20packagekit OUTSIDE /etc/apt/apt.conf.d/ so APT never prints invalid-extension Notice warnings
mkdir -p /var/lib/ubuntu-nido/disabled
if dpkg-divert --list /etc/apt/apt.conf.d/20packagekit 2>/dev/null | grep -q '/etc/apt/apt.conf.d/20packagekit.nido-disabled'; then
  dpkg-divert --local --rename --remove /etc/apt/apt.conf.d/20packagekit >/dev/null 2>&1 || true
fi
rm -f /etc/apt/apt.conf.d/20packagekit.nido-disabled
if ! dpkg-divert --list /etc/apt/apt.conf.d/20packagekit 2>/dev/null | grep -q '/var/lib/ubuntu-nido/disabled/20packagekit'; then
  if [ -e /etc/apt/apt.conf.d/20packagekit ]; then
    dpkg-divert --local --rename \
      --divert /var/lib/ubuntu-nido/disabled/20packagekit \
      --add /etc/apt/apt.conf.d/20packagekit >/dev/null 2>&1 || true
  else
    dpkg-divert --local --no-rename \
      --divert /var/lib/ubuntu-nido/disabled/20packagekit \
      --add /etc/apt/apt.conf.d/20packagekit >/dev/null 2>&1 || true
  fi
fi
rm -f /etc/apt/apt.conf.d/20packagekit
for usr_unit in \
  localsearch-3.service \
  localsearch-control-3.service \
  gnome-initial-setup-first-login.service \
  gnome-initial-setup-upgrade-login.service \
  gnome-initial-setup-copy-worker.service \
  update-notifier-crash.path \
  update-notifier-crash.service \
  update-notifier-livepatch.path \
  update-notifier-livepatch.service \
  update-notifier-release.path \
  update-notifier-release.service; do
  ln -snf /dev/null "/etc/systemd/user/${usr_unit}"
done

if [ -f /etc/update-manager/release-upgrades ]; then
  if grep -q '^Prompt=' /etc/update-manager/release-upgrades; then
    sed -i 's/^Prompt=.*/Prompt=never/' /etc/update-manager/release-upgrades || true
  else
    printf '\nPrompt=never\n' >> /etc/update-manager/release-upgrades
  fi
fi

if command -v fc-cache >/dev/null 2>&1; then
  fc-cache -rf >/dev/null 2>&1 || true
fi

if command -v gtk-update-icon-cache >/dev/null 2>&1 && [ -d /usr/share/icons/hicolor ]; then
  gtk-update-icon-cache -f -t /usr/share/icons/hicolor >/dev/null 2>&1 || true
fi

if [ -d /etc/sysctl.d ] && command -v sysctl >/dev/null 2>&1; then
  sysctl --system >/dev/null 2>&1 || true
fi

if [ "${1:-}" = "configure" ] && command -v python3 >/dev/null 2>&1 && [ -d /usr/libexec/ubuntu-nido ]; then
  python3 -m compileall -q /usr/libexec/ubuntu-nido >/dev/null 2>&1 || true
fi

if [ "${1:-}" = "configure" ]; then
  if command -v modprobe >/dev/null 2>&1; then
    modprobe uinput >/dev/null 2>&1 || true
  fi
  if command -v udevadm >/dev/null 2>&1 && [ -S /run/udev/control ]; then
    udevadm control --reload-rules >/dev/null 2>&1 || true
    udevadm trigger --subsystem-match=misc --sysname-match=uinput >/dev/null 2>&1 || true
  fi
  if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl try-restart earlyoom.service >/dev/null 2>&1 || true
  fi
  if [ ! -f /run/casper-md5check.json ] && [ ! -d /snap/ubuntu-desktop-bootstrap ] \
    && [ -f /boot/grub/grub.cfg ] && ! grep -qs 'nowatchdog' /boot/grub/grub.cfg \
    && command -v update-grub >/dev/null 2>&1; then
    update-grub >/dev/null 2>&1 || true
  fi
  if [ -x /usr/libexec/ubuntu-nido/configure-firewall ]; then
    /usr/libexec/ubuntu-nido/configure-firewall --ensure-rules >/dev/null 2>&1 || true
  fi
fi

exit 0
