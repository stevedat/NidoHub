#!/bin/sh
set -e

if [ -d /etc/dconf/db/local.d ] && command -v dconf >/dev/null 2>&1; then
  dconf update >/dev/null 2>&1 || true
fi

# Install Ubuntu-Nido APT signing key if not present
KEYRING_DIR="/etc/apt/keyrings"
KEYRING_FILE="${KEYRING_DIR}/ubuntu-nido.gpg"
if [ ! -f "$KEYRING_FILE" ] && command -v curl >/dev/null 2>&1; then
  mkdir -p "$KEYRING_DIR"
  curl -fsSL "https://ubuntu-nido-apt.pages.dev/ubuntu-nido.gpg" \
    | gpg --dearmor -o "$KEYRING_FILE" 2>/dev/null || true
fi

exit 0
