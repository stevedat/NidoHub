[Desktop Entry]
Type=Application
Name=NidoOS Sen Việt IME Setup
Name[vi]=Kích hoạt bộ gõ Sen Việt (Telex & VNI)
Comment=Pre-activates Sen Viet Telex and VNI Vietnamese input sources in GNOME
Comment[vi]=Tự động kích hoạt sẵn bộ gõ Sen Việt (Telex và VNI) khi đăng nhập
Exec=/usr/libexec/ubuntu-nido/ensure-vietnamese-ime
Icon=vielotus
Terminal=false
NoDisplay=true
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Delay=2
OnlyShowIn=GNOME;
