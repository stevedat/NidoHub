[org/gnome/desktop/interface]
color-scheme='prefer-dark'
accent-color='teal'
gtk-theme='Yaru-prussiangreen-dark'
icon-theme='Yaru-prussiangreen-dark'
cursor-theme='Bibata-Modern-Classic'
clock-format='24h'
clock-show-weekday=true
show-battery-percentage=true
enable-hot-corners=false
font-name='Be Vietnam Pro 10'
document-font-name='Be Vietnam Pro 11'
monospace-font-name='Noto Sans Mono 10'
font-antialiasing='rgba'
font-hinting='slight'

[org/gnome/desktop/privacy]
report-technical-problems=false
send-software-usage-stats=false

[org/gnome/desktop/wm/preferences]
button-layout=':minimize,maximize,close'

[org/gnome/mutter]
center-new-windows=true
attach-modal-dialogs=true

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/ubuntu-nido/wallpaper.png'
picture-uri-dark='file:///usr/share/backgrounds/ubuntu-nido/wallpaper.png'
picture-options='zoom'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/ubuntu-nido/wallpaper.png'
picture-options='zoom'

[org/gnome/shell]
favorite-apps=['firefox.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Geary.desktop', 'nidooffice.desktop', 'com.nidoholdings.NidoHub.desktop', 'com.nidoholdings.NidoBox.desktop', 'org.gnome.Terminal.desktop']

[org/gnome/desktop/app-folders]
folder-children=['System', 'Utilities', 'Media']

[org/gnome/desktop/app-folders/folders/System]
name='Hệ thống'
apps=['org.gnome.DiskUtility.desktop', 'org.gnome.SystemMonitor.desktop', 'net.nokyan.Resources.desktop', 'org.gnome.Logs.desktop', 'org.gnome.PowerStats.desktop', 'org.gnome.baobab.desktop', 'org.gnome.seahorse.Application.desktop', 'gparted.desktop', 'gnome-language-selector.desktop', 'gnome-session-properties.desktop', 'system-config-printer.desktop', 'nm-connection-editor.desktop']

[org/gnome/desktop/app-folders/folders/Utilities]
name='Tiện ích'
apps=['org.gnome.Calculator.desktop', 'org.gnome.TextEditor.desktop', 'org.gnome.Characters.desktop', 'org.gnome.font-viewer.desktop', 'org.gnome.Evince.desktop', 'org.gnome.Papers.desktop', 'simple-scan.desktop', 'org.gnome.FileRoller.desktop', 'org.gnome.clocks.desktop', 'org.gnome.Weather.desktop', 'org.gnome.Calendar.desktop', 'org.gnome.Contacts.desktop']

[org/gnome/desktop/app-folders/folders/Media]
name='Đa phương tiện'
apps=['org.gnome.Showtime.desktop', 'org.gnome.Totem.desktop', 'org.gnome.Loupe.desktop', 'org.gnome.eog.desktop', 'org.gnome.Snapshot.desktop', 'org.gnome.Cheese.desktop']

[org/gnome/shell/extensions/dash-to-dock]
dock-position='BOTTOM'
extend-height=false
dock-fixed=true
autohide=true
autohide-in-fullscreen=true
intellihide=true
intellihide-mode='MAXIMIZED_WINDOWS'
dash-max-icon-size=40
transparency-mode='FIXED'
custom-background-color=true
background-color='#0f172a'
background-opacity=0.72
running-indicator-style='DOTS'
click-action='minimize-or-previews'
show-trash=false
show-mounts=false
show-apps-at-top=false

[org/gnome/shell/extensions/ding]
show-home=false
show-trash=false
show-volumes=false

[org/gnome/desktop/input-sources]
sources=[('ibus', 'vielotus'), ('ibus', 'vielotus-vni'), ('xkb', 'us')]
mru-sources=[('ibus', 'vielotus'), ('xkb', 'us'), ('ibus', 'vielotus-vni')]
per-window=false

[org/gnome/desktop/wm/keybindings]
switch-input-source=['<Super>space']
switch-input-source-backward=['<Shift><Super>space']

[org/gnome/settings-daemon/plugins/media-keys]
custom-keybindings=['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom0/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom1/']

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom0]
name='NidoAgent QuickLaunch'
command='/usr/local/bin/nidoagent-quicklaunch'
binding='<Super><Shift>a'

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom1]
name='NidoBox Capture Studio'
command='/usr/bin/nidobox --capture'
binding='<Super><Shift>s'
