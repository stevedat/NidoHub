#!/usr/bin/env bash
set -euo pipefail

declare -a SELECTED_FILES=()

if [[ -n "${NAUTILUS_SCRIPT_SELECTED_FILE_PATHS:-}" ]]; then
  while IFS= read -r line; do
    [[ -n "$line" ]] && SELECTED_FILES+=("$line")
  done <<< "$NAUTILUS_SCRIPT_SELECTED_FILE_PATHS"
elif [[ "$#" -gt 0 ]]; then
  SELECTED_FILES=("$@")
fi

if [[ "${#SELECTED_FILES[@]}" -eq 0 ]]; then
  command -v zenity >/dev/null 2>&1 && zenity --error --title="NidoBox" --text="Không có tệp nào được chọn."
  exit 1
fi

exec /usr/bin/nidobox --share "${SELECTED_FILES[@]}"
