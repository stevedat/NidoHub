#!/usr/bin/env python3
"""Ensure Sen Viet (VieLotusIM) Telex + VNI are pre-activated in GNOME Input Sources.

Runs once per user on desktop login (both Live ISO and installed NidoOS), letting
GNOME Shell manage IBus natively on Wayland/X11 while preventing Ubuntu Desktop
Installer (Subiquity), legacy ``im-config``/``.xinputrc`` overrides, or vendor
auto-onboard scripts from leaving the user without active Vietnamese input.
"""

from __future__ import annotations

import argparse
import ast
import datetime
import fcntl
import glob
import os
import shutil
import subprocess
import sys
import tempfile
import time
from contextlib import contextmanager
from pathlib import Path
from typing import Callable, Iterator

TELEX_SOURCE = ("ibus", "vielotus")
VNI_SOURCE = ("ibus", "vielotus-vni")
US_SOURCE = ("xkb", "us")
IBus_SYSTEMD_UNIT = "org.freedesktop.IBus.session.GNOME.service"
MARKER_VALUE = "v2:vielotus+vielotus-vni\n"

DEFAULT_VIELOTUS_CONF = (
    "INPUT_METHOD=telex\n"
    "GRAMMAR_PROFILE=classic\n"
    "SMART_BILINGUAL=true\n"
    "MODERN_ORTHOGRAPHY=true\n"
)


def parse_gsettings_sources(raw: str) -> list[tuple[str, str]]:
    text = (raw or "").strip()
    if text.startswith("@a(ss) "):
        text = text[len("@a(ss) ") :].strip()
    if not text:
        return []
    try:
        parsed = ast.literal_eval(text)
    except (SyntaxError, ValueError):
        return []
    out: list[tuple[str, str]] = []
    if isinstance(parsed, (list, tuple)):
        for item in parsed:
            if (
                isinstance(item, (list, tuple))
                and len(item) == 2
                and isinstance(item[0], str)
                and isinstance(item[1], str)
            ):
                out.append((item[0], item[1]))
    return out


def format_gsettings_sources(sources: list[tuple[str, str]]) -> str:
    return "[" + ", ".join(f"('{kind}', '{ident}')" for kind, ident in sources) + "]"


def build_target_input_sources(
    existing: list[tuple[str, str]],
) -> tuple[list[tuple[str, str]], list[tuple[str, str]]]:
    """Return ``(sources, mru_sources)`` with Sen Viet Telex + VNI + English US ready."""
    extras: list[tuple[str, str]] = []
    for src in existing:
        if src in (TELEX_SOURCE, VNI_SOURCE, US_SOURCE):
            continue
        # Subiquity writes legacy ('xkb', 'vn') (1=ă, 2=â number-row layout) when user selects
        # Vietnamese keyboard during install; replace it with clean ('xkb', 'us') + Sen Viet.
        if src == ("xkb", "vn"):
            continue
        if src not in extras:
            extras.append(src)

    sources = [TELEX_SOURCE, VNI_SOURCE, US_SOURCE, *extras]
    mru_sources = [TELEX_SOURCE, US_SOURCE, VNI_SOURCE, *extras]
    return sources, mru_sources


def is_marker_current(marker: Path) -> bool:
    """Return True only when ``marker`` carries the current versioned ready token."""
    try:
        return marker.is_file() and marker.read_text(encoding="utf-8").strip() == MARKER_VALUE.strip()
    except OSError:
        return False


def cleanup_stale_xinputrc(home_dir: Path) -> bool:
    """Remove obsolete NidoOS-written ``~/.xinputrc`` containing only ``run_im ibus``."""
    xinputrc = home_dir / ".xinputrc"
    if not xinputrc.is_file():
        return False
    try:
        lines = [
            ln.strip()
            for ln in xinputrc.read_text(encoding="utf-8", errors="replace").splitlines()
            if ln.strip() and not ln.strip().startswith("#")
        ]
        if lines == ["run_im ibus"]:
            xinputrc.unlink()
            return True
    except OSError:
        return False
    return False


def _default_pid_alive(pid: int) -> bool:
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
        return True
    except PermissionError:
        return True
    except OSError:
        return False


def _parse_ibus_bus_file(bfile: Path) -> tuple[int | None, str]:
    pid: int | None = None
    addr = ""
    try:
        for line in bfile.read_text(encoding="utf-8", errors="replace").splitlines():
            stripped = line.strip()
            if stripped.startswith("IBUS_DAEMON_PID="):
                raw_pid = stripped.split("=", 1)[1].strip().strip("'\"")
                if raw_pid.isdigit():
                    pid = int(raw_pid)
            elif stripped.startswith("IBUS_ADDRESS="):
                addr = stripped.split("=", 1)[1].strip().strip("'\"")
    except OSError:
        return None, ""
    return pid, addr


def discover_ibus_env(
    home_dir: Path,
    base_env: dict[str, str],
    pid_alive_fn: Callable[[int], bool] | None = None,
) -> dict[str, str]:
    """Return a copy of ``base_env`` populated with a verified live ``IBUS_ADDRESS``."""
    env = dict(base_env)
    bus_dir = home_dir / ".config" / "ibus" / "bus"
    if not bus_dir.is_dir():
        return env
    is_alive = pid_alive_fn or _default_pid_alive
    wayland_disp = (base_env.get("WAYLAND_DISPLAY") or "").strip()

    try:
        files = sorted(
            (p for p in bus_dir.iterdir() if p.is_file()),
            key=lambda p: p.stat().st_mtime,
            reverse=True,
        )
    except OSError:
        return env

    live_candidates: list[tuple[bool, str]] = []
    for bfile in files:
        pid, addr = _parse_ibus_bus_file(bfile)
        if not addr or pid is None or not is_alive(pid):
            continue
        matches_wayland = bool(wayland_disp and wayland_disp in bfile.name)
        if matches_wayland:
            env["IBUS_ADDRESS"] = addr
            return env
        live_candidates.append((matches_wayland, addr))

    if live_candidates:
        env["IBUS_ADDRESS"] = live_candidates[0][1]
    return env


def _run(argv: list[str], env: dict[str, str], timeout: float = 5.0) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(
            argv,
            env=env,
            capture_output=True,
            text=True,
            timeout=timeout,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return subprocess.CompletedProcess(argv, 127, "", str(exc))


def ensure_vielotus_config(home_dir: Path) -> None:
    cfg_dir = home_dir / ".config" / "vielotus"
    cfg_dir.mkdir(parents=True, exist_ok=True)
    cfg_file = cfg_dir / "config.env"
    if not cfg_file.is_file():
        cfg_file.write_text(DEFAULT_VIELOTUS_CONF, encoding="utf-8")


@contextmanager
def _single_instance_lock() -> Iterator[bool]:
    runtime_dir = Path(os.environ.get("XDG_RUNTIME_DIR", tempfile.gettempdir()))
    runtime_dir.mkdir(parents=True, exist_ok=True)
    lock_path = runtime_dir / f"nido-ensure-ime-{os.getuid()}.lock"
    fd = os.open(lock_path, os.O_CREAT | os.O_RDWR, 0o600)
    acquired = False
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            acquired = True
        except OSError:
            acquired = False
        yield acquired
    finally:
        if acquired:
            try:
                fcntl.flock(fd, fcntl.LOCK_UN)
            except OSError:
                pass
        os.close(fd)


def _ibus_has_both(ibus_bin: str, home_dir: Path, env: dict[str, str]) -> bool:
    cur_env = discover_ibus_env(home_dir, env)
    if "IBUS_ADDRESS" not in cur_env:
        return False
    res = _run([ibus_bin, "list-engine"], cur_env, timeout=4.0)
    if res.returncode != 0:
        return False
    engines = {ln.strip().split()[0].rstrip(":") for ln in res.stdout.splitlines() if ln.strip()}
    return "vielotus" in engines and "vielotus-vni" in engines


def _poll_ibus_until(ibus_bin: str, home_dir: Path, env: dict[str, str], deadline: float) -> bool:
    while True:
        if _ibus_has_both(ibus_bin, home_dir, env):
            return True
        if time.monotonic() >= deadline:
            return False
        time.sleep(0.4)


def _ibus_daemon_running(env: dict[str, str]) -> bool:
    pgrep = shutil.which("pgrep")
    if pgrep:
        return _run([pgrep, "-x", "ibus-daemon"], env, timeout=2.0).returncode == 0
    return False


def _systemd_ibus_unit_exists(systemctl: str | None, env: dict[str, str]) -> bool:
    if not systemctl:
        return False
    res = _run([systemctl, "--user", "cat", IBus_SYSTEMD_UNIT], env, timeout=3.0)
    return res.returncode == 0


def refresh_ibus_registry_if_needed(
    home_dir: Path,
    env: dict[str, str],
    wait_seconds: float = 12.0,
) -> tuple[bool, bool]:
    """Wait passively for GNOME IBus, reloading cache/service at most once if needed.

    Returns ``(engines_visible, was_reloaded)``.
    """
    ibus_bin = shutil.which("ibus")
    if not ibus_bin:
        return False, False

    overall_deadline = time.monotonic() + max(0.0, wait_seconds)
    # 1. Wait passively for GNOME Shell's IBus startup before intervening
    passive_deadline = min(overall_deadline, time.monotonic() + min(6.0, max(0.5, wait_seconds * 0.5)))
    if _poll_ibus_until(ibus_bin, home_dir, env, passive_deadline):
        return True, False

    systemctl = shutil.which("systemctl")
    has_unit = _systemd_ibus_unit_exists(systemctl, env)
    reloaded = False

    # 2. Start the GNOME IBus systemd unit once if ibus-daemon isn't running yet
    if not _ibus_daemon_running(env) and has_unit and systemctl:
        _run([systemctl, "--user", "start", IBus_SYSTEMD_UNIT], env, timeout=5.0)
        start_deadline = min(overall_deadline, time.monotonic() + 3.0)
        if _poll_ibus_until(ibus_bin, home_dir, env, start_deadline):
            return True, True
        reloaded = True

    # 3. Single cache refresh + single clean reload only if daemon is up without vielotus engines
    cache_dir = home_dir / ".cache" / "ibus" / "bus"
    if cache_dir.is_dir():
        for reg_path in glob.glob(str(cache_dir / "registry*")):
            try:
                os.unlink(reg_path)
            except OSError:
                pass
    _run([ibus_bin, "write-cache"], discover_ibus_env(home_dir, env), timeout=4.0)

    if has_unit and systemctl:
        st = _run([systemctl, "--user", "is-active", "--quiet", IBus_SYSTEMD_UNIT], env, timeout=3.0)
        verb = "restart" if st.returncode == 0 else "start"
        _run([systemctl, "--user", verb, IBus_SYSTEMD_UNIT], env, timeout=5.0)
        reloaded = True
    else:
        _run([ibus_bin, "restart", "--type=direct"], discover_ibus_env(home_dir, env), timeout=4.0)
        reloaded = True

    post_deadline = min(overall_deadline, time.monotonic() + 4.0)
    return _poll_ibus_until(ibus_bin, home_dir, env, post_deadline), reloaded


def _write_diag_log(
    home_dir: Path,
    ibus_visible: bool,
    reloaded: bool,
    cleaned_xinputrc: bool,
    final_sources: list[tuple[str, str]],
    marker_written: bool,
) -> None:
    try:
        log_dir = home_dir / ".cache" / "ubuntu-nido"
        log_dir.mkdir(parents=True, exist_ok=True)
        ts = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
        line = (
            f"{ts} ibus_visible={ibus_visible} reloaded={reloaded} "
            f"cleaned_xinputrc={cleaned_xinputrc} marker_written={marker_written} "
            f"sources={format_gsettings_sources(final_sources)}\n"
        )
        (log_dir / "ime-sync.log").write_text(line, encoding="utf-8")
    except OSError:
        pass


def sync_gnome_input_sources(
    home_dir: Path,
    force: bool = False,
    wait_seconds: float = 12.0,
) -> bool:
    if not (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")):
        return False

    cfg_dir = home_dir / ".config" / "ubuntu-nido"
    marker = cfg_dir / "ime-telex-vni-ready"

    with _single_instance_lock() as acquired:
        if not acquired:
            return is_marker_current(marker)

        cleaned_xinputrc = cleanup_stale_xinputrc(home_dir)
        if is_marker_current(marker) and not force and not cleaned_xinputrc:
            return True

        gsettings = shutil.which("gsettings")
        if not gsettings:
            return False

        env = dict(os.environ)
        ensure_vielotus_config(home_dir)

        ibus_visible, was_reloaded = refresh_ibus_registry_if_needed(
            home_dir, env, wait_seconds=wait_seconds
        )

        cur_res = _run(
            [gsettings, "get", "org.gnome.desktop.input-sources", "sources"],
            env,
            timeout=4.0,
        )
        if cur_res.returncode != 0:
            _write_diag_log(home_dir, ibus_visible, was_reloaded, cleaned_xinputrc, [], False)
            return False

        existing = parse_gsettings_sources(cur_res.stdout)
        target_sources, target_mru = build_target_input_sources(existing)
        sources_str = format_gsettings_sources(target_sources)
        mru_str = format_gsettings_sources(target_mru)

        # Bounce GNOME Shell input-sources cleanly so IBusManager binds '🇻🇳 tex' / '🇻🇳 vni'
        _run([gsettings, "set", "org.gnome.desktop.input-sources", "show-all-sources", "true"], env, timeout=4.0)
        _run([gsettings, "set", "org.gnome.desktop.input-sources", "per-window", "false"], env, timeout=4.0)
        _run(
            [gsettings, "set", "org.gnome.desktop.input-sources", "sources", format_gsettings_sources([US_SOURCE])],
            env,
            timeout=4.0,
        )
        time.sleep(0.25)
        _run([gsettings, "set", "org.gnome.desktop.input-sources", "mru-sources", mru_str], env, timeout=4.0)
        _run([gsettings, "set", "org.gnome.desktop.input-sources", "sources", sources_str], env, timeout=4.0)
        time.sleep(0.25)
        _run([gsettings, "set", "org.gnome.desktop.input-sources", "mru-sources", mru_str], env, timeout=4.0)
        _run([gsettings, "set", "org.gnome.desktop.input-sources", "current", "uint32 0"], env, timeout=4.0)

        ibus_bin = shutil.which("ibus")
        if ibus_bin and ibus_visible:
            live_env = discover_ibus_env(home_dir, env)
            _run([ibus_bin, "engine", "vielotus"], live_env, timeout=4.0)

        # Wait briefly before final verification so racing startup writers are caught
        time.sleep(1.0)
        verify_res = _run(
            [gsettings, "get", "org.gnome.desktop.input-sources", "sources"],
            env,
            timeout=4.0,
        )
        final_sources = parse_gsettings_sources(verify_res.stdout)
        marker_written = False
        if ibus_visible and TELEX_SOURCE in final_sources and VNI_SOURCE in final_sources:
            cfg_dir.mkdir(parents=True, exist_ok=True)
            marker.write_text(MARKER_VALUE, encoding="utf-8")
            # Mark vendor vielotus-onboard complete too if somehow invoked manually
            vl_marker = home_dir / ".config" / "vielotus" / ".onboarded"
            vl_marker.parent.mkdir(parents=True, exist_ok=True)
            vl_marker.write_text("ubuntu-nido\n", encoding="utf-8")
            marker_written = True

        _write_diag_log(
            home_dir, ibus_visible, was_reloaded, cleaned_xinputrc, final_sources, marker_written
        )
        return marker_written


def run_self_test() -> int:
    # 1. Subiquity default English install -> adds Telex + VNI ahead of US
    s1, m1 = build_target_input_sources([("xkb", "us")])
    assert s1 == [("ibus", "vielotus"), ("ibus", "vielotus-vni"), ("xkb", "us")], s1
    assert m1 == [("ibus", "vielotus"), ("xkb", "us"), ("ibus", "vielotus-vni")], m1

    # 2. Subiquity Vietnamese keyboard selection -> replaces awkward ('xkb', 'vn') with clean US + Telex + VNI
    s2, _ = build_target_input_sources([("xkb", "vn")])
    assert s2 == [("ibus", "vielotus"), ("ibus", "vielotus-vni"), ("xkb", "us")], s2

    # 3. Empty / unset sources -> still sets Telex + VNI + US
    s3, _ = build_target_input_sources(parse_gsettings_sources("@a(ss) []"))
    assert s3 == [("ibus", "vielotus"), ("ibus", "vielotus-vni"), ("xkb", "us")], s3

    # 4. Preserves additional user keyboards (e.g. Japanese/French) while placing Telex + VNI first
    s4, _ = build_target_input_sources([("xkb", "us"), ("xkb", "jp"), ("ibus", "vielotus")])
    assert s4 == [("ibus", "vielotus"), ("ibus", "vielotus-vni"), ("xkb", "us"), ("xkb", "jp")], s4

    # 5. Formatting round-trip
    formatted = format_gsettings_sources(s4)
    assert parse_gsettings_sources(formatted) == s4, formatted

    # 6. Stale .xinputrc cleanup, live bus discovery, and versioned marker validation
    with tempfile.TemporaryDirectory() as td:
        tmp_home = Path(td)
        assert cleanup_stale_xinputrc(tmp_home) is False

        xr = tmp_home / ".xinputrc"
        xr.write_text("# im-config\nrun_im ibus\n", encoding="utf-8")
        assert cleanup_stale_xinputrc(tmp_home) is True and not xr.exists()

        xr.write_text("run_im ibus\nexport CUSTOM_IM=1\n", encoding="utf-8")
        assert cleanup_stale_xinputrc(tmp_home) is False and xr.is_file()

        bus_dir = tmp_home / ".config" / "ibus" / "bus"
        bus_dir.mkdir(parents=True, exist_ok=True)
        stale_bus = bus_dir / "abc-unix-wayland-0"
        live_other = bus_dir / "abc-unix-wayland-9"
        live_wayland = bus_dir / "abc-unix-wayland-1"
        stale_bus.write_text("IBUS_DAEMON_PID=99999\nIBUS_ADDRESS='unix:stale'\n", encoding="utf-8")
        live_wayland.write_text("IBUS_DAEMON_PID=1001\nIBUS_ADDRESS='unix:wl1'\n", encoding="utf-8")
        live_other.write_text("IBUS_DAEMON_PID=1002\nIBUS_ADDRESS='unix:wl9'\n", encoding="utf-8")
        os.utime(live_wayland, (1000, 1000))
        os.utime(live_other, (2000, 2000))
        os.utime(stale_bus, (3000, 3000))

        alive_pids = {1001, 1002}
        wl_env = discover_ibus_env(
            tmp_home,
            {"WAYLAND_DISPLAY": "wayland-1"},
            pid_alive_fn=lambda pid: pid in alive_pids,
        )
        assert wl_env.get("IBUS_ADDRESS") == "unix:wl1", wl_env

        fallback_env = discover_ibus_env(
            tmp_home,
            {"WAYLAND_DISPLAY": "wayland-7"},
            pid_alive_fn=lambda pid: pid in alive_pids,
        )
        assert fallback_env.get("IBUS_ADDRESS") == "unix:wl9", fallback_env

        marker = tmp_home / "ime-telex-vni-ready"
        assert is_marker_current(marker) is False
        marker.write_text("vielotus+vielotus-vni\n", encoding="utf-8")
        assert is_marker_current(marker) is False
        marker.write_text(MARKER_VALUE, encoding="utf-8")
        assert is_marker_current(marker) is True

    print("ensure-vietnamese-ime self-test passed.")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description="Pre-activate Sen Viet Telex & VNI in GNOME")
    parser.add_argument("--force", action="store_true", help="Re-apply even if marker exists")
    parser.add_argument("--wait", type=float, default=12.0, help="Max seconds to wait for IBus")
    parser.add_argument("--self-test", action="store_true", help="Run headless unit tests")
    args = parser.parse_args()

    if args.self_test:
        return run_self_test()

    home_dir = Path(os.environ.get("HOME", str(Path.home())))
    sync_gnome_input_sources(home_dir, force=args.force, wait_seconds=args.wait)
    return 0


if __name__ == "__main__":
    sys.exit(main())
