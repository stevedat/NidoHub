def _point_to_segment_dist(
    px: float,
    py: float,
    ax: float,
    ay: float,
    bx: float,
    by: float,
    _hypot: Any = None,
) -> float:
    if _hypot is None:
        from math import hypot as _hypot
    vx = bx - ax
    vy = by - ay
    wx = px - ax
    wy = py - ay
    seg_len2 = vx * vx + vy * vy
    if seg_len2 <= 1e-9:
        return float(_hypot(wx, wy))
    t = max(0.0, min(1.0, (wx * vx + wy * vy) / seg_len2))
    dx = px - (ax + t * vx)
    dy = py - (ay + t * vy)
    return float(_hypot(dx, dy))


def render_fallback_icon_pixmap(size: int = 22) -> bytes:
    """Render an antialiased ARGB32 (network byte order) monochrome cube fallback icon."""
    if size <= 0:
        raise ValueError("size must be positive")
    from math import hypot

    scale = size / 16.0
    outer_verts = [
        (8.0 * scale, 1.6 * scale),
        (13.8 * scale, 4.8 * scale),
        (13.8 * scale, 11.2 * scale),
        (8.0 * scale, 14.4 * scale),
        (2.2 * scale, 11.2 * scale),
        (2.2 * scale, 4.8 * scale),
    ]
    segments = [
        (outer_verts[i], outer_verts[(i + 1) % len(outer_verts)], 0.85 * scale)
        for i in range(len(outer_verts))
    ]
    center = (8.0 * scale, 8.1 * scale)
    segments.extend(
        [
            ((2.4 * scale, 5.0 * scale), center, 0.78 * scale),
            (center, (13.6 * scale, 5.0 * scale), 0.78 * scale),
            (center, (8.0 * scale, 14.2 * scale), 0.78 * scale),
        ]
    )

    out = bytearray(size * size * 4)
    # 3x3 supersampling keeps the diagonal cube lines crisp at small panel sizes
    offsets = ((0.17, 0.17), (0.50, 0.17), (0.83, 0.17),
               (0.17, 0.50), (0.50, 0.50), (0.83, 0.50),
               (0.17, 0.83), (0.50, 0.83), (0.83, 0.83))
    inv_n = 1.0 / len(offsets)
    feather = max(0.55, 0.45 * scale)
    idx = 0
    for y in range(size):
        for x in range(size):
            cov = 0.0
            for ox, oy in offsets:
                px = x + ox
                py = y + oy
                best = 0.0
                for (ax, ay), (bx, by), half_w in segments:
                    d = _point_to_segment_dist(px, py, ax, ay, bx, by, _hypot=hypot) - half_w
                    if d <= -feather:
                        best = 1.0
                        break
                    if d < feather:
                        val = (feather - d) / (2.0 * feather)
                        if val > best:
                            best = val
                cov += best
            alpha = max(0, min(255, int(round(cov * inv_n * 242))))
            # Premultiplied ARGB in big-endian byte order for org.kde.StatusNotifierItem
            rgb = int(round(alpha * 0.94))
            out[idx] = alpha
            out[idx + 1] = rgb
            out[idx + 2] = rgb
            out[idx + 3] = rgb
            idx += 4
    return bytes(out)


def probe_nidodrop_state(
    runtime_dir: Path | None = None,
    uid: int | None = None,
    timeout: float = 0.15,
) -> tuple[bool, str]:
    """Query active NidoDrop LAN station quickly without spawning a subprocess."""
    if runtime_dir is not None:
        base = runtime_dir
    else:
        xdg_rt = os.environ.get("XDG_RUNTIME_DIR")
        if xdg_rt:
            base = Path(xdg_rt)
        else:
            import tempfile

            base = Path(tempfile.gettempdir())
    real_uid = os.getuid() if uid is None else uid
    state_file = base / f"nidobox-drop-{real_uid}.json"
    if not state_file.is_file():
        return (False, "")
    import json
    import socket

    try:
        st = json.loads(state_file.read_text(encoding="utf-8"))
        port = int(st.get("controlPort", 0))
    except Exception:
        return (False, "")
    if port <= 0:
        return (False, "")

    try:
        with socket.create_connection(("127.0.0.1", port), timeout=timeout) as sock:
            sock.settimeout(timeout)
            sock.sendall(b'{"cmd":"snapshot"}\n')
            line = sock.makefile("r", encoding="utf-8").readline()
        if not line:
            return (False, "")
        resp = json.loads(line)
        if not resp.get("ok"):
            return (False, "")
        snap = resp.get("snapshot") or {}
        if not bool(snap.get("isRunning", True)):
            return (False, "")
        return (True, str(snap.get("baseUrl") or snap.get("url") or "").strip())
    except Exception:
        return (False, "")


def probe_nidokvm_state(
    runtime_dir: Path | None = None,
    uid: int | None = None,
    timeout: float = 0.15,
) -> tuple[bool, str, str]:
    """Query active NidoKVM LAN daemon quickly without spawning a subprocess."""
    if runtime_dir is not None:
        base = runtime_dir
    else:
        xdg_rt = os.environ.get("XDG_RUNTIME_DIR")
        if xdg_rt:
            base = Path(xdg_rt)
        else:
            import tempfile

            base = Path(tempfile.gettempdir())
    real_uid = os.getuid() if uid is None else uid
    state_file = base / f"nidobox-kvm-{real_uid}.json"
    if not state_file.is_file():
        return (False, "", "")
    import json
    import socket

    try:
        st = json.loads(state_file.read_text(encoding="utf-8"))
        port = int(st.get("controlPort", 0))
    except Exception:
        return (False, "", "")
    if port <= 0:
        return (False, "", "")

    try:
        with socket.create_connection(("127.0.0.1", port), timeout=timeout) as sock:
            sock.settimeout(timeout)
            sock.sendall(b'{"cmd":"snapshot"}\n')
            line = sock.makefile("r", encoding="utf-8").readline()
        if not line:
            return (False, "", "")
        resp = json.loads(line)
        if not resp.get("ok"):
            return (False, "", "")
        snap = resp.get("snapshot") or {}
        role = str(snap.get("role") or "off").strip().lower()
        if not bool(snap.get("isRunning", False)) or role == "off":
            return (False, "", "")
        peer = str(snap.get("peerName") or "").strip().replace("_", " ")
        return (True, role, peer)
    except Exception:
        return (False, "", "")


def stop_nidokvm(
    runtime_dir: Path | None = None,
    uid: int | None = None,
    timeout: float = 1.5,
) -> bool:
    """Stop active NidoKVM daemon over its loopback control socket."""
    if runtime_dir is not None:
        base = runtime_dir
    else:
        xdg_rt = os.environ.get("XDG_RUNTIME_DIR")
        if xdg_rt:
            base = Path(xdg_rt)
        else:
            import tempfile

            base = Path(tempfile.gettempdir())
    real_uid = os.getuid() if uid is None else uid
    state_file = base / f"nidobox-kvm-{real_uid}.json"
    if not state_file.is_file():
        return False
    import json
    import socket

    try:
        st = json.loads(state_file.read_text(encoding="utf-8"))
        port = int(st.get("controlPort", 0))
    except Exception:
        return False
    if port <= 0:
        return False
    try:
        with socket.create_connection(("127.0.0.1", port), timeout=timeout) as sock:
            sock.settimeout(timeout)
            sock.sendall(b'{"cmd":"stop"}\n')
            line = sock.makefile("r", encoding="utf-8").readline()
        if not line:
            return False
        return bool(json.loads(line).get("ok"))
    except Exception:
        return False


def resolve_tray_icon_name(active: bool, active_icon_path: Path | None = None) -> str:
    """Return active symbolic icon (with emerald dot) when NidoDrop LAN or NidoKVM is active."""
    if active:
        target = active_icon_path if active_icon_path is not None else ACTIVE_ICON_SVG
        if target.is_file():
            return ICON_NAME_ACTIVE
    return ICON_NAME_IDLE


def _copy_text_to_clipboard(text: str) -> bool:
    """Copy ``text`` to the Wayland or X11 clipboard using standard CLI tools."""
    payload = (text or "").strip()
    if not payload:
        return False
    import shutil
    import subprocess

    candidates: list[list[str]] = []
    if os.environ.get("WAYLAND_DISPLAY") and shutil.which("wl-copy"):
        candidates.append(["wl-copy"])
    if shutil.which("xclip"):
        candidates.append(["xclip", "-selection", "clipboard"])
    if shutil.which("xsel"):
        candidates.append(["xsel", "--clipboard", "--input"])
    if not candidates and shutil.which("wl-copy"):
        candidates.append(["wl-copy"])
    for cmd in candidates:
        try:
            res = subprocess.run(
                cmd,
                input=payload,
                text=True,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=3.0,
                check=False,
            )
            if res.returncode == 0:
                return True
        except Exception:
            continue
    return False


