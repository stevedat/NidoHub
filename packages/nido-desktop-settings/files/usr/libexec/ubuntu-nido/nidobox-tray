def _item_dbus_props(item: dict[str, Any], property_names: list[str] | None = None) -> dict[str, Any]:
    raw: dict[str, Any] = {}
    for k in ("type", "label", "icon-name", "visible", "enabled", "children-display"):
        if k in item:
            raw[k] = item[k]
    if not property_names:
        return raw
    wanted = set(property_names)
    return {k: v for k, v in raw.items() if k in wanted}


def get_layout_tree(
    items: list[dict[str, Any]],
    parent_id: int = 0,
    recursion_depth: int = -1,
    property_names: list[str] | None = None,
) -> tuple[int, dict[str, Any], list[tuple[int, dict[str, Any], list[Any]]]]:
    """Build pure-Python DBusMenu GetLayout tree for root or child item."""
    if parent_id != 0:
        target = next((it for it in items if int(it["id"]) == parent_id), None)
        if target is None:
            return (parent_id, {}, [])
        return (int(target["id"]), _item_dbus_props(target, property_names), [])

    root_props = _item_dbus_props({"children-display": "submenu"}, property_names)
    if recursion_depth == 0:
        return (0, root_props, [])
    children = [
        (int(it["id"]), _item_dbus_props(it, property_names), [])
        for it in items
    ]
    return (0, root_props, children)


def get_group_properties(
    items: list[dict[str, Any]],
    ids: list[int],
    property_names: list[str] | None = None,
) -> list[tuple[int, dict[str, Any]]]:
    """Return property bags for requested item IDs (all items if ids is empty)."""
    by_id = {int(it["id"]): it for it in items}
    target_ids = list(by_id.keys()) if not ids else [int(i) for i in ids]
    out: list[tuple[int, dict[str, Any]]] = []
    for item_id in target_ids:
        if item_id == 0:
            out.append((0, _item_dbus_props({"children-display": "submenu"}, property_names)))
        elif item_id in by_id:
            out.append((item_id, _item_dbus_props(by_id[item_id], property_names)))
    return out


def _find_binary(name: str, fixed_paths: tuple[str, ...]) -> str | None:
    for candidate in fixed_paths:
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return candidate
    import shutil

    return shutil.which(name)


def run_tray() -> int:
    """Start GLib D-Bus main loop and keep NidoBox resident on GNOME Top Bar."""
    if not os.environ.get("DISPLAY") and not os.environ.get("WAYLAND_DISPLAY"):
        return 0
    if not _find_binary("nidobox", ("/usr/bin/nidobox", "/usr/local/bin/nidobox")):
        return 0

    try:
        from gi.repository import Gio, GLib
    except Exception as exc:
        print(f"nidobox-tray: GLib/Gio unavailable: {exc}", file=sys.stderr)
        return 0

    sni_info = Gio.DBusNodeInfo.new_for_xml(SNI_XML)
    menu_info = Gio.DBusNodeInfo.new_for_xml(DBUSMENU_XML)
    icon_pixmap_cache: list[bytes | None] = [None]

    def _get_icon_pixmap() -> bytes:
        if icon_pixmap_cache[0] is None:
            icon_pixmap_cache[0] = render_fallback_icon_pixmap(22)
        return icon_pixmap_cache[0]

    loop = GLib.MainLoop()
    state: dict[str, Any] = {
        "conn": None,
        "revision": 1,
        "drop_running": False,
        "drop_url": "",
        "kvm_running": False,
        "kvm_role": "",
        "kvm_peer": "",
        "items": build_menu_items(False, ""),
        "activation_token": "",
        "sni_reg_id": 0,
        "menu_reg_id": 0,
        "watcher_watch_id": 0,
        "owner_id": 0,
    }

    def _to_variant(val: Any) -> Any:
        if isinstance(val, bool):
            return GLib.Variant("b", val)
        if isinstance(val, int):
            return GLib.Variant("i", val)
        return GLib.Variant("s", str(val))

    def _props_to_variant_dict(props: dict[str, Any]) -> dict[str, Any]:
        return {k: _to_variant(v) for k, v in props.items()}

    def _layout_node_to_tuple(
        node: tuple[int, dict[str, Any], list[Any]],
    ) -> tuple[int, dict[str, Any], list[Any]]:
        nid, props, children = node
        encoded_children = [
            GLib.Variant("(ia{sv}av)", _layout_node_to_tuple(child))
            for child in children
        ]
        return (nid, _props_to_variant_dict(props), encoded_children)

    def _emit_icon_updated() -> None:
        conn = state["conn"]
        if conn is None:
            return
        try:
            conn.emit_signal(
                None,
                SNI_PATH,
                "org.kde.StatusNotifierItem",
                "NewIcon",
                None,
            )
        except Exception:
            pass

    def _refresh_items() -> bool:
        running, url = probe_nidodrop_state()
        kvm_running, kvm_role, kvm_peer = probe_nidokvm_state()
        prev_active = bool(state["drop_running"] or state["kvm_running"])
        now_active = bool(running or kvm_running)
        changed = (
            (running != bool(state["drop_running"]))
            or (url != state["drop_url"])
            or (kvm_running != bool(state["kvm_running"]))
            or (kvm_role != state["kvm_role"])
            or (kvm_peer != state["kvm_peer"])
        )
        if changed:
            state["drop_running"] = running
            state["drop_url"] = url
            state["kvm_running"] = kvm_running
            state["kvm_role"] = kvm_role
            state["kvm_peer"] = kvm_peer
            state["items"] = build_menu_items(running, url, kvm_running, kvm_role, kvm_peer)
            state["revision"] += 1
            if now_active != prev_active:
                _emit_icon_updated()
        return changed

    def _emit_layout_updated() -> None:
        conn = state["conn"]
        if conn is None:
            return
        try:
            conn.emit_signal(
                None,
                MENU_PATH,
                "com.canonical.dbusmenu",
                "LayoutUpdated",
                GLib.Variant("(ui)", (int(state["revision"]), 0)),
            )
        except Exception:
            pass

    def _spawn_gui(argv: list[str]) -> None:
        env = dict(os.environ)
        token = str(state.get("activation_token") or "").strip()
        if token:
            env["XDG_ACTIVATION_TOKEN"] = token
            state["activation_token"] = ""
        try:
            envp = [f"{k}={v}" for k, v in env.items()]
            flags = (
                GLib.SpawnFlags.SEARCH_PATH
                | GLib.SpawnFlags.STDOUT_TO_DEV_NULL
                | GLib.SpawnFlags.STDERR_TO_DEV_NULL
            )
            GLib.spawn_async(None, argv, envp, flags, None, None)
            return
        except Exception:
            pass
        import subprocess
        import threading

        try:
            proc = subprocess.Popen(
                argv,
                env=env,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
            threading.Thread(target=proc.wait, daemon=True).start()
        except Exception:
            pass

    def _send_notification_blocking(summary: str, body: str) -> None:
        import shutil
        import subprocess

        ns = shutil.which("notify-send")
        if not ns:
            return
        try:
            subprocess.run(
                [ns, "-i", "nidobox-symbolic", summary, body],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=3.0,
                check=False,
            )
        except Exception:
            pass

    def _dispatch_action(item_id: int) -> bool:
        target = next((it for it in state["items"] if int(it["id"]) == item_id), None)
        if target is None or not target.get("enabled", True):
            return False
        action = target.get("action")
        if action == "capture":
            nb = _find_binary("nidobox", ("/usr/bin/nidobox", "/usr/local/bin/nidobox"))
            if nb:
                _spawn_gui([nb, "--capture"])
            return True
        if action == "open_nidobox":
            nb = _find_binary("nidobox", ("/usr/bin/nidobox", "/usr/local/bin/nidobox"))
            if nb:
                _spawn_gui([nb])
            return True
        if action == "open_nidohub":
            nh = _find_binary("nido-hub", ("/usr/bin/nido-hub", "/usr/local/bin/nido-hub"))
            if nh:
                _spawn_gui([nh, "--page", "settings"])
            return True
        if action == "copy_drop_url":
            drop_url = str(state.get("drop_url") or "").strip()
            if drop_url:
                import threading

                def copy_worker() -> None:
                    copied = _copy_text_to_clipboard(drop_url)
                    if copied:
                        _send_notification_blocking("NidoBox", f"Đã chép liên kết LAN: {drop_url}")

                threading.Thread(target=copy_worker, daemon=True).start()
            return True
        if action == "stop_drop":
            nb = _find_binary("nidobox", ("/usr/bin/nidobox", "/usr/local/bin/nidobox"))
            if nb:
                import subprocess
                import threading

                def worker() -> None:
                    ok_stop = False
                    try:
                        res = subprocess.run(
                            [nb, "drop", "stop", "--json"],
                            capture_output=True,
                            text=True,
                            timeout=6.0,
                            check=False,
                        )
                        ok_stop = res.returncode == 0
                    except Exception:
                        ok_stop = False
                    if ok_stop:
                        _send_notification_blocking("NidoBox", "Đã dừng chia sẻ tệp qua mạng LAN.")

                    def after_stop() -> bool:
                        if _refresh_items():
                            _emit_layout_updated()
                        return False

                    GLib.idle_add(after_stop)

                threading.Thread(target=worker, daemon=True).start()
            return True
        if action == "stop_kvm":
            import threading

            def kvm_worker() -> None:
                ok_stop = stop_nidokvm()
                if ok_stop:
                    _send_notification_blocking("NidoBox", "Đã dừng chia sẻ chuột & phím NidoKVM.")

                def after_kvm_stop() -> bool:
                    if _refresh_items():
                        _emit_layout_updated()
                    return False

                GLib.idle_add(after_kvm_stop)

            threading.Thread(target=kvm_worker, daemon=True).start()
            return True
        if action == "quit":
            loop.quit()
            return True
        return False

    def _sni_get_property(_conn: Any, _sender: str, _obj: str, _iface: str, prop: str) -> Any:
        if prop == "Category":
            return GLib.Variant("s", "ApplicationStatus")
        if prop == "Id":
            return GLib.Variant("s", "nidobox-tray")
        if prop == "Title":
            return GLib.Variant("s", "NidoBox")
        if prop == "Status":
            return GLib.Variant("s", "Active")
        if prop == "WindowId":
            return GLib.Variant("i", 0)
        if prop == "IconThemePath":
            return GLib.Variant("s", SNI_ICON_THEME_PATH)
        if prop == "Menu":
            return GLib.Variant("o", MENU_PATH)
        if prop == "ItemIsMenu":
            return GLib.Variant("b", True)
        if prop == "IconName":
            return GLib.Variant("s", resolve_tray_icon_name(bool(state["drop_running"] or state["kvm_running"])))
        if prop == "IconPixmap":
            return GLib.Variant("a(iiay)", [(22, 22, _get_icon_pixmap())])
        if prop in ("OverlayIconName", "AttentionIconName", "AttentionMovieName"):
            return GLib.Variant("s", "")
        if prop in ("OverlayIconPixmap", "AttentionIconPixmap"):
            return GLib.Variant("a(iiay)", [])
        if prop == "ToolTip":
            cur_icon = resolve_tray_icon_name(bool(state["drop_running"] or state["kvm_running"]))
            return GLib.Variant(
                "(sa(iiay)ss)",
                (cur_icon, [], "NidoBox", "Chụp màn hình OCR & tiện ích NidoOS"),
            )
        return None

    def _sni_method_call(
        _conn: Any,
        _sender: str,
        _obj: str,
        _iface: str,
        method: str,
        params: Any,
        invocation: Any,
    ) -> None:
        args = params.unpack() if params is not None else ()
        if method == "ProvideXdgActivationToken" and args:
            state["activation_token"] = str(args[0])
            invocation.return_value(None)
            return
        if method in ("SecondaryActivate", "XAyatanaSecondaryActivate"):
            nb = _find_binary("nidobox", ("/usr/bin/nidobox", "/usr/local/bin/nidobox"))
            if nb:
                _spawn_gui([nb, "--capture"])
            invocation.return_value(None)
            return
        if method in ("ContextMenu", "Scroll"):
            invocation.return_value(None)
            return
        invocation.return_value(None)

    def _menu_get_property(_conn: Any, _sender: str, _obj: str, _iface: str, prop: str) -> Any:
        if prop == "Version":
            return GLib.Variant("u", 3)
        if prop == "TextDirection":
            return GLib.Variant("s", "ltr")
        if prop == "Status":
            return GLib.Variant("s", "normal")
        if prop == "IconThemePath":
            return GLib.Variant("as", DBUSMENU_ICON_THEME_PATHS)
        return None

    def _menu_method_call(
        _conn: Any,
        _sender: str,
        _obj: str,
        _iface: str,
        method: str,
        params: Any,
        invocation: Any,
    ) -> None:
        args = params.unpack() if params is not None else ()
        if method == "GetLayout":
            parent_id = int(args[0]) if len(args) > 0 else 0
            depth = int(args[1]) if len(args) > 1 else -1
            prop_names = list(args[2]) if len(args) > 2 else []
            if parent_id == 0:
                _refresh_items()
            tree = get_layout_tree(state["items"], parent_id=parent_id, recursion_depth=depth, property_names=prop_names)
            invocation.return_value(
                GLib.Variant("(u(ia{sv}av))", (int(state["revision"]), _layout_node_to_tuple(tree)))
            )
            return
        if method == "GetGroupProperties":
            ids = [int(i) for i in (args[0] if len(args) > 0 else [])]
            prop_names = list(args[1]) if len(args) > 1 else []
            groups = get_group_properties(state["items"], ids, prop_names)
            encoded = [(gid, _props_to_variant_dict(props)) for gid, props in groups]
            invocation.return_value(GLib.Variant("(a(ia{sv}))", (encoded,)))
            return
        if method == "GetProperty":
            item_id = int(args[0]) if len(args) > 0 else -1
            name = str(args[1]) if len(args) > 1 else ""
            groups = get_group_properties(state["items"], [item_id], [name])
            if groups and name in groups[0][1]:
                invocation.return_value(GLib.Variant("(v)", (_to_variant(groups[0][1][name]),)))
            else:
                invocation.return_dbus_error("org.freedesktop.DBus.Error.InvalidArgs", f"Unknown property: {item_id}.{name}")
            return
        if method == "AboutToShow":
            item_id = int(args[0]) if args else 0
            changed = _refresh_items() if item_id == 0 else False
            if changed:
                _emit_layout_updated()
            invocation.return_value(GLib.Variant("(b)", (changed,)))
            return
        if method == "AboutToShowGroup":
            ids = [int(i) for i in (args[0] if args else [])]
            changed = _refresh_items() if (not ids or 0 in ids) else False
            if changed:
                _emit_layout_updated()
            updates = [0] if changed else []
            invocation.return_value(GLib.Variant("(aiai)", (updates, [])))
            return
        if method == "Event":
            item_id = int(args[0]) if len(args) > 0 else -1
            event_id = str(args[1]) if len(args) > 1 else ""
            if event_id == "clicked":
                _dispatch_action(item_id)
            invocation.return_value(None)
            return
        if method == "EventGroup":
            events = args[0] if args else []
            err_ids: list[int] = []
            for ev in events:
                ev_id_num = int(ev[0])
                ev_kind = str(ev[1])
                if ev_kind == "clicked" and not _dispatch_action(ev_id_num):
                    err_ids.append(ev_id_num)
            invocation.return_value(GLib.Variant("(ai)", (err_ids,)))
            return
        invocation.return_value(None)

    def _register_with_watcher(conn: Any) -> None:
        conn.call(
            WATCHER_BUS,
            WATCHER_PATH,
            WATCHER_IFACE,
            "RegisterStatusNotifierItem",
            GLib.Variant("(s)", (SNI_PATH,)),
            None,
            Gio.DBusCallFlags.NONE,
            -1,
            None,
            None,
        )

    def _on_bus_acquired(conn: Any, _name: str) -> None:
        state["conn"] = conn
        state["sni_reg_id"] = conn.register_object(
            SNI_PATH,
            sni_info.interfaces[0],
            _sni_method_call,
            _sni_get_property,
            None,
        )
        state["menu_reg_id"] = conn.register_object(
            MENU_PATH,
            menu_info.interfaces[0],
            _menu_method_call,
            _menu_get_property,
            None,
        )
        state["watcher_watch_id"] = Gio.bus_watch_name_on_connection(
            conn,
            WATCHER_BUS,
            Gio.BusNameWatcherFlags.NONE,
            lambda c, _wname, _owner: _register_with_watcher(c),
            None,
        )

    def _on_name_lost(_conn: Any, _name: str) -> None:
        loop.quit()

    state["owner_id"] = Gio.bus_own_name(
        Gio.BusType.SESSION,
        BUS_NAME,
        Gio.BusNameOwnerFlags.NONE,
        _on_bus_acquired,
        None,
        _on_name_lost,
    )

    if hasattr(GLib, "unix_signal_add"):
        for sig in (signal.SIGINT, signal.SIGTERM):
            GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, sig, lambda _s=None: (loop.quit(), False)[1])

    try:
        loop.run()
    finally:
        if state["watcher_watch_id"]:
            Gio.bus_unwatch_name(state["watcher_watch_id"])
        conn = state["conn"]
        if conn is not None:
            for reg_key in ("sni_reg_id", "menu_reg_id"):
                if state[reg_key]:
                    try:
                        conn.unregister_object(state[reg_key])
                    except Exception:
                        pass
        if state["owner_id"]:
            Gio.bus_unown_name(state["owner_id"])
    return 0


def run_self_test() -> int:
    """Run headless validation of D-Bus schemas, menu structure, pixmap, and NidoDrop probe."""
    # Verify heavy stdlib modules remain unloaded on startup (keeps resident tray RSS minimal).
    # Note: `threading` and `math` may be pre-imported by Python 3.12 stdlib (`typing`/`pathlib`)
    # or Ubuntu sitecustomize hooks, so verify they are not bound at top-level in our module namespace.
    if __name__ == "__main__":
        for deferred_mod in ("xml.etree.ElementTree", "socket", "subprocess", "tempfile", "shutil", "json"):
            assert deferred_mod not in sys.modules, f"{deferred_mod} should be lazily imported in nidobox-tray"
        for top_mod in ("threading", "math", "socket", "subprocess", "tempfile", "shutil", "json"):
            assert top_mod not in globals(), f"{top_mod} should not be imported at top-level in nidobox-tray"

    import json
    import socket
    import tempfile
    import threading
    import xml.etree.ElementTree as ET

    sni_root = ET.fromstring(SNI_XML)
    sni_iface = sni_root.find("interface")
    assert sni_iface is not None and sni_iface.attrib.get("name") == "org.kde.StatusNotifierItem"
    sni_methods = {m.attrib["name"] for m in sni_iface.findall("method")}
    sni_props = {p.attrib["name"] for p in sni_iface.findall("property")}
    assert "Activate" not in sni_methods, "Activate must be omitted for instant single-click menu"
    assert {"SecondaryActivate", "XAyatanaSecondaryActivate", "ProvideXdgActivationToken"} <= sni_methods
    assert {"ItemIsMenu", "IconName", "IconThemePath", "IconPixmap", "Menu", "ToolTip"} <= sni_props
    assert SNI_ICON_THEME_PATH == "", "SNI IconThemePath must be empty so GNOME searches /usr/share/icons/hicolor"
    assert "/usr/share/icons/hicolor" not in DBUSMENU_ICON_THEME_PATHS, DBUSMENU_ICON_THEME_PATHS

    menu_root = ET.fromstring(DBUSMENU_XML)
    menu_iface = menu_root.find("interface")
    assert menu_iface is not None and menu_iface.attrib.get("name") == "com.canonical.dbusmenu"
    menu_methods = {m.attrib["name"] for m in menu_iface.findall("method")}
    assert {"GetLayout", "GetGroupProperties", "GetProperty", "Event", "EventGroup", "AboutToShow", "AboutToShowGroup"} <= menu_methods

    try:
        from gi.repository import Gio
        assert Gio.DBusNodeInfo.new_for_xml(SNI_XML).interfaces
        assert Gio.DBusNodeInfo.new_for_xml(DBUSMENU_XML).interfaces
    except ImportError:
        pass

    idle_items = build_menu_items(False, "")
    idle_ids = [it["id"] for it in idle_items]
    assert idle_ids == [1, 2, 10, 11, 12, 20, 21], idle_ids
    assert 3 not in idle_ids and 4 not in idle_ids

    active_no_url = build_menu_items(True, "")
    assert [it["id"] for it in active_no_url] == [1, 2, 3, 10, 11, 12, 20, 21]

    active_items = build_menu_items(True, "http://192.168.1.50:8765")
    active_ids = [it["id"] for it in active_items]
    assert active_ids == [1, 2, 4, 3, 10, 11, 12, 20, 21], active_ids
    assert any(it["id"] == 4 and it["label"] == "Chép liên kết LAN" for it in active_items)
    assert any(it["id"] == 3 and it["label"] == "Dừng chia sẻ LAN" for it in active_items)
    for it in active_items:
        lbl = str(it.get("label") or "")
        assert "_" not in lbl, f"Menu label must not contain underscore mnemonic: {lbl}"

    root_id, root_props, children = get_layout_tree(active_items, 0, -1, ["type", "children-display"])
    assert root_id == 0 and root_props == {"children-display": "submenu"}
    assert len(children) == len(active_items)
    assert children[4][1] == {"type": "separator"}

    with tempfile.TemporaryDirectory() as icon_td:
        fake_svg = Path(icon_td) / "com.nidoholdings.NidoBox-active-symbolic.svg"
        assert resolve_tray_icon_name(False, active_icon_path=fake_svg) == ICON_NAME_IDLE
        assert resolve_tray_icon_name(True, active_icon_path=fake_svg) == ICON_NAME_IDLE
        fake_svg.write_text("<svg/>", encoding="utf-8")
        assert resolve_tray_icon_name(True, active_icon_path=fake_svg) == ICON_NAME_ACTIVE

    all_groups = get_group_properties(active_items, [1, 3], [])
    assert len(all_groups) == 2
    assert all_groups[0][1]["label"] == "Chụp màn hình & Đọc chữ (OCR)"
    assert all_groups[0][1]["icon-name"] == "camera-photo-symbolic"
    assert get_group_properties(active_items, [], ["label"])[0][0] == 1

    pix = render_fallback_icon_pixmap(22)
    assert len(pix) == 22 * 22 * 4 == 1936
    assert any(pix[i] > 180 for i in range(0, len(pix), 4)), "Fallback pixmap has no opaque pixels"

    with tempfile.TemporaryDirectory() as td:
        rdir = Path(td)
        assert probe_nidodrop_state(runtime_dir=rdir, uid=1000) == (False, "")

        srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        srv.bind(("127.0.0.1", 0))
        srv.listen(1)
        port = srv.getsockname()[1]

        def serve_once() -> None:
            conn, _ = srv.accept()
            with conn:
                conn.recv(256)
                payload = json.dumps({"ok": True, "snapshot": {"isRunning": True, "baseUrl": "http://127.0.0.1:8765"}})
                conn.sendall((payload + "\n").encode("utf-8"))

        t = threading.Thread(target=serve_once, daemon=True)
        t.start()
        (rdir / "nidobox-drop-1000.json").write_text(json.dumps({"controlPort": port}), encoding="utf-8")
        try:
            running, url = probe_nidodrop_state(runtime_dir=rdir, uid=1000, timeout=1.0)
            assert running is True and url == "http://127.0.0.1:8765", (running, url)
        finally:
            t.join(timeout=2.0)
            srv.close()

        # Verify NidoKVM probe, menu integration, and stop control
        assert probe_nidokvm_state(runtime_dir=rdir, uid=1000) == (False, "", "")
        kvm_srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        kvm_srv.bind(("127.0.0.1", 0))
        kvm_srv.listen(2)
        kvm_port = kvm_srv.getsockname()[1]

        def serve_kvm() -> None:
            for _ in range(2):
                conn, _ = kvm_srv.accept()
                with conn:
                    req = conn.recv(256).decode("utf-8", errors="replace")
                    if '"stop"' in req:
                        payload = json.dumps({"ok": True, "snapshot": {"role": "off", "isRunning": False}})
                    else:
                        payload = json.dumps(
                            {"ok": True, "snapshot": {"role": "host", "isRunning": True, "peerName": "MacBook_Pro"}}
                        )
                    conn.sendall((payload + "\n").encode("utf-8"))

        kt = threading.Thread(target=serve_kvm, daemon=True)
        kt.start()
        (rdir / "nidobox-kvm-1000.json").write_text(json.dumps({"controlPort": kvm_port}), encoding="utf-8")
        try:
            k_run, k_role, k_peer = probe_nidokvm_state(runtime_dir=rdir, uid=1000, timeout=1.0)
            assert (k_run, k_role, k_peer) == (True, "host", "MacBook Pro"), (k_run, k_role, k_peer)
            kvm_items = build_menu_items(False, "", k_run, k_role, k_peer)
            assert [it["id"] for it in kvm_items] == [1, 2, 5, 10, 11, 12, 20, 21]
            assert any(it["id"] == 5 and "MacBook Pro" in it["label"] and "_" not in it["label"] for it in kvm_items)
            assert stop_nidokvm(runtime_dir=rdir, uid=1000, timeout=1.0) is True
        finally:
            kt.join(timeout=2.0)
            kvm_srv.close()

    print("nidobox-tray self-test passed.")
    return 0


def main(argv: list[str] | None = None) -> int:
    args = sys.argv[1:] if argv is None else argv
    if "--self-test" in args:
        return run_self_test()
    return run_tray()


if __name__ == "__main__":
    raise SystemExit(main())
