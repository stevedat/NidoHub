#!/usr/bin/env bash
# Bind-mount full-Vietnamese static Noto Sans TTFs over ubuntu-desktop-bootstrap's
# bundled Ubuntu-*.ttf Flutter assets during Live ISO boot so Vietnamese diacritics
# (including dot-below U+0323 / hook-above U+0309 like 'ọ', 'ệ', 'ả', 'ử') render
# cleanly without tofu boxes while preserving Greek, Cyrillic, and Latin glyphs.
# Also prunes unwanted snap desktop clutter (Thunderbird, Ubuntu App Center,
# Security Center, duplicate Firefox Snap) from the Live session before GDM starts.
set -euo pipefail

FONT_ROOT="${NIDO_FONT_ROOT:-/usr/share/fonts}"
SNAP_ROOT="${NIDO_SNAP_ROOT:-/snap/ubuntu-desktop-bootstrap}"
SNAP_DESKTOP_DIR="${NIDO_SNAP_DESKTOP_DIR:-/var/lib/snapd/desktop/applications}"
BUNDLE_DIR="${NIDO_INSTALLER_BUNDLE_DIR:-/usr/libexec/nido-installer/bundle}"
PATCHED_DESKTOP_TMP="${NIDO_PATCHED_DESKTOP_TMP:-/run/nidoos-installer.desktop}"
DRY_RUN=0

find_first_font() {
  local candidate
  for candidate in "$@"; do
    if [[ -f "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

resolve_font_for_target() {
  local target_name="$1"
  local noto="${FONT_ROOT}/truetype/noto"
  local liberation="${FONT_ROOT}/truetype/liberation"
  local dejavu="${FONT_ROOT}/truetype/dejavu"
  local beviet="${FONT_ROOT}/truetype/be-vietnam-pro"

  case "$target_name" in
    Ubuntu-R.ttf|Ubuntu-L.ttf|UbuntuSans-Regular.ttf|UbuntuSans-Light.ttf)
      find_first_font \
        "${noto}/NotoSans-Regular.ttf" \
        "${dejavu}/DejaVuSans.ttf" \
        "${beviet}/BeVietnamPro-Regular.ttf"
      ;;
    Ubuntu-M.ttf|UbuntuSans-Medium.ttf)
      find_first_font \
        "${noto}/NotoSans-Medium.ttf" \
        "${noto}/NotoSans-Regular.ttf" \
        "${dejavu}/DejaVuSans.ttf" \
        "${beviet}/BeVietnamPro-Medium.ttf"
      ;;
    Ubuntu-B.ttf|UbuntuSans-Bold.ttf)
      find_first_font \
        "${noto}/NotoSans-Bold.ttf" \
        "${dejavu}/DejaVuSans-Bold.ttf" \
        "${beviet}/BeVietnamPro-Bold.ttf" \
        "${noto}/NotoSans-Regular.ttf"
      ;;
    Ubuntu-RI.ttf|Ubuntu-LI.ttf|Ubuntu-MI.ttf|UbuntuSans-Italic.ttf|UbuntuSans-LightItalic.ttf|UbuntuSans-MediumItalic.ttf)
      find_first_font \
        "${noto}/NotoSans-Italic.ttf" \
        "${dejavu}/DejaVuSans-Oblique.ttf" \
        "${noto}/NotoSans-Regular.ttf" \
        "${beviet}/BeVietnamPro-Italic.ttf"
      ;;
    Ubuntu-BI.ttf|UbuntuSans-BoldItalic.ttf)
      find_first_font \
        "${noto}/NotoSans-BoldItalic.ttf" \
        "${dejavu}/DejaVuSans-BoldOblique.ttf" \
        "${noto}/NotoSans-Bold.ttf" \
        "${noto}/NotoSans-Regular.ttf"
      ;;
    UbuntuMono*.ttf|UbuntuSansMono*.ttf)
      # Prefer full-Vietnamese (134/134 precomposed glyphs) monospace static TTFs.
      # Ubuntu's fonts-noto-mono ships NotoMono-Regular.ttf (not NotoSansMono-Regular.ttf);
      # never prefer DejaVuSansMono.ttf which omits 40 Vietnamese precomposed glyphs.
      find_first_font \
        "${noto}/NotoMono-Regular.ttf" \
        "${noto}/NotoSansMono-Regular.ttf" \
        "${liberation}/LiberationMono-Regular.ttf" \
        "${noto}/NotoSans-Regular.ttf"
      ;;
    *)
      return 1
      ;;
  esac
}

wait_for_snap_fonts() {
  [[ "$DRY_RUN" -eq 1 ]] && return 0
  local _
  for _ in $(seq 1 40); do
    if compgen -G "${SNAP_ROOT}/*/bin/data/flutter_assets/packages/yaru/assets/fonts/Ubuntu-R.ttf" >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.25
  done
  return 0
}

rewrite_installer_desktop_file() {
  local target_file="$1"
  [[ -f "$target_file" ]] || return 0
  local tmp_file
  tmp_file="$(mktemp "${target_file}.tmp.XXXXXX")" || return 0
  local line wrote_name=0 wrote_comment=0 wrote_icon=0
  while IFS= read -r line || [[ -n "$line" ]]; do
    case "$line" in
      Name\[vi\]=*|Comment\[vi\]=*)
        continue
        ;;
      Name=*)
        if [[ "$wrote_name" -eq 0 ]]; then
          printf 'Name=Cài đặt NidoOS\nName[vi]=Cài đặt NidoOS\n'
          wrote_name=1
        fi
        ;;
      Comment=*)
        if [[ "$wrote_comment" -eq 0 ]]; then
          printf 'Comment=Cài đặt NidoOS lên máy tính của bạn\nComment[vi]=Cài đặt NidoOS lên máy tính của bạn\n'
          wrote_comment=1
        fi
        ;;
      Icon=*)
        if [[ "$wrote_icon" -eq 0 ]]; then
          printf 'Icon=nidoos-logo\n'
          wrote_icon=1
        fi
        ;;
      *)
        printf '%s\n' "$line"
        ;;
    esac
  done < "$target_file" > "$tmp_file"
  [[ "$wrote_name" -eq 0 ]] && printf 'Name=Cài đặt NidoOS\nName[vi]=Cài đặt NidoOS\n' >> "$tmp_file"
  [[ "$wrote_icon" -eq 0 ]] && printf 'Icon=nidoos-logo\n' >> "$tmp_file"
  cat "$tmp_file" > "$target_file" 2>/dev/null || true
  rm -f "$tmp_file"
}

brand_live_installer_launchers() {
  local desktop_file
  if [[ -d "$SNAP_DESKTOP_DIR" ]]; then
    shopt -s nullglob
    for desktop_file in "${SNAP_DESKTOP_DIR}"/ubuntu-desktop-bootstrap*.desktop; do
      [[ -f "$desktop_file" ]] || continue
      if [[ "$DRY_RUN" -eq 1 ]]; then
        printf 'BRAND_DESKTOP:%s\n' "$desktop_file"
      else
        rewrite_installer_desktop_file "$desktop_file"
      fi
    done
    shopt -u nullglob
  fi

  local rev_dir snap_desktop
  if [[ -d "$SNAP_ROOT" ]]; then
    shopt -s nullglob
    for rev_dir in "${SNAP_ROOT}"/*; do
      [[ -L "$rev_dir" ]] && continue
      [[ -d "$rev_dir" ]] || continue
      snap_desktop="${rev_dir}/usr/share/applications/ubuntu-desktop-bootstrap.desktop"
      [[ -f "$snap_desktop" ]] || continue
      if [[ "$DRY_RUN" -eq 1 ]]; then
        printf 'BIND_DESKTOP:%s -> %s\n' "$PATCHED_DESKTOP_TMP" "$snap_desktop"
      else
        cp -f "$snap_desktop" "$PATCHED_DESKTOP_TMP"
        rewrite_installer_desktop_file "$PATCHED_DESKTOP_TMP"
        chmod 0644 "$PATCHED_DESKTOP_TMP" 2>/dev/null || true
        if ! (command -v mountpoint >/dev/null 2>&1 && mountpoint -q "$snap_desktop" 2>/dev/null); then
          mount --bind "$PATCHED_DESKTOP_TMP" "$snap_desktop" 2>/dev/null || true
        fi
      fi
    done
    shopt -u nullglob
  fi
}

clean_live_snap_launchers() {
  brand_live_installer_launchers
  [[ "$DRY_RUN" -eq 1 ]] && return 0
  [[ -d "$SNAP_DESKTOP_DIR" ]] || return 0
  rm -f \
    "${SNAP_DESKTOP_DIR}"/thunderbird_*.desktop \
    "${SNAP_DESKTOP_DIR}"/snap-store_*.desktop \
    "${SNAP_DESKTOP_DIR}"/desktop-security-center_*.desktop \
    "${SNAP_DESKTOP_DIR}"/firefox_*.desktop 2>/dev/null || true
}

run_self_test() {
  local td
  td="$(mktemp -d "${TMPDIR:-/tmp}/nido-bind-fonts.XXXXXX")"
  trap 'rm -rf "$td"' RETURN
  mkdir -p "${td}/fonts/truetype/noto" "${td}/fonts/truetype/dejavu" \
    "${td}/snap/590/bin/lib" "${td}/snap/590/bin/data/flutter_assets/packages/yaru/assets/fonts" \
    "${td}/snap/590/usr/share/applications" "${td}/snap-desktop" \
    "${td}/bundle/lib" "${td}/bundle/data/flutter_assets/packages/yaru/assets/fonts"
  printf '#!/bin/sh\n' > "${td}/snap/590/bin/ubuntu_bootstrap"
  printf '#!/bin/sh\n' > "${td}/bundle/ubuntu_bootstrap"
  chmod 755 "${td}/snap/590/bin/ubuntu_bootstrap" "${td}/bundle/ubuntu_bootstrap"
  printf 'AOT' > "${td}/bundle/lib/libapp.so"
  cat > "${td}/snap/590/usr/share/applications/ubuntu-desktop-bootstrap.desktop" <<'DESK'
[Desktop Entry]
Type=Application
Name=Install RELEASE
Comment=Install this system permanently to your hard disk
Exec=ubuntu-desktop-bootstrap
Icon=ubiquity
DESK
  cp "${td}/snap/590/usr/share/applications/ubuntu-desktop-bootstrap.desktop" \
    "${td}/snap-desktop/ubuntu-desktop-bootstrap_ubuntu-desktop-bootstrap.desktop"
  local f
  # Mirror real Ubuntu fonts-noto-core + fonts-noto-mono filenames (NotoMono-Regular.ttf)
  # plus DejaVuSansMono.ttf to prove UbuntuMono-Regular.ttf never falls back to DejaVuSansMono.
  for f in NotoSans-Regular.ttf NotoSans-Bold.ttf NotoSans-Italic.ttf NotoSans-BoldItalic.ttf NotoMono-Regular.ttf; do
    printf 'TTF' > "${td}/fonts/truetype/noto/${f}"
  done
  printf 'DJV' > "${td}/fonts/truetype/dejavu/DejaVuSansMono.ttf"
  for f in Ubuntu-L.ttf Ubuntu-LI.ttf Ubuntu-R.ttf Ubuntu-RI.ttf Ubuntu-M.ttf Ubuntu-MI.ttf Ubuntu-B.ttf Ubuntu-BI.ttf UbuntuMono-Regular.ttf; do
    printf 'UBU' > "${td}/snap/590/bin/data/flutter_assets/packages/yaru/assets/fonts/${f}"
  done
  FONT_ROOT="${td}/fonts"
  SNAP_ROOT="${td}/snap"
  SNAP_DESKTOP_DIR="${td}/snap-desktop"
  BUNDLE_DIR="${td}/bundle"
  PATCHED_DESKTOP_TMP="${td}/patched.desktop"
  DRY_RUN=1
  local count=0
  local bundle_count=0
  local brand_desktop_count=0
  local bind_desktop_count=0
  local mono_bound=""
  while IFS= read -r line; do
    if [[ "$line" == BIND_BUNDLE:* ]]; then
      bundle_count=$((bundle_count + 1))
    elif [[ "$line" == BRAND_DESKTOP:* ]]; then
      brand_desktop_count=$((brand_desktop_count + 1))
    elif [[ "$line" == BIND_DESKTOP:* ]]; then
      bind_desktop_count=$((bind_desktop_count + 1))
    elif [[ "$line" == BIND:* ]]; then
      count=$((count + 1))
      if [[ "$line" == *"UbuntuMono-Regular.ttf" ]]; then
        mono_bound="$line"
      fi
    fi
  done < <(apply_mounts)
  if [[ "$bundle_count" -ne 3 ]]; then
    echo "ERROR: Expected 3 Vietnamese installer bundle bindings, got ${bundle_count}" >&2
    return 1
  fi
  if [[ "$count" -ne 9 ]]; then
    echo "ERROR: Expected 9 installer font bindings, got ${count}" >&2
    return 1
  fi
  if [[ "$brand_desktop_count" -ne 1 || "$bind_desktop_count" -ne 1 ]]; then
    echo "ERROR: Expected installer desktop branding (brand=${brand_desktop_count}, bind=${bind_desktop_count})" >&2
    return 1
  fi
  if [[ "$mono_bound" != *"NotoMono-Regular.ttf -> "* ]]; then
    echo "ERROR: UbuntuMono-Regular.ttf did not bind to NotoMono-Regular.ttf: ${mono_bound}" >&2
    return 1
  fi
  rewrite_installer_desktop_file "${td}/snap-desktop/ubuntu-desktop-bootstrap_ubuntu-desktop-bootstrap.desktop"
  grep -q '^Name=Cài đặt NidoOS$' "${td}/snap-desktop/ubuntu-desktop-bootstrap_ubuntu-desktop-bootstrap.desktop"
  grep -q '^Name\[vi\]=Cài đặt NidoOS$' "${td}/snap-desktop/ubuntu-desktop-bootstrap_ubuntu-desktop-bootstrap.desktop"
  grep -q '^Icon=nidoos-logo$' "${td}/snap-desktop/ubuntu-desktop-bootstrap_ubuntu-desktop-bootstrap.desktop"
  if grep -q '^Icon=ubiquity$' "${td}/snap-desktop/ubuntu-desktop-bootstrap_ubuntu-desktop-bootstrap.desktop"; then
    echo "ERROR: Icon=ubiquity was not replaced!" >&2
    return 1
  fi
  echo "bind-installer-fonts self-test passed (3/3 VI bundle mounts + 9/9 Flutter Yaru font targets + NidoOS installer icon/name; mono -> NotoMono-Regular.ttf)."
  return 0
}

verify_system_fonts() {
  local sans_src mono_src
  sans_src="$(resolve_font_for_target "Ubuntu-R.ttf" || true)"
  mono_src="$(resolve_font_for_target "UbuntuMono-Regular.ttf" || true)"
  if [[ -z "$sans_src" || ! -f "$sans_src" ]]; then
    echo "ERROR: No full-Vietnamese sans font resolved under ${FONT_ROOT}" >&2
    return 1
  fi
  if [[ -z "$mono_src" || ! -f "$mono_src" ]]; then
    echo "ERROR: No full-Vietnamese monospace font resolved under ${FONT_ROOT}" >&2
    return 1
  fi
  case "$(basename "$mono_src")" in
    NotoMono-Regular.ttf|NotoSansMono-Regular.ttf|LiberationMono-Regular.ttf)
      ;;
    *)
      echo "ERROR: Monospace target resolved to unexpected font: ${mono_src}" >&2
      return 1
      ;;
  esac
  echo "bind-installer-fonts system fonts verified (sans=$(basename "$sans_src"), mono=$(basename "$mono_src"))."
  return 0
}

apply_bundle_overlay() {
  local rev_dir="$1"
  local bound_bundle=0
  [[ -x "${BUNDLE_DIR}/ubuntu_bootstrap" && -f "${BUNDLE_DIR}/lib/libapp.so" && -d "${BUNDLE_DIR}/data/flutter_assets" ]] || return 0

  local item src dst
  for item in ubuntu_bootstrap lib data; do
    src="${BUNDLE_DIR}/${item}"
    dst="${rev_dir}/bin/${item}"
    [[ -e "$src" && -e "$dst" ]] || continue
    if [[ "$DRY_RUN" -eq 1 ]]; then
      printf 'BIND_BUNDLE:%s -> %s\n' "$src" "$dst"
      bound_bundle=$((bound_bundle + 1))
    else
      if command -v mountpoint >/dev/null 2>&1 && mountpoint -q "$dst" 2>/dev/null; then
        bound_bundle=$((bound_bundle + 1))
        continue
      fi
      if mount --bind "$src" "$dst" 2>/dev/null; then
        bound_bundle=$((bound_bundle + 1))
      fi
    fi
  done
  if [[ "$DRY_RUN" -eq 0 && "$bound_bundle" -gt 0 ]]; then
    echo "[NidoOS] bind-installer-fonts: activated Vietnamese installer bundle (${bound_bundle}/3 mounts) on ${rev_dir}."
  fi
}

apply_mounts() {
  [[ -d "$SNAP_ROOT" ]] || return 0
  wait_for_snap_fonts
  local rev_dir fonts_dir target_file target_name src_file bound=0
  shopt -s nullglob
  for rev_dir in "${SNAP_ROOT}"/*; do
    # Skip symlinks (e.g. 'current') so each real squashfs mountpoint is bound once
    [[ -L "$rev_dir" ]] && continue
    [[ -d "$rev_dir" ]] || continue
    apply_bundle_overlay "$rev_dir"
    fonts_dir="${rev_dir}/bin/data/flutter_assets/packages/yaru/assets/fonts"
    [[ -d "$fonts_dir" ]] || continue
    for target_file in "${fonts_dir}"/Ubuntu*.ttf; do
      [[ -f "$target_file" ]] || continue
      target_name="$(basename "$target_file")"
      src_file="$(resolve_font_for_target "$target_name" || true)"
      [[ -n "$src_file" && -f "$src_file" ]] || continue
      if [[ "$DRY_RUN" -eq 1 ]]; then
        printf 'BIND:%s -> %s\n' "$src_file" "$target_file"
      else
        if command -v mountpoint >/dev/null 2>&1 && mountpoint -q "$target_file" 2>/dev/null; then
          bound=$((bound + 1))
          continue
        fi
        if mount --bind "$src_file" "$target_file" 2>/dev/null; then
          bound=$((bound + 1))
        fi
      fi
    done
  done
  shopt -u nullglob
  if [[ "$DRY_RUN" -eq 0 ]]; then
    echo "[NidoOS] bind-installer-fonts: bound ${bound} Flutter font file(s)."
  fi
  clean_live_snap_launchers
}

case "${1:-}" in
  --self-test)
    run_self_test
    ;;
  --verify-system)
    verify_system_fonts
    ;;
  --dry-run)
    DRY_RUN=1
    apply_mounts
    ;;
  *)
    apply_mounts
    ;;
esac
