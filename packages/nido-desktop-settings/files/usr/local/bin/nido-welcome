#!/usr/bin/env bash
set -euo pipefail

FORCE=0
if [[ "${1:-}" == "--force" ]]; then
  FORCE=1
fi

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/ubuntu-nido"
DONE_FILE="${CONFIG_DIR}/welcome-done"
NIDOAI_DIR="${NIDOAI_HOME:-$HOME/.nidoai}"
ENV_FILE="${NIDOAI_DIR}/.env.local"

if [[ -z "${DISPLAY:-}" && -z "${WAYLAND_DISPLAY:-}" ]]; then
  exit 0
fi

is_live_session() {
  if [[ "${NIDO_TEST_LIVE_SESSION:-0}" == "1" ]]; then
    return 0
  fi
  if [[ -r /proc/cmdline ]] && grep -qw 'boot=casper' /proc/cmdline 2>/dev/null; then
    return 0
  fi
  if [[ -d /run/casper || -f /etc/casper.conf || -d /cdrom/casper || -d /snap/ubuntu-desktop-bootstrap ]]; then
    return 0
  fi
  if command -v pgrep >/dev/null 2>&1 && pgrep -f 'ubuntu-desktop-bootstrap' >/dev/null 2>&1; then
    return 0
  fi
  return 1
}

rewrite_installer_desktop_name() {
  local target_file="$1"
  sed -i \
    -e '/^Name\[vi\]=/d' \
    -e 's/^Name=Install .*/Name=Cài đặt NidoOS/' \
    -e 's/^Name=Cài đặt Ubuntu-Nido$/Name=Cài đặt NidoOS/' \
    -e 's/^Name=Cài đặt NidoOS$/Name=Cài đặt NidoOS\nName[vi]=Cài đặt NidoOS/' \
    "$target_file" 2>/dev/null || true
}

fix_live_installer_shortcuts() {
  local desktop_dir="$HOME/Desktop"
  local xdg_desktop=""
  if command -v xdg-user-dir >/dev/null 2>&1; then
    xdg_desktop="$(xdg-user-dir DESKTOP 2>/dev/null || true)"
  fi

  local dirs=("$desktop_dir")
  if [[ -n "$xdg_desktop" && "$xdg_desktop" != "$desktop_dir" ]]; then
    dirs+=("$xdg_desktop")
  fi

  local d f
  for d in "${dirs[@]}"; do
    [[ -d "$d" ]] || continue
    for f in "$d"/ubuntu-desktop-bootstrap*.desktop; do
      [[ -f "$f" ]] || continue
      rewrite_installer_desktop_name "$f"
      chmod 0755 "$f" 2>/dev/null || true
      if command -v gio >/dev/null 2>&1; then
        gio set "$f" metadata::trusted true >/dev/null 2>&1 || true
      fi
      touch "$f" 2>/dev/null || true
    done
  done

  local snap_desktop="/var/lib/snapd/desktop/applications/ubuntu-desktop-bootstrap_ubuntu-desktop-bootstrap.desktop"
  if [[ -f "$snap_desktop" ]]; then
    local local_apps="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
    local local_desktop="${local_apps}/ubuntu-desktop-bootstrap_ubuntu-desktop-bootstrap.desktop"
    mkdir -p "$local_apps"
    cp "$snap_desktop" "$local_desktop"
    rewrite_installer_desktop_name "$local_desktop"
  fi
}

fix_live_installer_shortcuts

if [[ -x /usr/libexec/ubuntu-nido/ensure-vietnamese-ime ]]; then
  /usr/libexec/ubuntu-nido/ensure-vietnamese-ime >/dev/null 2>&1 &
fi

if command -v nidoagent >/dev/null 2>&1; then
  nidoagent skills sync >/dev/null 2>&1 &
fi

# Never auto-open the NidoHub control center / onboarding wizard during a Live
# ISO session (while the OS installer is active). Users can still open NidoHub
# manually or via `nido-welcome --force`; on an installed system it opens
# automatically on first login.
if [[ "$FORCE" -eq 0 ]] && is_live_session; then
  exit 0
fi

POLICY_FILE="${CONFIG_DIR}/ai-policy.json"
SETUP_DONE=0
if [[ -f "$POLICY_FILE" ]]; then
  if grep -q '"setupCompleted"[[:space:]]*:[[:space:]]*true' "$POLICY_FILE" 2>/dev/null; then
    SETUP_DONE=1
  fi
elif [[ -f "$DONE_FILE" ]]; then
  SETUP_DONE=1
fi

if [[ "$FORCE" -eq 0 && "$SETUP_DONE" -eq 1 ]]; then
  exit 0
fi

if command -v nido-hub >/dev/null 2>&1 && python3 -c 'import gi; gi.require_version("Gtk", "4.0"); gi.require_version("Adw", "1")' >/dev/null 2>&1; then
  if [[ "$FORCE" -eq 1 ]]; then
    exec nido-hub --onboarding
  fi
  exec nido-hub --page welcome --first-login
fi

if ! command -v zenity >/dev/null 2>&1; then
  exit 0
fi

mkdir -p "$CONFIG_DIR" "$NIDOAI_DIR"
chmod 700 "$NIDOAI_DIR"

upsert_env() {
  local key="$1"
  local val="$2"
  local tmp_file
  umask 077
  touch "$ENV_FILE"
  chmod 600 "$ENV_FILE"
  tmp_file="$(mktemp)"
  grep -v "^${key}=" "$ENV_FILE" > "$tmp_file" || true
  printf '%s=%s\n' "$key" "$val" >> "$tmp_file"
  mv "$tmp_file" "$ENV_FILE"
  chmod 600 "$ENV_FILE"
}

if ! grep -q '^NIDOAI_CLIENT_TOKEN=' "$ENV_FILE" 2>/dev/null; then
  TOKEN="nidoai_$(python3 -c 'import secrets; print(secrets.token_hex(24))')"
  upsert_env "NIDOAI_CLIENT_TOKEN" "$TOKEN"
fi

CHOICE="$(zenity --list \
  --title="Chào mừng tới NidoOS" \
  --text="• Bộ gõ Sen Việt (Telex & VNI, Super+Space) đã bật sẵn.\n• Nhấn Super+Shift+A để mở nhanh NidoAgent.\n\nChọn nguồn AI cho NidoAI Gateway:" \
  --radiolist \
  --column="Chọn" --column="Mã" --column="Nhà cung cấp" \
  TRUE "gemini" "Google Gemini API (BYOK — Có gói miễn phí)" \
  FALSE "openai" "OpenAI API (BYOK)" \
  FALSE "local" "Local Ollama (http://127.0.0.1:11434/v1 — Offline)" \
  FALSE "skip" "Bỏ qua, thiết lập sau bằng lệnh nido-welcome" \
  --hide-column=2 --width=560 --height=360)" || CHOICE="skip"

case "$CHOICE" in
  gemini)
    KEY="$(zenity --entry --hide-text \
      --title="Nhập Google Gemini API Key" \
      --text="Dán GEMINI_API_KEY của bạn (lấy miễn phí tại aistudio.google.com).\nKhóa được lưu cục bộ tại ~/.nidoai/.env.local (quyền 0600)." \
      --width=500)" || KEY=""
    if [[ -n "$KEY" ]]; then
      upsert_env "NIDOAI_PRIMARY_BACKEND" "gemini"
      upsert_env "GEMINI_API_KEY" "$KEY"
    fi
    ;;
  openai)
    KEY="$(zenity --entry --hide-text \
      --title="Nhập OpenAI API Key" \
      --text="Dán OPENAI_API_KEY của bạn (lưu cục bộ tại ~/.nidoai/.env.local):" \
      --width=500)" || KEY=""
    if [[ -n "$KEY" ]]; then
      upsert_env "NIDOAI_PRIMARY_BACKEND" "openai"
      upsert_env "OPENAI_API_KEY" "$KEY"
    fi
    ;;
  local)
    LOCAL_URL="$(zenity --entry \
      --title="Kết nối Local LLM (Ollama)" \
      --text="Địa chỉ OpenAI-compatible endpoint cục bộ:" \
      --entry-text="http://127.0.0.1:11434/v1" \
      --width=480)" || LOCAL_URL=""
    if [[ -n "$LOCAL_URL" ]]; then
      upsert_env "NIDOAI_PRIMARY_BACKEND" "local"
      upsert_env "NIDOAI_LOCAL_BASE_URL" "$LOCAL_URL"
    fi
    ;;
  *)
    ;;
esac

if command -v systemctl >/dev/null 2>&1; then
  systemctl --user restart nidoai-gateway.service >/dev/null 2>&1 || \
    systemctl --user enable --now nidoai-gateway.service >/dev/null 2>&1 || true
fi

date -u +"%Y-%m-%dT%H:%M:%SZ" > "$DONE_FILE"

zenity --info \
  --title="NidoOS đã sẵn sàng" \
  --text="Thiết lập hoàn tất!\n\nMẹo sử dụng:\n• Nhấn Super+Shift+A để hỏi nhanh NidoAgent (Super+Space chuyển bộ gõ)\n• Chuột phải tệp trong Files → Scripts → Giao-cho-NidoAgent\n• Mở Terminal gõ: nidoagent status" \
  --width=480 || true
