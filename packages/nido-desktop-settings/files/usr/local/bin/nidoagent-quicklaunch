#!/usr/bin/env bash
set -euo pipefail

# Primary path: open NidoHub Agent page (GTK4/Libadwaita)
if [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]] && command -v nido-hub >/dev/null 2>&1; then
  exec nido-hub --page agent
fi

# Fallback: open terminal chat
if command -v gnome-terminal >/dev/null 2>&1; then
  exec gnome-terminal -- nidoagent chat
fi
exec nidoagent chat
