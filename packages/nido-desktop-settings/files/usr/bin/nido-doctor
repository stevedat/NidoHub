#!/usr/bin/env python3
"""NidoOS System Health & Configuration Doctor (`nido-doctor`)."""

from __future__ import annotations

import argparse
import datetime
import email.utils
import http.server
import json
import os
import pwd
import shutil
import subprocess
import sys
import tempfile
import threading
import urllib.error
import urllib.request
from dataclasses import asdict, dataclass
from pathlib import Path
from typing import Any


@dataclass
class CheckResult:
    name: str
    status: str  # PASS | WARN | FAIL | INFO
    detail: str


def _run(cmd: list[str], timeout: float = 15.0) -> tuple[int, str, str]:
    try:
        proc = subprocess.run(
            cmd,
            check=False,
            capture_output=True,
            text=True,
            timeout=timeout,
        )
        return proc.returncode, (proc.stdout or "").strip(), (proc.stderr or "").strip()
    except FileNotFoundError:
        return 127, "", f"command not found: {cmd[0]}"
    except subprocess.TimeoutExpired:
        return 124, "", f"timeout after {timeout}s"


def detect_live_session(root: Path = Path("/")) -> bool:
    if (root / "run/casper-md5check.json").exists() or (root / "cdrom/.disk/info").exists():
        return True
    cmdline = root / "proc/cmdline"
    if cmdline.is_file():
        try:
            if "boot=casper" in cmdline.read_text(encoding="utf-8", errors="replace").split():
                return True
        except OSError:
            pass
    return False


def _has_user_bus() -> bool:
    return bool(os.environ.get("DBUS_SESSION_BUS_ADDRESS") or os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY"))


def _resolve_desktop_user_home() -> Path:
    if os.geteuid() == 0:
        sudo_user = (os.environ.get("SUDO_USER") or "").strip()
        if sudo_user and sudo_user != "root":
            try:
                return Path(pwd.getpwnam(sudo_user).pw_dir)
            except KeyError:
                pass
    return Path.home()


def parse_http_clock_drift(
    date_header: str,
    now_utc: datetime.datetime | None = None,
) -> float | None:
    if not date_header or not date_header.strip():
        return None
    try:
        srv_dt = email.utils.parsedate_to_datetime(date_header.strip())
        if srv_dt.tzinfo is None:
            srv_dt = srv_dt.replace(tzinfo=datetime.timezone.utc)
        else:
            srv_dt = srv_dt.astimezone(datetime.timezone.utc)
        ref = now_utc or datetime.datetime.now(datetime.timezone.utc)
        if ref.tzinfo is None:
            ref = ref.replace(tzinfo=datetime.timezone.utc)
        return abs((ref - srv_dt).total_seconds())
    except Exception:
        return None


def check_clock_ntp(
    check_http_drift: bool = False,
    http_url: str = "https://ubuntu-nido-apt.pages.dev/dists/resolute/InRelease",
) -> CheckResult:
    ntp_on = ""
    ntp_synced = ""
    has_timedatectl = bool(shutil.which("timedatectl"))
    if has_timedatectl:
        rc, out, _ = _run(["timedatectl", "show", "-p", "NTP", "-p", "NTPSynchronized", "--value"], timeout=5.0)
        if rc == 0:
            lines = [ln.strip().lower() for ln in out.splitlines() if ln.strip()]
            if len(lines) >= 2:
                ntp_on, ntp_synced = lines[0], lines[1]

    drift_sec: float | None = None
    if check_http_drift or (has_timedatectl and ntp_synced != "yes"):
        try:
            req = urllib.request.Request(http_url, method="HEAD", headers={"User-Agent": "nido-doctor/1.0"})
            with urllib.request.urlopen(req, timeout=3.0) as resp:
                drift_sec = parse_http_clock_drift(resp.headers.get("Date", ""))
        except urllib.error.HTTPError as err:
            drift_sec = parse_http_clock_drift(err.headers.get("Date", "") if err.headers else "")
        except Exception:
            drift_sec = None

    if drift_sec is not None:
        d_int = int(round(drift_sec))
        if drift_sec > 300:
            return CheckResult(
                "Clock & NTP",
                "FAIL",
                f"clock drift ~{d_int}s (>5m; APT/TLS/JWT affected), ntp={ntp_on or '?'}, synced={ntp_synced or '?'}",
            )
        if drift_sec > 60:
            return CheckResult(
                "Clock & NTP",
                "WARN",
                f"clock drift ~{d_int}s, ntp={ntp_on or '?'}, synced={ntp_synced or '?'}",
            )
        if has_timedatectl and ntp_on == "no":
            return CheckResult("Clock & NTP", "WARN", f"ntp=off, http-drift={d_int}s")
        return CheckResult(
            "Clock & NTP",
            "PASS",
            f"ntp={ntp_on or 'ok'}, synced={ntp_synced or 'ok'}, drift={d_int}s",
        )

    if has_timedatectl:
        if ntp_on == "yes" and ntp_synced == "yes":
            return CheckResult("Clock & NTP", "PASS", "ntp=yes, synced=yes")
        return CheckResult("Clock & NTP", "WARN", f"ntp={ntp_on or 'unknown'}, synced={ntp_synced or 'unknown'}")
    return CheckResult("Clock & NTP", "INFO", "timedatectl unavailable")


def _parse_simple_env_file(path: Path) -> dict[str, str]:
    out: dict[str, str] = {}
    if not path.is_file():
        return out
    try:
        for raw in path.read_text(encoding="utf-8", errors="replace").splitlines():
            line = raw.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            out[k.strip()] = v.strip().strip("'\"")
    except OSError:
        pass
    return out


def check_gateway_and_sso(
    home_dir: Path | None = None,
    xdg_config: Path | None = None,
    nidoai_dir: Path | None = None,
) -> CheckResult:
    home = home_dir or _resolve_desktop_user_home()
    cfg_root = xdg_config or (
        Path(os.environ["XDG_CONFIG_HOME"])
        if (home_dir is None and os.environ.get("XDG_CONFIG_HOME") and os.geteuid() != 0)
        else home / ".config"
    )
    cfg_dir = cfg_root / "ubuntu-nido"
    ai_dir = nidoai_dir or (
        Path(os.environ["NIDOAI_HOME"])
        if (home_dir is None and os.environ.get("NIDOAI_HOME") and os.geteuid() != 0)
        else home / ".nidoai"
    )

    policy_file = cfg_dir / "ai-policy.json"
    account_file = cfg_dir / "account.json"
    runtime_file = ai_dir / "runtime.json"
    env_vars = _parse_simple_env_file(ai_dir / ".env.local")

    ai_enabled: bool | None = None
    if policy_file.is_file():
        try:
            pol = json.loads(policy_file.read_text(encoding="utf-8"))
            if isinstance(pol, dict) and isinstance(pol.get("aiEnabled"), bool):
                ai_enabled = pol["aiEnabled"]
        except (OSError, ValueError):
            pass
    env_flag = env_vars.get("NIDOAI_ENABLED", "").strip().lower()
    if ai_enabled is False or env_flag in ("0", "false", "off", "no"):
        return CheckResult("NidoAI Gateway & SSO", "PASS", "AI OFF by policy (offline mode)")

    acct_profile: dict[str, Any] = {}
    if account_file.is_file():
        try:
            parsed_acct = json.loads(account_file.read_text(encoding="utf-8"))
            if isinstance(parsed_acct, dict):
                acct_profile = parsed_acct
        except (OSError, ValueError):
            pass
    acct_signed_in = bool(acct_profile.get("signedIn") and (acct_profile.get("email") or acct_profile.get("userId")))
    acct_email = str(acct_profile.get("email") or "").strip()

    runtime_data: dict[str, Any] = {}
    if runtime_file.is_file():
        try:
            parsed_rt = json.loads(runtime_file.read_text(encoding="utf-8"))
            if isinstance(parsed_rt, dict):
                runtime_data = parsed_rt
        except (OSError, ValueError):
            pass

    if not policy_file.is_file() and not acct_signed_in and not runtime_data:
        return CheckResult("NidoAI Gateway & SSO", "INFO", "onboarding pending (gateway deferred)")

    base_url = str(runtime_data.get("baseUrl") or "").strip().rstrip("/")
    if not base_url:
        port = env_vars.get("NIDOAI_PORT") or "18090"
        base_url = f"http://127.0.0.1:{port}"
    client_token = str(runtime_data.get("clientToken") or env_vars.get("NIDOAI_CLIENT_TOKEN") or "").strip()

    health: dict[str, Any] | None = None
    try:
        with urllib.request.urlopen(f"{base_url}/healthz", timeout=1.5) as resp:
            if resp.status == 200:
                parsed_h = json.loads(resp.read().decode("utf-8"))
                if isinstance(parsed_h, dict):
                    health = parsed_h
    except Exception:
        health = None

    if health is None:
        if acct_signed_in:
            return CheckResult(
                "NidoAI Gateway & SSO",
                "WARN",
                f"account signed in ({acct_email or 'nido'}) but gateway unreachable — NidoOffice SSO degraded",
            )
        return CheckResult(
            "NidoAI Gateway & SSO",
            "WARN",
            "gateway not running (start: systemctl --user start nidoai-gateway.service)",
        )

    primary = health.get("primaryBackend") if isinstance(health.get("primaryBackend"), dict) else {}
    primary_kind = str(primary.get("kind") or "unknown")
    gw_acct: dict[str, Any] | None = None
    if len(client_token) >= 16:
        try:
            req = urllib.request.Request(
                f"{base_url}/v1/account",
                headers={"Authorization": f"Bearer {client_token}", "Accept": "application/json"},
            )
            with urllib.request.urlopen(req, timeout=1.5) as resp:
                if resp.status == 200:
                    parsed_ga = json.loads(resp.read().decode("utf-8"))
                    if isinstance(parsed_ga, dict):
                        gw_acct = parsed_ga
        except Exception:
            gw_acct = None

    if acct_signed_in or (gw_acct and gw_acct.get("signedIn")):
        eff_email = str((gw_acct or {}).get("email") or acct_email or "nido")
        if gw_acct is not None and gw_acct.get("signedIn") and gw_acct.get("backendConfigured"):
            tok_state = "fresh" if gw_acct.get("tokenFresh") else "auto-refresh"
            return CheckResult(
                "NidoAI Gateway & SSO",
                "PASS",
                f"online (primary={primary_kind}, sso={eff_email}, token={tok_state})",
            )
        return CheckResult(
            "NidoAI Gateway & SSO",
            "WARN",
            f"account signed in ({eff_email}) but gateway nido tokens unconfigured (restart nidoai-gateway)",
        )

    return CheckResult("NidoAI Gateway & SSO", "PASS", f"online (primary={primary_kind}, nido-sso=signed-out)")


def _asar_contains_marker(asar_path: Path, marker: bytes) -> bool:
    try:
        overlap = len(marker)
        prev = b""
        with asar_path.open("rb") as fh:
            while True:
                chunk = fh.read(1024 * 1024)
                if not chunk:
                    return False
                if marker in (prev + chunk):
                    return True
                prev = chunk[-overlap:]
    except OSError:
        return False


def check_nidooffice_runtime(install_dir: Path = Path("/opt/NidoOffice")) -> CheckResult:
    bin_path = install_dir / "nidooffice"
    if not (bin_path.is_file() and os.access(bin_path, os.X_OK)):
        bin_path = install_dir / "genoffice"
    if not (bin_path.is_file() and os.access(bin_path, os.X_OK)):
        return CheckResult("NidoOffice Runtime", "WARN", f"runtime not installed at {install_dir}")
    ver_file = install_dir / ".installed-version"
    ver = ver_file.read_text(encoding="utf-8", errors="replace").strip() if ver_file.is_file() else "unknown"
    asar_path = install_dir / "resources" / "app.asar"
    if asar_path.is_file():
        if _asar_contains_marker(asar_path, b"nidoos_gateway"):
            return CheckResult("NidoOffice Runtime", "PASS", f"v{ver} ({install_dir}; Linux Gateway SSO verified)")
        return CheckResult(
            "NidoOffice Runtime",
            "WARN",
            f"v{ver} ({install_dir}; legacy build missing Gateway SSO — run: sudo nidooffice-desktop --update)",
        )
    return CheckResult("NidoOffice Runtime", "PASS", f"v{ver} ({install_dir})")


def check_disk_space(target: str = "/") -> CheckResult:
    try:
        usage = shutil.disk_usage(target)
        free_gib = usage.free / (1024 ** 3)
        total_gib = usage.total / (1024 ** 3)
        if free_gib < 0.5:
            return CheckResult("Root Disk Space", "FAIL", f"{free_gib:.2f} GiB free / {total_gib:.1f} GiB total")
        if free_gib < 2.0:
            return CheckResult("Root Disk Space", "WARN", f"{free_gib:.2f} GiB free / {total_gib:.1f} GiB total (<2 GiB)")
        return CheckResult("Root Disk Space", "PASS", f"{free_gib:.1f} GiB free / {total_gib:.1f} GiB total")
    except OSError as exc:
        return CheckResult("Root Disk Space", "WARN", str(exc))


def check_package_integrity(root: Path = Path("/")) -> CheckResult:
    verifier = shutil.which("nido-security-verify")
    manifests_dir = root / "usr/share/nido-security/manifests"
    if not manifests_dir.is_dir():
        return CheckResult("Package Integrity", "INFO", "manifests not present in rootfs")
    try:
        import importlib.machinery
        import importlib.util

        vpath = Path(verifier) if verifier else Path("/usr/bin/nido-security-verify")
        if not vpath.is_file():
            return CheckResult("Package Integrity", "WARN", "nido-security-verify missing")
        loader = importlib.machinery.SourceFileLoader("nido_security_verify", str(vpath))
        spec = importlib.util.spec_from_loader("nido_security_verify", loader)
        if spec is None:
            return CheckResult("Package Integrity", "WARN", "unable to load nido-security-verify")
        mod = importlib.util.module_from_spec(spec)
        loader.exec_module(mod)
        res = mod.verify_manifests(root=root)
        if res.get("ok"):
            return CheckResult(
                "Package Integrity",
                "PASS",
                f"{res['filesChecked']} files across {res['manifestsChecked']} manifests (signed={res['signedManifests']})",
            )
        errs = res.get("errors") or ["tamper detected"]
        return CheckResult("Package Integrity", "FAIL", str(errs[0]))
    except Exception as exc:
        return CheckResult("Package Integrity", "WARN", f"verify error: {exc}")


def check_security_hardening(root: Path = Path("/"), home_dir: Path | None = None) -> CheckResult:
    notes: list[str] = []
    warns: list[str] = []
    sysctl_cfg = root / "etc/sysctl.d/90-nidoos-hardening.conf"
    if sysctl_cfg.is_file():
        notes.append("sysctl=installed")
    else:
        warns.append("missing 90-nidoos-hardening.conf")

    ptrace_p = root / "proc/sys/kernel/yama/ptrace_scope"
    if ptrace_p.is_file():
        val = ptrace_p.read_text(encoding="utf-8", errors="replace").strip()
        if val.isdigit() and int(val) >= 2:
            notes.append(f"ptrace={val}")
        else:
            warns.append(f"ptrace_scope={val} (<2)")

    aa_prof = root / "sys/kernel/security/apparmor/profiles"
    if aa_prof.is_file():
        try:
            txt = aa_prof.read_text(encoding="utf-8", errors="replace")
            loaded = sum(1 for p in ("nido-pkg-helper", "nidoai-gateway", "nidooffice") if p in txt)
            notes.append(f"apparmor={loaded}/3")
        except OSError:
            pass

    home = home_dir or _resolve_desktop_user_home()
    ai_dir = home / ".nidoai"
    if ai_dir.is_dir():
        mode = ai_dir.stat().st_mode & 0o777
        if (mode & 0o077) != 0:
            return CheckResult("Security Hardening", "FAIL", f"~/.nidoai mode {oct(mode)} too open (must be 0700)")
        notes.append("nidoai=0700")

    if warns:
        return CheckResult("Security Hardening", "WARN", "; ".join(warns + notes))
    return CheckResult("Security Hardening", "PASS", ", ".join(notes) or "baseline ok")


def collect_checks(include_apt_update: bool = False, check_online: bool = False) -> tuple[list[CheckResult], dict[str, str]]:
    results: list[CheckResult] = []
    summary: dict[str, str] = {}
    is_live = detect_live_session()

    # 1. OS Identity
    osrel_path = Path("/etc/os-release")
    osrel = osrel_path.read_text(encoding="utf-8", errors="replace") if osrel_path.is_file() else ""
    _, arch, _ = _run(["dpkg", "--print-architecture"])
    built_p = Path("/etc/ubuntu-nido-customized")
    built = built_p.read_text(encoding="utf-8", errors="replace").strip() if built_p.is_file() else "missing"
    mode_lbl = "live-iso" if is_live else "installed"
    results.append(
        CheckResult(
            "OS Identity",
            "PASS" if 'NAME="NidoOS"' in osrel else "FAIL",
            f"arch={arch or 'unknown'}, mode={mode_lbl}, built={built}",
        )
    )

    # 2. RAM / ZRAM / EarlyOOM
    _, zout, _ = _run(["zramctl", "--noheadings"])
    _, eoom, _ = _run(["systemctl", "is-active", "earlyoom"])
    zram_ok = bool(zout)
    results.append(
        CheckResult(
            "ZRAM & EarlyOOM",
            "PASS" if (zram_ok and eoom == "active") else "WARN",
            f"zram={'on' if zram_ok else 'off'}, earlyoom={eoom or 'unknown'}",
        )
    )

    # 3. APT & PackageKit Hygiene
    forbidden = [
        Path("/etc/apt/apt.conf.d/20packagekit"),
        Path("/etc/apt/apt.conf.d/20packagekit.nido-disabled"),
        Path("/usr/share/dbus-1/system-services/org.freedesktop.PackageKit.service"),
    ]
    if not is_live:
        forbidden.append(Path("/etc/apt/sources.list.d/cdrom.sources"))
    lingering = [str(p) for p in forbidden if p.exists()]
    src_dir = Path("/etc/apt/sources.list.d")
    sources = sorted(p.name for p in src_dir.iterdir() if p.is_file()) if src_dir.is_dir() else []
    results.append(
        CheckResult(
            "APT & PackageKit",
            "PASS" if not lingering else "FAIL",
            f"clean ({', '.join(sources)})" if not lingering else f"unexpected: {', '.join(lingering)}",
        )
    )

    # 4. Vietnamese Typography
    _, f_sans, _ = _run(["fc-match", "-f", "%{family}", ":charset=1ec7"])
    _, f_mono_e, _ = _run(["fc-match", "-f", "%{family}", "Ubuntu Mono:charset=1ec3"])
    _, f_mono_o, _ = _run(["fc-match", "-f", "%{family}", "Ubuntu Mono:charset=1ecd"])
    sans_ok = f_sans in ("Be Vietnam Pro", "Noto Sans")
    mono_ok = f_mono_e in ("Liberation Mono", "Noto Mono") and f_mono_o in ("Liberation Mono", "Noto Mono")
    results.append(
        CheckResult(
            "Vietnamese Fonts",
            "PASS" if (sans_ok and mono_ok) else "FAIL",
            f"sans={f_sans or 'none'}, mono={f_mono_e or 'none'}/{f_mono_o or 'none'}",
        )
    )

    # 5. Sen Viet IME & GNOME Desktop Settings
    if _has_user_bus() and shutil.which("gsettings"):
        _, ime, _ = _run(["gsettings", "get", "org.gnome.desktop.input-sources", "sources"])
        results.append(
            CheckResult(
                "Sen Viet IME",
                "PASS" if ("vielotus" in ime and "vielotus-vni" in ime) else "FAIL",
                ime or "(empty)",
            )
        )
        _, acc, _ = _run(["gsettings", "get", "org.gnome.desktop.interface", "accent-color"])
        _, dock, _ = _run(["gsettings", "get", "org.gnome.shell.extensions.dash-to-dock", "dock-position"])
        results.append(
            CheckResult(
                "GNOME Theme & Dock",
                "PASS" if ("teal" in acc and "BOTTOM" in dock) else "WARN",
                f"accent={acc}, dock={dock}",
            )
        )
    else:
        results.append(CheckResult("Sen Viet IME", "INFO", "skipped (headless / no GNOME session bus)"))
        results.append(CheckResult("GNOME Theme & Dock", "INFO", "skipped (headless / no GNOME session bus)"))

    # 6. NidoHub & Arch Filtering
    self_test_mod = Path("/usr/lib/nido-hub/self_test.py")
    rc_st, _, err_st = _run(["nido-hub", "--self-test"], timeout=30.0)
    catalog_note = ""
    catalog_ok = True
    try:
        sys.path.insert(0, "/usr/lib/nido-hub")
        from app_store import NidoAppStore  # type: ignore

        st = NidoAppStore(Path("/etc/nido-hub/catalog.json"))
        vis = {x["id"] for x in st.load_catalog_entries(include_arch_probe=False)}
        raw = {x["id"] for x in st.load_catalog_entries(include_arch_probe=False, hide_unsupported=False)}
        hidden = sorted(raw - vis)
        if st.host_arch == "arm64":
            catalog_ok = {"discord-flatpak", "spotify-flatpak", "blender-flatpak"} <= set(hidden)
        catalog_note = f"visible={len(vis)}/{len(raw)}, hidden={hidden}"
    except Exception as exc:
        catalog_ok = False
        catalog_note = f"catalog error: {exc}"
    hub_ok = self_test_mod.is_file() and rc_st == 0 and catalog_ok
    hub_detail = f"self-test={'ok' if rc_st == 0 else f'rc={rc_st}'}, {catalog_note}"
    if rc_st != 0 and err_st:
        hub_detail += f" ({err_st.splitlines()[-1]})"
    results.append(CheckResult("NidoHub & Arch Filter", "PASS" if hub_ok else "FAIL", hub_detail))

    # 7. Core Stack Binaries & Unwanted Snaps
    required_bins = ["nidoai", "nidoagent", "nido-hub", "nidobox", "nidooffice-desktop", "geary", "himalaya"]
    missing_bins = [b for b in required_bins if not shutil.which(b)]
    results.append(
        CheckResult(
            "Core Stack Binaries",
            "PASS" if not missing_bins else "FAIL",
            f"all {len(required_bins)} present" if not missing_bins else f"missing: {', '.join(missing_bins)}",
        )
    )

    if not is_live and shutil.which("snap"):
        rc_sn, sn_out, _ = _run(["snap", "list"])
        if rc_sn == 0:
            installed_snaps = {ln.split()[0] for ln in sn_out.splitlines()[1:] if ln.strip()}
            unwanted = sorted(
                installed_snaps & {"snap-store", "thunderbird", "firefox", "desktop-security-center"}
            )
            results.append(
                CheckResult(
                    "Snap Bloat Cleanup",
                    "PASS" if not unwanted else "WARN",
                    f"clean ({len(installed_snaps)} base snaps)" if not unwanted else f"present: {', '.join(unwanted)}",
                )
            )

    # 8. Systemd Failed Units
    _, fail_sys, _ = _run(["systemctl", "--failed", "--no-legend"])
    fail_usr = ""
    if _has_user_bus():
        _, fail_usr, _ = _run(["systemctl", "--user", "--failed", "--no-legend"])
    failed_ok = not fail_sys and not fail_usr
    results.append(
        CheckResult(
            "Systemd Failed Units",
            "PASS" if failed_ok else "WARN",
            "0 failed" if failed_ok else f"sys={fail_sys or '0'} | usr={fail_usr or '0'}",
        )
    )

    # 9. Optional live `apt-get update` check
    if include_apt_update:
        if os.geteuid() != 0:
            results.append(CheckResult("Live APT Update", "WARN", "re-run with: sudo nido-doctor --apt"))
        else:
            rc_apt, out_apt, err_apt = _run(
                ["apt-get", "-o", "APT::Update::Error-Mode=any", "update"], timeout=90.0
            )
            combined = f"{out_apt}\n{err_apt}"
            bad_sig = any(tok in combined for tok in ("NO_PUBKEY", "is not signed", "UnitMasked"))
            results.append(
                CheckResult(
                    "Live APT Update",
                    "PASS" if (rc_apt == 0 and not bad_sig) else "FAIL",
                    "exit 0 (0 signature/UnitMasked errors)"
                    if (rc_apt == 0 and not bad_sig)
                    else f"rc={rc_apt}: {combined.splitlines()[-1] if combined.strip() else 'failed'}",
                )
            )

    # Extra host summary (Boot, Memory, GPU)
    _, boot_out, _ = _run(["systemd-analyze"])
    if boot_out:
        summary["boot"] = boot_out.splitlines()[0]
    _, free_out, _ = _run(["free", "-h"])
    if free_out:
        lines = free_out.splitlines()
        if len(lines) >= 2:
            summary["memory"] = " | ".join(ln.strip() for ln in lines[1:3])
    gpu_info: list[str] = []
    for uev in sorted(Path("/sys/class/drm").glob("card*/device/uevent")):
        try:
            kv = dict(
                ln.split("=", 1)
                for ln in uev.read_text(encoding="utf-8", errors="replace").splitlines()
                if "=" in ln
            )
            if kv.get("DRIVER"):
                gpu_info.append(f"{kv['DRIVER']} ({kv.get('PCI_ID', 'n/a')})")
        except OSError:
            continue
    if gpu_info:
        summary["gpu"] = ", ".join(gpu_info)

    # 10. VM GTK4 Renderer check (informational/PASS on VMs with virtual GPU)
    _, vm_type, _ = _run(["systemd-detect-virt", "--vm"])
    if vm_type and vm_type != "none":
        gen_path = Path("/usr/lib/systemd/user-environment-generators/60-nido-vm-gsk")
        gsk_val = os.environ.get("GSK_RENDERER", "")
        if gsk_val == "cairo":
            results.append(CheckResult("VM GTK4 Renderer", "PASS", f"GSK_RENDERER=cairo active ({vm_type})"))
        elif gen_path.is_file() and os.access(gen_path, os.X_OK):
            results.append(
                CheckResult(
                    "VM GTK4 Renderer",
                    "INFO",
                    f"generator ready ({vm_type}); re-login/reboot to activate GSK_RENDERER=cairo",
                )
            )
        else:
            results.append(CheckResult("VM GTK4 Renderer", "WARN", f"GSK_RENDERER unset on {vm_type} VM"))

    # 11. Clock / NTP drift, NidoAI Gateway SSO, NidoOffice runtime & root disk space
    results.append(check_clock_ntp(check_http_drift=include_apt_update or check_online))
    if not is_live:
        results.append(check_gateway_and_sso())
    results.append(check_nidooffice_runtime())
    results.append(check_disk_space("/"))
    results.append(check_package_integrity())
    results.append(check_security_hardening())

    return results, summary


def format_report(results: list[CheckResult], summary: dict[str, str], as_json: bool = False) -> str:
    failed = sum(1 for r in results if r.status == "FAIL")
    warned = sum(1 for r in results if r.status == "WARN")
    passed = sum(1 for r in results if r.status == "PASS")
    if as_json:
        return json.dumps(
            {
                "ok": failed == 0,
                "counts": {"pass": passed, "warn": warned, "fail": failed},
                "checks": [asdict(r) for r in results],
                "summary": summary,
            },
            ensure_ascii=False,
            indent=2,
        )
    lines = ["=== NidoOS System Doctor ==="]
    for r in results:
        lines.append(f"[{r.status:<4}] {r.name:<22} | {r.detail}")
    if summary:
        lines.append("--- Host Summary ---")
        for k in ("boot", "memory", "gpu"):
            if k in summary:
                lines.append(f"  {k:<7}: {summary[k]}")
    lines.append(f"Result: {passed} PASS, {warned} WARN, {failed} FAIL")
    return "\n".join(lines)


def run_self_test() -> int:
    with tempfile.TemporaryDirectory(prefix="nido-doctor-test-") as td:
        root = Path(td)
        assert detect_live_session(root) is False
        (root / "run").mkdir(parents=True)
        (root / "run/casper-md5check.json").write_text("{}", encoding="utf-8")
        assert detect_live_session(root) is True

        # Clock drift parser unit test
        ref_now = datetime.datetime(2026, 11, 25, 12, 0, 0, tzinfo=datetime.timezone.utc)
        assert parse_http_clock_drift("Wed, 25 Nov 2026 12:00:05 GMT", now_utc=ref_now) == 5.0
        assert parse_http_clock_drift("Wed, 25 Nov 2026 11:00:00 GMT", now_utc=ref_now) == 3600.0
        assert parse_http_clock_drift("not-a-date", now_utc=ref_now) is None

        # NidoOffice runtime check (missing -> WARN; legacy asar without nidoos_gateway -> WARN; SSO asar -> PASS)
        assert check_nidooffice_runtime(root / "missing-office").status == "WARN"
        fake_office = root / "opt-office"
        (fake_office / "resources").mkdir(parents=True)
        (fake_office / ".installed-version").write_text("0.13.1\n", encoding="utf-8")
        fake_bin = fake_office / "nidooffice"
        fake_bin.write_text("#!/bin/sh\nexit 0\n", encoding="utf-8")
        fake_bin.chmod(0o755)
        (fake_office / "resources/app.asar").write_bytes(b"legacy-office-bundle-without-sso")
        legacy_res = check_nidooffice_runtime(fake_office)
        assert legacy_res.status == "WARN" and "legacy build" in legacy_res.detail, legacy_res
        (fake_office / "resources/app.asar").write_bytes(b"bundle...nidoos_gateway...fetchUbuntuNidoGatewayAccount")
        office_res = check_nidooffice_runtime(fake_office)
        assert office_res.status == "PASS" and "0.13.1" in office_res.detail and "SSO verified" in office_res.detail, office_res

        # Disk space check
        disk_res = check_disk_space(str(root))
        assert disk_res.status in ("PASS", "WARN", "FAIL") and "GiB free" in disk_res.detail

        # Security hardening & package integrity check
        sec_root = root / "sec-root"
        (sec_root / "etc/sysctl.d").mkdir(parents=True)
        (sec_root / "etc/sysctl.d/90-nidoos-hardening.conf").write_text("kernel.yama.ptrace_scope = 2\n", encoding="utf-8")
        sec_home = sec_root / "home/user"
        (sec_home / ".nidoai").mkdir(parents=True)
        (sec_home / ".nidoai").chmod(0o700)
        assert check_security_hardening(root=sec_root, home_dir=sec_home).status == "PASS"
        (sec_home / ".nidoai").chmod(0o755)
        assert check_security_hardening(root=sec_root, home_dir=sec_home).status == "FAIL"

        # Gateway & SSO check (AI OFF -> PASS; signed-in + live loopback Gateway -> PASS; unreachable -> WARN)
        home_off = root / "home-off"
        (home_off / ".config/ubuntu-nido").mkdir(parents=True)
        (home_off / ".config/ubuntu-nido/ai-policy.json").write_text('{"aiEnabled": false}\n', encoding="utf-8")
        assert check_gateway_and_sso(home_dir=home_off, xdg_config=home_off / ".config", nidoai_dir=home_off / ".nidoai").status == "PASS"

        secret_tok = "nidoai_doctor_test_secret_token_0123456789"

        class _MockGwHandler(http.server.BaseHTTPRequestHandler):
            def do_GET(self):
                if self.path == "/healthz":
                    body = json.dumps({"status": "ok", "primaryBackend": {"kind": "nido", "configured": True}}).encode("utf-8")
                    self.send_response(200)
                    self.send_header("Content-Type", "application/json")
                    self.send_header("Content-Length", str(len(body)))
                    self.end_headers()
                    self.wfile.write(body)
                    return
                if self.path == "/v1/account" and self.headers.get("Authorization") == f"Bearer {secret_tok}":
                    body = json.dumps({
                        "signedIn": True,
                        "backendConfigured": True,
                        "tokenFresh": True,
                        "email": "test@nido.vn",
                    }).encode("utf-8")
                    self.send_response(200)
                    self.send_header("Content-Type", "application/json")
                    self.send_header("Content-Length", str(len(body)))
                    self.end_headers()
                    self.wfile.write(body)
                    return
                self.send_response(401)
                self.end_headers()

            def log_message(self, *args):
                return

        srv = http.server.HTTPServer(("127.0.0.1", 0), _MockGwHandler)
        srv_port = srv.server_address[1]
        threading.Thread(target=srv.serve_forever, daemon=True).start()
        try:
            home_on = root / "home-on"
            (home_on / ".config/ubuntu-nido").mkdir(parents=True)
            (home_on / ".nidoai").mkdir(parents=True)
            (home_on / ".config/ubuntu-nido/ai-policy.json").write_text('{"aiEnabled": true}\n', encoding="utf-8")
            (home_on / ".config/ubuntu-nido/account.json").write_text(
                '{"signedIn": true, "email": "test@nido.vn"}\n', encoding="utf-8"
            )
            (home_on / ".nidoai/runtime.json").write_text(
                json.dumps({"baseUrl": f"http://127.0.0.1:{srv_port}", "clientToken": secret_tok}),
                encoding="utf-8",
            )
            gw_ok = check_gateway_and_sso(home_dir=home_on, xdg_config=home_on / ".config", nidoai_dir=home_on / ".nidoai")
            assert gw_ok.status == "PASS" and "test@nido.vn" in gw_ok.detail, gw_ok
            assert secret_tok not in gw_ok.detail, "clientToken must NEVER appear in nido-doctor output!"
        finally:
            srv.shutdown()
            srv.server_close()

        # After server stops, signed-in account with unreachable gateway must WARN
        gw_down = check_gateway_and_sso(home_dir=home_on, xdg_config=home_on / ".config", nidoai_dir=home_on / ".nidoai")
        assert gw_down.status == "WARN" and "degraded" in gw_down.detail, gw_down

    sample = [
        CheckResult("OS Identity", "PASS", "arch=arm64"),
        CheckResult("APT & PackageKit", "PASS", "clean"),
    ]
    txt = format_report(sample, {"gpu": "vmwgfx (15AD:0406)"}, as_json=False)
    assert "[PASS] OS Identity" in txt and "2 PASS, 0 WARN, 0 FAIL" in txt
    payload: dict[str, Any] = json.loads(format_report(sample, {"gpu": "vmwgfx"}, as_json=True))
    assert payload["ok"] is True and payload["counts"]["pass"] == 2
    fail_payload: dict[str, Any] = json.loads(
        format_report([CheckResult("X", "FAIL", "broken")], {}, as_json=True)
    )
    assert fail_payload["ok"] is False and fail_payload["counts"]["fail"] == 1
    print("nido-doctor self-test passed.")
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Verify NidoOS system configuration and runtime health.")
    parser.add_argument("--json", action="store_true", help="Print structured JSON output.")
    parser.add_argument("--apt", action="store_true", help="Also run live apt-get update & HTTP clock drift checks (requires sudo).")
    parser.add_argument("--online", action="store_true", help="Also probe HTTP clock drift against NidoOS APT endpoint.")
    parser.add_argument("--self-test", action="store_true", help="Run offline unit self-test and exit.")
    args = parser.parse_args(argv)

    if args.self_test:
        return run_self_test()

    results, summary = collect_checks(include_apt_update=args.apt, check_online=args.online)
    print(format_report(results, summary, as_json=args.json))
    return 1 if any(r.status == "FAIL" for r in results) else 0


if __name__ == "__main__":
    raise SystemExit(main())
