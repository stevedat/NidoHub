#!/bin/sh
set -e

# Enable nidoai-gateway user socket globally for 0-MB idle on-demand activation
if [ -d /etc/systemd/user ]; then
  rm -f /etc/systemd/user/default.target.wants/nidoai-gateway.service || true
  if [ -f /usr/lib/systemd/user/nidoai-gateway.socket ]; then
    mkdir -p /etc/systemd/user/sockets.target.wants
    ln -sf /usr/lib/systemd/user/nidoai-gateway.socket \
      /etc/systemd/user/sockets.target.wants/nidoai-gateway.socket || true
  fi
fi

if [ -d /sys/kernel/security/apparmor ] && [ -f /etc/apparmor.d/nidoai-gateway ] && command -v apparmor_parser >/dev/null 2>&1; then
  apparmor_parser -r /etc/apparmor.d/nidoai-gateway >/dev/null 2>&1 || true
fi

if command -v systemctl >/dev/null 2>&1; then
  systemctl --global daemon-reload >/dev/null 2>&1 || true
fi

exit 0
