#!/bin/sh
set -eu

NIDOAI_BIN="${NIDOAI_ENTRY:-/usr/lib/nidoai/src/cli.ts}"
STATE_DIR="${NIDOAI_HOME:-${HOME}/.nidoai}"

mkdir -p "$STATE_DIR"
chmod 700 "$STATE_DIR" 2>/dev/null || true
cd "$STATE_DIR"

if ! command -v node >/dev/null 2>&1; then
  echo "nidoai: Node.js (>= 22.6.0) is required." >&2
  exit 1
fi

NODE_MAJOR="$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)"
if [ "$NODE_MAJOR" -lt 22 ]; then
  echo "nidoai: Node.js >= 22.6.0 is required (found $(node -v))." >&2
  exit 1
fi

exec node --no-warnings=ExperimentalWarning --experimental-strip-types "$NIDOAI_BIN" "$@"
