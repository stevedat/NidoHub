#!/bin/sh
set -eu

SELF_REAL="$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")"
case "$SELF_REAL" in
  /usr/bin/*) SYSTEM_INSTALLED=1 ;;
  *) SYSTEM_INSTALLED=0 ;;
esac

if [ "$SYSTEM_INSTALLED" -eq 1 ]; then
  NIDOAI_BIN="/usr/lib/nidoai/src/cli.mjs"
else
  NIDOAI_BIN="${NIDOAI_ENTRY:-/usr/lib/nidoai/src/cli.mjs}"
fi
STATE_DIR="${NIDOAI_HOME:-${HOME}/.nidoai}"

mkdir -p "$STATE_DIR"
chmod 700 "$STATE_DIR" 2>/dev/null || true
cd "$STATE_DIR"

if [ "$SYSTEM_INSTALLED" -eq 1 ] && [ -x /usr/libexec/nidoai/nidoai-sea ]; then
  exec /usr/libexec/nidoai/nidoai-sea "$@"
fi

if ! command -v node >/dev/null 2>&1; then
  echo "nidoai: Node.js (>= 18.0.0) is required." >&2
  exit 1
fi

NODE_MAJOR="$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)"
if [ "$NODE_MAJOR" -lt 18 ]; then
  echo "nidoai: Node.js >= 18.0.0 is required (found $(node -v))." >&2
  exit 1
fi

case "$NIDOAI_BIN" in
  *.ts) exec node --no-warnings=ExperimentalWarning --experimental-strip-types "$NIDOAI_BIN" "$@" ;;
  *) exec node "$NIDOAI_BIN" "$@" ;;
esac
