[Unit]
Description=NidoAI Local AI Gateway
ConditionPathExists=!/snap/ubuntu-desktop-bootstrap
ConditionPathExists=%h/.config/ubuntu-nido/ai-policy.json
After=dbus.socket gnome-keyring-daemon.service

[Service]
Type=simple
Environment=NODE_NO_WARNINGS=1
PassEnvironment=DBUS_SESSION_BUS_ADDRESS XDG_RUNTIME_DIR DISPLAY WAYLAND_DISPLAY
ExecStart=/usr/libexec/nidoai/gateway-daemon
Restart=on-failure
RestartSec=3
TimeoutStopSec=10s

# Unprivileged user-service hardening (filesystem isolation is enforced via AppArmor nidoai-gateway;
# omit root-only mount-namespace options and MemoryDenyWriteExecute which conflicts with V8 JIT)
NoNewPrivileges=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
LimitCORE=0
UMask=0077
MemoryMax=512M
CPUQuota=150%

[Install]
WantedBy=default.target
