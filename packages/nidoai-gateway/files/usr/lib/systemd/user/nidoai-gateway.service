[Unit]
Description=NidoAI Local AI Gateway
ConditionPathExists=!/snap/ubuntu-desktop-bootstrap
ConditionPathExists=%h/.config/ubuntu-nido/ai-policy.json
After=dbus.socket gnome-keyring-daemon.service

[Service]
Type=simple
Environment=NODE_NO_WARNINGS=1
PassEnvironment=DBUS_SESSION_BUS_ADDRESS XDG_RUNTIME_DIR DISPLAY WAYLAND_DISPLAY
ExecStart=/usr/libexec/nidoai/gateway-daemon
Restart=on-failure
RestartSec=3

# Process & Sandbox Hardening (V8 JIT needs writable+executable memory so omit MemoryDenyWriteExecute)
NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
LimitCORE=0
UMask=0077
MemoryMax=512M
CPUQuota=150%

[Install]
WantedBy=default.target
