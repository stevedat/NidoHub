abi <abi/4.0>,
include <tunables/global>

profile nidoai-gateway /usr/libexec/nidoai/gateway-daemon {
  include <abstractions/base>
  include <abstractions/nameservice>
  include <abstractions/ssl_certs>
  include if exists <abstractions/dbus-session-strict>

  network inet stream,
  network inet dgram,
  network inet6 stream,
  network inet6 dgram,
  network unix stream,
  network unix dgram,
  network netlink raw,
  unix,
  dbus (send, receive) bus=session,

  /usr/libexec/nidoai/gateway-daemon r,
  /bin/dash ix,
  /usr/bin/dash ix,
  /bin/sh ix,
  /usr/bin/sh ix,
  /bin/mkdir ix,
  /usr/bin/mkdir ix,
  /bin/chmod ix,
  /usr/bin/chmod ix,
  /usr/bin/node ix,
  /usr/bin/nodejs ix,
  /usr/bin/which* ix,
  /bin/which* ix,
  # Inherit profile (ix) rather than PUx so exec succeeds under NoNewPrivileges=yes
  /usr/bin/secret-tool ix,

  /usr/lib/nidoai/** r,
  /usr/share/nodejs/** r,
  /usr/lib/nodejs/** r,
  /usr/share/glib-2.0/** r,
  /etc/ubuntu-nido/** r,
  /etc/machine-id r,
  /var/lib/dbus/machine-id r,
  /etc/ssl/** r,
  /etc/ca-certificates/** r,
  @{PROC}/@{pid}/** r,
  @{PROC}/sys/** r,
  @{PROC}/meminfo r,
  @{PROC}/cpuinfo r,
  @{PROC}/stat r,
  /sys/devices/system/cpu/** r,
  /sys/fs/cgroup/** r,

  owner @{HOME}/ r,
  owner @{HOME}/.nidoai/ rw,
  owner @{HOME}/.nidoai/** rwlk,
  owner @{HOME}/.config/ r,
  owner @{HOME}/.config/ubuntu-nido/ rw,
  owner @{HOME}/.config/ubuntu-nido/** rwlk,
  owner /run/user/[0-9]*/ r,
  owner /run/user/[0-9]*/** rwlk,
  owner /tmp/** rwlk,

  # Deny direct reads of unrelated sensitive user & host files
  deny @{HOME}/.ssh/** rwkx,
  deny @{HOME}/.gnupg/** rwkx,
  deny @{HOME}/.aws/** rwkx,
  deny @{HOME}/.kube/** rwkx,
  deny @{HOME}/Documents/** rwkx,
  deny @{HOME}/Desktop/** rwkx,
  deny @{HOME}/Downloads/** rwkx,
  deny @{HOME}/Pictures/** rwkx,
  deny /etc/shadow rwx,
  deny /etc/gshadow rwx,

  include if exists <local/nidoai-gateway>
}
